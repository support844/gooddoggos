---
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
---

<section class="relative py-24 md:py-32 bg-primary-navy overflow-hidden">
  <!-- Subtle Radial Vignette / Cinematic Spotlight -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.04) 0%, transparent 60%), radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.22) 0%, transparent 70%);"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <!-- Kicker -->
      <p class="kicker mb-5" style="color: #D1B27F80; letter-spacing: 0.25em;">HAPPY PACK MEMBERS</p>

      <!-- Main Title -->
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight mb-1">
        Real Families.
      </h2>

      <!-- Gold Accent Subtitle (Playfair Italic) -->
      <p class="headline-accent text-4xl md:text-5xl" style="color: #D1B27F;">Real Results.</p>

      <!-- Gold Decorative Underline -->
      <div class="mt-6 flex justify-center">
        <div class="w-16 h-[3px] rounded-full" style="background: #D1B27F;"></div>
      </div>
    </div>

    <!-- 3-Column Responsive Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-start">
      {testimonials.map((t) => (
        <article class="bg-[#FCF9FA] rounded-2xl p-7 shadow-[0_8px_32px_rgba(0,0,0,0.28)] border border-white/10 flex flex-col gap-5 h-full">

          <!-- Gold Star Row -->
          <div class="flex gap-1" aria-label="5 stars">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 20 20" fill="#D1B27F" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="flex-grow text-primary-navy/80 text-[15px] leading-relaxed font-body italic">
            "{t.data.quote}"
          </blockquote>

          <!-- Thin Divider -->
          <hr class="border-gray-200" />

          <!-- Client Meta -->
          <div class="flex items-center gap-4">
            <!-- Avatar -->
            <div class="w-11 h-11 rounded-full overflow-hidden flex-shrink-0 ring-2 ring-[#D1B27F]/30">
              {t.data.image_path ? (
                <img
                  src={t.data.image_path}
                  alt={t.data.client_name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xl bg-primary-navy/10">🐶</div>
              )}
            </div>

            <!-- Name + Dog / Breed -->
            <div>
              <p class="font-bold text-primary-navy text-[15px] leading-snug">{t.data.client_name}</p>
              <p
                class="text-[11px] font-bold tracking-[0.18em] uppercase mt-0.5"
                style="color: #0F8992;"
              >
                {t.data.dog_name}{t.data.dog_breed ? ` • ${t.data.dog_breed}` : ''}
              </p>
            </div>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>
