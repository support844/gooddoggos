---
import { Image } from "astro:assets";
import { getCollection } from 'astro:content';
import bgImage from "../assets/images/jametlene-reskp-fliwkBbS7oM-unsplash.jpg";

interface Review {
  client_name: string;
  quote: string;
  rating: number;
  sub_label: string;
  profile_photo: string | null;
}

let reviews: Review[] = [];
let usingGoogleReviews = false;

const apiKey = import.meta.env.GOOGLE_PLACES_API_KEY;
const placeId = import.meta.env.GOOGLE_PLACE_ID;

if (apiKey && placeId) {
  try {
    const res = await fetch(
      `https://maps.googleapis.com/maps/api/place/details/json?place_id=${placeId}&fields=reviews&key=${apiKey}`
    );
    const data = await res.json();
    if (data.status === 'OK' && data.result?.reviews?.length) {
      reviews = data.result.reviews
        .filter((r: any) => r.rating >= 4 && r.text?.trim())
        .slice(0, 3)
        .map((r: any) => ({
          client_name: r.author_name,
          quote: r.text.trim(),
          rating: r.rating,
          sub_label: r.relative_time_description ?? '',
          profile_photo: r.profile_photo_url ?? null,
        }));
      usingGoogleReviews = reviews.length > 0;
    }
  } catch (_) {
    // fall through to static testimonials
  }
}

if (!usingGoogleReviews) {
  const testimonials = await getCollection('testimonials');
  reviews = testimonials.map(t => ({
    client_name: t.data.client_name,
    quote: t.data.quote,
    rating: 5,
    sub_label: t.data.dog_name + (t.data.dog_breed ? ` • ${t.data.dog_breed}` : ''),
    profile_photo: null,
  }));
}
---

<section class="relative py-24 md:py-32 bg-primary-navy overflow-hidden">
  <!-- Premium Background Image with Overlay -->
  <div class="absolute inset-0 z-0 text-white">
    <Image
      src={bgImage}
      alt="Happy dogs background"
      class="w-full h-full object-cover object-center opacity-35"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/85 via-[#0B2744]/65 to-[#0B2744]"
    >
    </div>
  </div>

  <!-- Subtle Radial Vignette / Cinematic Spotlight -->
  <div
    class="absolute inset-0 pointer-events-none z-[1]"
    style="background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.04) 0%, transparent 60%), radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.22) 0%, transparent 70%);"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="kicker mb-5" style="color: #D1B27F80; letter-spacing: 0.25em;">HAPPY PACK MEMBERS</p>

      <h2 class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight mb-1">
        Real Families.
      </h2>

      <p class="headline-accent text-4xl md:text-5xl" style="color: #D1B27F;">Real Results.</p>

      <div class="mt-6 flex justify-center">
        <div class="w-16 h-[3px] rounded-full" style="background: #D1B27F;"></div>
      </div>

      {usingGoogleReviews && (
        <div class="mt-4 flex items-center justify-center gap-2 text-white/50 text-sm">
          <svg viewBox="0 0 24 24" class="w-4 h-4 flex-shrink-0" fill="currentColor"><path d="M21.35 11.1H12.18V13.83H18.69C18.36 17.64 15.19 19.27 12.19 19.27C8.36 19.27 5 16.25 5 12C5 7.9 8.2 4.73 12.2 4.73C15.29 4.73 17.1 6.7 17.1 6.7L19 4.72C19 4.72 16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12C2.03 17.05 6.16 22 12.25 22C17.6 22 21.5 18.33 21.5 12.91C21.5 11.76 21.35 11.1 21.35 11.1Z"/></svg>
          <span>Reviews from Google</span>
        </div>
      )}
    </div>

    <!-- 3-Column Responsive Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-start">
      {reviews.map((r) => (
        <article class="bg-[#FCF9FA] rounded-2xl p-7 shadow-[0_8px_32px_rgba(0,0,0,0.28)] border border-white/10 flex flex-col gap-5 h-full">

          <!-- Star Row -->
          <div class="flex gap-1" aria-label={`${r.rating} stars`}>
            {[...Array(r.rating)].map(() => (
              <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 20 20" fill="#D1B27F" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="flex-grow text-primary-navy/80 text-[15px] leading-relaxed font-body italic">
            "{r.quote}"
          </blockquote>

          <hr class="border-gray-200" />

          <!-- Client Meta -->
          <div class="flex items-center gap-4">
            <!-- Avatar -->
            <div class="w-11 h-11 rounded-full overflow-hidden flex-shrink-0 ring-2 ring-[#D1B27F]/30">
              {r.profile_photo ? (
                <img
                  src={r.profile_photo}
                  alt={r.client_name}
                  class="w-full h-full object-cover"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xl text-white" style="background-color: #0F6D7F;">🐶</div>
              )}
            </div>

            <!-- Name + Sub Label -->
            <div>
              <p class="font-bold text-primary-navy text-[15px] leading-snug">{r.client_name}</p>
              {r.sub_label && (
                <p class="text-[11px] font-bold tracking-[0.18em] uppercase mt-0.5" style="color: #0F8992;">
                  {r.sub_label}
                </p>
              )}
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 flex justify-center">
      <a href="/transformations" class="btn-apply">
        View the Transformations
      </a>
    </div>
  </div>
</section>
