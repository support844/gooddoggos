---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-primary-navy text-surface py-12 border-t border-secondary-slate"
>
  <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Brand & Substack -->
    <div class="space-y-4">
      <img
        src="/images/Brand%20Name%20Logo%20-%20White%20-%20Good%20Doggos.png"
        alt="Good Doggos"
        class="h-16 w-auto object-contain mb-4"
      />
      <p class="text-sm text-gray-300 max-w-xs">
        Calm, premium behavioral support for dog owners.
      </p>

      <div class="pt-4">
        <p
          class="font-heading font-semibold text-[#D1B27F] mb-2 text-sm tracking-wide"
        >
          Join our Pack on Substack
        </p>
        <form
          action="https://gooddoggos.substack.com/subscribe"
          method="post"
          target="_blank"
          class="flex gap-2"
        >
          <input
            type="email"
            name="email"
            placeholder="Your email"
            class="px-4 py-2 rounded-full bg-[#FBF1E9] text-[#112032] placeholder-[#112032]/55 border border-[#E6DAC6] w-full focus:outline-none focus:ring-2 focus:ring-[#D1B27F]"
            required
          />
          <button
            type="submit"
            class="border-2 border-[#D1B27F] text-[#D1B27F] hover:bg-[#D1B27F] hover:text-[#0B2744] px-5 py-2 rounded-full transition-all duration-200 font-bold text-sm whitespace-nowrap"
          >
            Join
          </button>
        </form>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="font-heading text-lg font-semibold text-accent-gold mb-4">
        Explore
      </h3>
      <ul class="space-y-2">
        <li>
          <a href="/programs" class="hover:text-accent-gold transition-colors"
            >Programs</a
          >
        </li>
        <li>
          <a href="/services" class="hover:text-accent-gold transition-colors"
            >Services</a
          >
        </li>
        <li>
          <a href="/about" class="hover:text-accent-gold transition-colors"
            >About</a
          >
        </li>
        <li>
          <a
            href="/transformations"
            class="hover:text-accent-gold transition-colors">Transformations</a
          >
        </li>
        <li>
          <a href="/shop" class="hover:text-accent-gold transition-colors"
            >Shop</a
          >
        </li>
        <li>
          <a
            href="/calm-companion-challenge"
            class="hover:text-accent-gold transition-colors"
            >Calm Companion Challenge</a
          >
        </li>
        <li>
          <a
            href="https://gooddoggos.substack.com/"
            target="_blank"
            class="hover:text-accent-gold transition-colors"
            >Behavioral Journal</a
          >
        </li>
      </ul>
    </div>

    <!-- Contact & Legal -->
    <div class="md:text-right">
      <h3 class="font-heading text-lg font-semibold text-accent-gold mb-4">
        Contact
      </h3>
      <div class="space-y-3 md:flex md:flex-col md:items-end">
        <div class="flex items-center gap-3 md:flex-row-reverse">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-accent-gold"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <p class="text-sm">San Jacinto, CA</p>
        </div>

        <div class="flex items-center gap-3 md:flex-row-reverse">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-accent-gold"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <a
            href="mailto:support@gooddoggos.com"
            class="text-sm hover:text-accent-gold transition-colors"
            >support@gooddoggos.com</a
          >
        </div>

        <div class="flex items-center gap-3 md:flex-row-reverse">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-accent-gold"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <p class="text-sm">(951) 401-6252</p>
        </div>
      </div>

      <div
        class="flex flex-col md:items-end space-y-2 text-sm text-gray-400 pt-6"
      >
        <a href="/terms" class="hover:text-surface">Terms of Service</a>
        <a href="/privacy" class="hover:text-surface">Privacy Policy</a>
        <a href="/guarantee" class="hover:text-surface">Our Guarantee</a>
      </div>
    </div>
  </div>

  <div
    class="container mx-auto px-4 mt-8 pt-8 border-t border-secondary-slate text-center text-sm text-gray-500"
  >
    &copy; 2025 Good Doggos. All rights reserved.
  </div>
</footer>
