---
export interface Props {
  title: string;
  tagline: string;
  description: string;
  price_range: string;
  duration: string;
  outcomes: string[];
  details_url: string;
}

const {
  title,
  tagline,
  description,
  price_range,
  duration,
  outcomes,
  details_url,
} = Astro.props;
---

<div
  class="bg-surface rounded-2xl shadow-premium p-8 hover:transform hover:-translate-y-1 transition-all duration-300 border border-transparent hover:border-accent-gold flex flex-col h-full"
>
  <div class="mb-6">
    <h3 class="text-2xl font-heading font-bold text-primary-navy mb-2">
      {title}
    </h3>
    <p class="text-accent-teal font-medium italic mb-4">{tagline}</p>
    <p class="text-ink mb-4">{description}</p>
  </div>

  <div class="space-y-3 mb-8 flex-grow">
    <div class="flex items-center text-sm">
      <span class="font-bold w-24 text-secondary-slate">Price:</span>
      <span>{price_range}</span>
    </div>
    <div class="flex items-center text-sm">
      <span class="font-bold w-24 text-secondary-slate">Duration:</span>
      <span>{duration}</span>
    </div>

    <div class="mt-4">
      <p class="font-bold text-sm text-secondary-slate mb-2">Key Outcomes:</p>
      <ul class="space-y-1">
        {
          outcomes.map((outcome) => (
            <li class="flex items-start text-sm">
              <span class="text-accent-gold mr-2">✓</span> {outcome}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mt-auto">
    <a
      href={details_url}
      class="block w-full text-center bg-primary-navy hover:bg-secondary-slate text-surface font-semibold py-3 px-6 rounded-full transition-colors mb-3"
    >
      More Details
    </a>
    <a href="/apply" class="btn-apply w-full justify-center"> Apply Now</a>
  </div>
</div>
