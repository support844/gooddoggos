---
export interface Props {
    program: "ccc" | "pa" | "rdi";
}

const { program } = Astro.props;

const config = {
    ccc: {
        title: "Win-Your-Money-Back Guarantee",
        body: "Show up, do the work, and qualify to earn 100% of your investment back.",
        linkText: "Conditions apply — see guarantee details.",
        color: "#0F6D72",
        bg: "rgba(15,109,114,0.06)",
    },
    pa: {
        title: "Goal-Based Guarantee",
        body: "We choose one measurable goal. If your dog doesn't hit it, you get your money back.",
        linkText: "Conditions apply — see guarantee details.",
        color: "#D1B27F",
        bg: "rgba(209,178,127,0.12)",
    },
    rdi: {
        title: "Safety Standard Guarantee",
        body: "We keep working with you until your dog meets the agreed safety standard — at no extra cost.",
        linkText: "See guarantee details.",
        color: "#7D2C2D",
        bg: "rgba(125,44,45,0.06)",
    },
};

const g = config[program];
---

<div
    class="mt-4 p-3.5 rounded-xl border flex items-start gap-3 transition-all"
    style={`background: ${g.bg}; border-color: ${g.color}30;`}
>
    <div
        class="flex-shrink-0 w-8 h-8 rounded-full bg-white flex items-center justify-center mt-0.5"
        style={`border: 1px solid ${g.color}30; box-shadow: 0 2px 6px rgba(0,0,0,0.03);`}
    >
        <!-- Shield check icon -->
        <svg
            class="w-4 h-4"
            style={`color: ${g.color};`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
        </svg>
    </div>
    <div class="flex-1 min-w-0">
        <p
            class="text-[14px] leading-tight font-semibold font-heading mb-0.5"
            style="color: #112032; font-family: 'Poppins', sans-serif;"
        >
            {g.title}
        </p>
        <p
            class="text-[12px] leading-snug mb-0.5 text-balance"
            style="color: rgba(17,32,50,0.72);"
        >
            {g.body}
        </p>
        <a
            href="/guarantee"
            class="text-[10px] font-medium hover:underline inline-block"
            style={`color: ${g.color};`}
        >
            {g.linkText}
        </a>
    </div>
</div>
