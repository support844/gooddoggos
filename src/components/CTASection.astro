---
export interface Props {
  imageSrc?: string;
  eyebrow?: string;
  title1?: string;
  title2?: string;
  titleAccent?: string;
  body?: string;
  imageStyle?: string;
  theme?: "gold" | "teal";
  enhancedOverlay?: boolean;
}

const {
  imageSrc = "/images/pauline-loroy-U3aF7hgUSrk-unsplash.jpg",
  eyebrow = "Limited Spots Available",
  title1 = "Ready to Transform",
  title2 = "Your Dog's",
  titleAccent = "Future?",
  body = "Our evaluation queue fills weeks in advance. Take the first step toward a safe, focused relationship with your dog today.",
  imageStyle = "object-position: center;",
  theme = "gold",
  enhancedOverlay = false,
} = Astro.props;

const isTeal = theme === "teal";
const themeColorHex = isTeal ? "#0F6D72" : "#D1B27F";
const themeBgRGBA = isTeal ? "rgba(15,109,114,0.12)" : "rgba(209,178,127,0.12)";
---

<section
  class="relative min-h-[520px] md:min-h-[580px] flex items-center overflow-hidden"
>
  <!-- Background: Golden-Hour Dog Photo -->
  <div class="absolute inset-0 z-0">
    <img
      src={imageSrc}
      alt="Dog in golden hour light"
      class="w-full h-full object-cover"
      style={imageStyle}
    />

    <!-- Cinematic Overlay: heavy navy on left fading toward dog on right -->
    <div
      class="absolute inset-0"
      style={enhancedOverlay
        ? "background: linear-gradient(105deg, rgba(11,39,68,0.97) 0%, rgba(11,39,68,0.88) 28%, rgba(11,39,68,0.55) 55%, rgba(11,39,68,0.10) 100%);"
        : "background: linear-gradient(105deg, rgba(11,39,68,0.92) 0%, rgba(11,39,68,0.75) 35%, rgba(11,39,68,0.40) 62%, rgba(11,39,68,0.10) 100%);"}
    >
    </div>

    <!-- Subtle bottom darkening for grounding -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0B2744]/40 via-transparent to-transparent"
    >
    </div>

    <!-- Enhanced: soft vertical scrim behind the content zone (left half only) -->
    {enhancedOverlay && (
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 65% 80% at 18% 55%, rgba(11,39,68,0.45) 0%, transparent 100%);"
      >
      </div>
    )}
  </div>

  <!-- Watermark Logo (right side, very low opacity) -->
  <div
    class="absolute right-0 bottom-0 top-0 z-10 flex items-end justify-end pr-8 pb-8 md:pr-16 md:pb-12 pointer-events-none select-none"
  >
    <img
      src="/images/Brand%20Name%20Logo%20-%20White%20-%20Good%20Doggos.png"
      alt=""
      aria-hidden="true"
      class="w-48 md:w-72 h-auto opacity-[0.08] object-contain"
    />
  </div>

  <!-- Main Content (Left-aligned) -->
  <div
    class="relative z-20 max-w-7xl mx-auto px-4 md:px-8 lg:px-12 py-20 w-full"
  >
    <div class="max-w-xl">
      <!-- Limited Spots Pill / Kicker -->
      <div class="inline-flex items-center gap-2 mb-7">
        <span
          class="text-[11px] font-bold tracking-[0.22em] uppercase px-4 py-2 rounded-full border border-opacity-60"
          style={`background: ${themeBgRGBA}; color: ${themeColorHex}; border-color: ${themeColorHex}99;`}
        >
          {eyebrow}
        </span>
      </div>

      <!-- Headline -->
      <h2 class="font-heading font-bold text-white leading-[1.08] mb-6">
        {title1 && <span class="block text-4xl md:text-6xl lg:text-7xl">{title1}</span>}
        {title2 && <span class="block text-4xl md:text-6xl lg:text-7xl">{title2}</span>}
        {titleAccent && <span
          class="headline-accent block text-4xl md:text-6xl lg:text-7xl mt-1"
          style={`color: ${themeColorHex};`}>{titleAccent}</span>}
      </h2>

      <!-- Supporting Copy -->
      <p class="text-gray-300 text-lg leading-relaxed mb-10 max-w-md">
        {body}
      </p>

      <!-- Primary CTA Button -->
      <!-- Use global classes for buttons -->
      <a
        href="/apply"
        class:list={[{ "btn-apply": !isTeal, "btn-apply-teal": isTeal }]}
      >
        BOOK YOUR FREE ASSESSMENT
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
