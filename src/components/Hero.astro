---
---

<section
    class="relative min-h-screen flex items-center bg-primary-navy overflow-hidden pt-[180px] pb-20 lg:pt-[160px] lg:pb-20 w-screen"
    style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%);"
>
    <!-- Premium Background Texture: Ground and Trees -->
    <div class="absolute inset-0 z-0 bg-primary-navy">
        <!-- Forest Background Image — lighter, no blend mode so scene shows through -->
        <img
            src="https://images.unsplash.com/photo-1511497584788-876760111969?auto=format&fit=crop&q=80&w=2400"
            alt="Forest Background"
            class="w-full h-full object-cover opacity-55"
        />

        <!-- Cinematic Overlay: heavy navy on left (readability), fades right so image is visible -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-primary-navy/85 via-primary-navy/50 lg:via-primary-navy/35 to-primary-navy/10 z-10"
        >
        </div>
        <!-- Subtle top vignette only — NO bottom fade -->
        <div
            class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-primary-navy/20 to-transparent z-10"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-20 max-w-6xl">
        <div
            class="grid lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center"
        >
            <!-- Left Side: Content -->
            <div class="lg:col-span-7 lg:pr-8 xl:pr-12 text-left order-1">
                <!-- Kicker Pill -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full border border-accent-warmGold/30 bg-accent-warmGold/10 backdrop-blur-md shadow-[0_2px_10px_rgba(3,15,28,0.2)]"
                >
                    <span
                        class="text-[10px] md:text-ws font-bold uppercase tracking-[0.2em] text-accent-warmGold"
                        >Inland Empire &bull; Riverside County</span
                    >
                </div>

                <!-- Headline -->
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 text-white leading-[1.05] drop-shadow-2xl tracking-tight"
                >
                    San Jacinto Dog Trainer for <br class="hidden lg:block" />
                    <span
                        class="text-accent-warmGold italic drop-shadow-lg font-subheading"
                        >Reactive & Aggressive Dogs</span
                    >
                </h1>

                <!-- Copy -->
                <p
                    class="text-lg md:text-xl text-[#B9C6D3] mb-10 font-normal leading-[1.7] max-w-2xl drop-shadow-sm text-balance"
                >
                    At Good Doggos in San Jacinto, CA, we transform reactive and
                    aggressive dogs into calm companions using balanced training
                    methods that establish clear boundaries through praise,
                    rewards, and calibrated guidance. Stop dreading your daily
                    walks and apply for a Free Behavioral Assessment today, or
                    call us directly to take the first step toward a peaceful
                    household.
                </p>

                <!-- Phone Number Highlight -->
                <div class="mb-10 flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-accent-warmGold/20 flex items-center justify-center border border-accent-warmGold/30"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-accent-warmGold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <p
                            class="text-[10px] uppercase tracking-widest text-accent-warmGold/80 font-bold leading-none mb-1"
                        >
                            Call for Immediate Support
                        </p>
                        <a
                            href="tel:9514016252"
                            class="text-xl font-heading font-bold text-white hover:text-accent-warmGold transition-colors"
                        >
                            (951) 401-6252
                        </a>
                    </div>
                </div>

                <!-- CTAs -->
                <div
                    class="flex flex-col sm:flex-row items-center sm:items-start gap-5"
                >
                    <div class="flex flex-col items-center gap-2">
                        <a
                            href="/apply"
                            class="inline-flex justify-center bg-gradient-to-b from-[#D1B27F] to-[#CAA467] text-white font-bold py-[16px] px-8 sm:px-10 lg:px-6 xl:px-8 rounded-full text-[13.5px] uppercase tracking-[0.1em] shadow-[0_8px_20px_rgba(202,164,103,0.35),inset_0_1px_1px_rgba(255,255,255,0.5)] border border-[rgba(255,255,255,0.3)] transition-all duration-300 hover:shadow-[0_12px_25px_rgba(202,164,103,0.45),inset_0_1px_1px_rgba(255,255,255,0.7)] hover:-translate-y-[2px] items-center gap-3 whitespace-nowrap"
                        >
                            Apply for free assessment
                            <svg
                                class="w-4 h-4 ml-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2.5"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <p
                            class="text-[11px] text-white/60 tracking-wide font-medium text-center"
                        >
                            Includes Behavior Diagnosis &amp; Custom Roadmap.
                        </p>
                    </div>

                    <a
                        href="/transformations"
                        class="inline-flex justify-center px-8 sm:px-8 lg:px-6 xl:px-8 py-[16px] rounded-full border border-[rgba(255,255,255,0.2)] text-white font-bold text-[13.5px] uppercase tracking-[0.1em] backdrop-blur-sm hover:bg-white/10 hover:border-[rgba(255,255,255,0.4)] transition-all duration-300 items-center gap-3 shadow-lg group whitespace-nowrap"
                    >
                        Watch Results
                        <div
                            class="flex items-center justify-center w-[22px] h-[22px] rounded-full bg-white/20 group-hover:bg-accent-warmGold transition-colors"
                        >
                            <svg
                                class="w-3 h-3 text-white translate-x-[1px]"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Right Side: Featured Card -->
            <div
                class="lg:col-span-5 relative order-2 mt-12 lg:mt-0 w-full max-w-[420px] mx-auto lg:max-w-none lg:pl-6"
            >
                <!-- Floating shadow under everything -->
                <div
                    class="absolute inset-0 bg-[#020A12] blur-3xl opacity-60 translate-y-12 translate-x-4 pointer-events-none z-0"
                >
                </div>

                <div
                    class="relative rounded-[28px] overflow-hidden shadow-[0_30px_60px_rgba(3,15,28,0.7),0_15px_20px_rgba(3,15,28,0.5)] border border-[rgba(230,218,198,0.25)] aspect-[4/5] bg-primary-navy group z-10 w-full hover:-translate-y-2 transition-transform duration-700 ease-out"
                >
                    <!-- Card Sheen overlay -->
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-[rgba(255,255,255,0.2)] via-[rgba(255,255,255,0.02)] to-transparent pointer-events-none z-20"
                    >
                    </div>
                    <div
                        class="absolute inset-0 shadow-[inset_0_0_80px_rgba(11,39,68,0.4)] pointer-events-none z-20"
                    >
                    </div>

                    <!-- Image with zoom effect on hover -->
                    <img
                        src="https://images.unsplash.com/photo-1552053831-71594a27632d?q=80&w=2662&auto=format&fit=crop"
                        class="absolute inset-0 w-full h-full object-cover z-0 transform group-hover:scale-105 transition-transform duration-[1200ms] ease-out select-none"
                        alt="Confident dog listening to owner"
                    />

                    <!-- Abstract faint geometry lines matching reference -->
                    <div
                        class="absolute inset-0 z-10 pointer-events-none opacity-40"
                    >
                        <svg
                            width="100%"
                            height="100%"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <line
                                x1="0"
                                y1="85%"
                                x2="100%"
                                y2="85%"
                                stroke="#CAA467"
                                stroke-width="0.5"
                                opacity="0.6"></line>
                            <line
                                x1="75%"
                                y1="0"
                                x2="75%"
                                y2="100%"
                                stroke="#CAA467"
                                stroke-width="0.5"
                                opacity="0.6"></line>
                            <line
                                x1="0"
                                y1="100%"
                                x2="100%"
                                y2="60%"
                                stroke="#CAA467"
                                stroke-width="0.5"
                                opacity="0.4"></line>
                        </svg>
                    </div>

                    <!-- Soft Bottom Caption Bar -->
                    <div
                        class="absolute bottom-5 left-5 right-5 bg-[#FDFBF8]/95 backdrop-blur-md rounded-2xl p-5 shadow-[0_15px_30px_rgba(3,15,28,0.4)] border border-white/60 z-30"
                    >
                        <p
                            class="text-[10px] uppercase tracking-widest text-[#6B7A8B] font-bold mb-1.5 leading-none"
                        >
                            Expert Focus
                        </p>
                        <p
                            class="text-primary-navy font-bold text-[17px] leading-tight font-heading"
                        >
                            Reliable Neutrality in Real Environments
                        </p>
                    </div>
                </div>

                <!-- Top Corner Badge/Stamp (Positioned absolute relative to the wrapper, extending outside card bounds) -->
                <div
                    class="absolute -top-[20px] -right-[15px] w-[95px] h-[95px] md:w-[110px] md:h-[110px] rounded-full bg-gradient-to-br from-[#FBF1E9] to-[#D1B27F] shadow-[0_15px_30px_rgba(3,15,28,0.5),inset_0_2px_4px_rgba(255,255,255,0.7)] flex flex-col items-center justify-center border-2 border-[rgba(255,255,255,0.6)] z-30 transform hover:scale-105 transition-transform"
                >
                    <!-- Shield Icon -->
                    <svg
                        class="w-8 h-8 text-primary-navy mb-1 drop-shadow-sm"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.2"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path>
                    </svg>
                    <span
                        class="text-[8px] md:text-[9.5px] font-bold text-primary-navy text-center leading-[1.1] uppercase tracking-[0.05em] drop-shadow-sm"
                        >Master Level<br />Modification</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
