---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section
    class="min-h-[80vh] flex flex-col items-center justify-center text-center px-4 bg-surface"
  >
    <h1
      class="text-4xl md:text-6xl font-heading font-bold text-primary-navy mb-6"
    >
      Apply for Assessment
    </h1>
    <p class="text-xl text-gray-600 mb-10 max-w-2xl">
      Take the first step towards a better life with your dog. Fill out our
      application to see if we're the right fit for your goals.
    </p>

    <a
      href="https://docs.google.com/forms"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-apply"
    >
      Open Application Form →
    </a>

    <p class="mt-8 text-sm text-gray-500">
      *Redirects to Google Forms. Average response time: 24-48 hours.
    </p>
  </section>
</Layout>
