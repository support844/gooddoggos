---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
---

<Layout headerAlwaysSolid={true}>
  <section
    class="relative z-10 pt-52 pb-32 md:pt-48 md:pb-48 px-4 bg-surface min-h-[85vh] flex flex-col items-center justify-center overflow-hidden"
  >
    <div
      class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-20 items-center relative z-10"
    >
      <!-- Left Column: Copy & CTA -->
      <div class="flex flex-col items-start text-left reveal visible">
        <p class="kicker kicker-dark mb-4">Assessment Application</p>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-primary-navy mb-6 leading-tight"
        >
          Ready to build a <br class="hidden md:block" /><span
            class="headline-accent">better life</span
          > with your dog?
        </h1>
        <p class="text-lg text-ink/80 mb-10 max-w-lg leading-relaxed">
          We work with owners who are serious about creating lasting change. If
          you’re ready to put in the work, stay consistent, and choose a
          training plan that fits your doggo, we’d love to learn more about you.
        </p>

        <a
          href="https://forms.gle/WFRpYZuqHuKjAkb38"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-apply"
        >
          Open Application Form &rarr;
        </a>

        <p class="mt-6 text-sm text-ink/60 max-w-sm">
          *Redirects to Google Forms. We review every application personally and
          typically respond within 24–48 hours.
        </p>
      </div>

      <!-- Right Column: Qualification Card -->
      <div
        class="relative w-full flex flex-col items-center justify-start pb-20 md:pb-32"
      >
        <!-- Background Mascot Image (Anchored below Card) -->
        <div
          class="absolute top-[80%] left-1/2 -translate-x-1/2 -translate-y-[20%] w-[120%] md:w-[130%] max-w-[600px] pointer-events-none z-0"
        >
          <Image
            src={mascotNavy}
            alt=""
            class="w-full h-auto opacity-10 transform rotate-6"
          />
        </div>

        <div
          class="relative z-10 w-full bg-white/95 backdrop-blur-sm rounded-2xl shadow-premium border border-primary-navy/5 p-8 md:p-10 reveal visible"
          style="transition-delay: 100ms;"
        >
          <h2
            class="font-subheading text-2xl text-primary-navy mb-6 pb-4 border-b border-primary-navy/10"
          >
            Program Expectations
          </h2>

          <div class="space-y-8">
            <div>
              <h3
                class="font-heading font-semibold text-primary-navy text-sm uppercase tracking-wider mb-3 flex items-center gap-2"
              >
                <span
                  class="flex items-center justify-center w-6 h-6 rounded-full bg-accent-gold/20 text-accent-gold"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </span>
                Who this is for
              </h3>
              <ul
                class="text-ink/80 text-sm space-y-2 ml-8 list-disc marker:text-primary-navy/30"
              >
                <li>Owners committed to the daily process</li>
                <li>
                  Dogs with behavioral or reactivity concerns (you're welcome
                  here)
                </li>
                <li>
                  Families looking for lasting change, not temporary management
                </li>
              </ul>
            </div>

            <div>
              <h3
                class="font-heading font-semibold text-primary-navy text-sm uppercase tracking-wider mb-3 flex items-center gap-2"
              >
                <span
                  class="flex items-center justify-center w-6 h-6 rounded-full bg-accent-red/10 text-accent-red"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </span>
                Who this is NOT for
              </h3>
              <ul
                class="text-ink/80 text-sm space-y-2 ml-8 list-disc marker:text-primary-navy/30"
              >
                <li>Those seeking a "quick fix" or magic pill</li>
                <li>Owners unwilling to change their own habits</li>
                <li>Bargain shoppers looking for the cheapest option</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
