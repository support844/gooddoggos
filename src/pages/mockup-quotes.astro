---
// Mockup B: Stacked pull-quote style — length is irrelevant
import { Image } from "astro:assets";
import bgImage from "../assets/images/jametlene-reskp-fliwkBbS7oM-unsplash.jpg";

const reviews = [
  {
    client_name: "Brooke Milholland",
    sub_label: "Penny",
    quote: `I can't say enough great things about Victor as a dog trainer! His knowledge, professionalism, and genuine passion for what he does truly set him apart. At just our very first session, it was clear that he understands not just dogs, but how to effectively teach owners as well.\n\nHe worked with my very hyperactive dog Penny on "place," helping create a calm, safe space for her that will make such a difference in her behavior.\n\nWe also focused on leash walking, and Victor introduced us to new redirection techniques that are going to completely change our walks for the better. I'm looking forward to our walks being less stressful and more enjoyable, and feeling so much more confident handling her.\n\nVictor explains everything in a way that's easy to understand and practical to apply, and he's incredibly patient and encouraging throughout the process. If you're looking for a trainer who is skilled, professional, and truly cares about both you and your dog, I highly recommend Good Doggos!`,
  },
  {
    client_name: "Yoselin Martinez",
    sub_label: "",
    quote: "Great training. My dogs learned a lot from the very first lesson. Victor is very efficient and understanding when it comes to training! I highly recommend to try him out because my dogs have already improved and a lot of time is put into the aftercare of keeping our dogs trained.",
  },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mockup B — Pull Quotes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #0B2744; }
    .mockup-label {
      position: fixed; top: 0; left: 0; right: 0;
      background: #1e3a5f; color: #D1B27F; font-size: 13px; font-weight: 700;
      text-align: center; padding: 8px; letter-spacing: 0.1em; z-index: 100;
    }
    .kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.25em; color: rgba(209,178,127,0.5); text-transform: uppercase; margin-bottom: 20px; }
    h2 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); color: #fff; line-height: 1.1; }
    .accent { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(2rem, 5vw, 3rem); color: #D1B27F; display: block; }
    .quote-mark { font-family: 'Playfair Display', serif; font-size: 80px; line-height: 0.75; color: #D1B27F; opacity: 0.5; display: block; margin-bottom: 4px; }
    blockquote { font-family: 'Playfair Display', serif; font-style: italic; font-size: 17px; line-height: 1.8; color: rgba(255,255,255,0.9); white-space: pre-line; }
    .author-name { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 14px; color: #fff; }
    .author-sub { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #0F8992; margin-top: 2px; }
  </style>
</head>
<body>
  <div class="mockup-label">MOCKUP B — STACKED PULL QUOTES (full review text)</div>

  <section style="position:relative; padding: 100px 24px 72px; overflow: hidden;">
    <div style="position:absolute; inset:0; z-index:0;">
      <Image src={bgImage} alt="" style="width:100%; height:100%; object-fit:cover; opacity:0.35;" />
      <div style="position:absolute; inset:0; background: linear-gradient(to bottom, rgba(11,39,68,0.85), rgba(11,39,68,0.65), #0B2744);"></div>
    </div>

    <div style="position:relative; z-index:10; max-width: 720px; margin: 0 auto;">
      <!-- Header -->
      <div style="text-align:center; margin-bottom: 56px;">
        <p class="kicker">Happy Pack Members</p>
        <h2>Real Families.<span class="accent">Real Results.</span></h2>
        <div style="margin-top:20px; display:flex; justify-content:center;">
          <div style="width:64px; height:3px; background:#D1B27F; border-radius:999px;"></div>
        </div>
      </div>

      <!-- Stacked quotes -->
      <div style="display:flex; flex-direction:column; gap: 0;">
        {reviews.map((r, i) => (
          <>
            <div style="display:flex; flex-direction:column; gap:16px; padding: 8px 0 40px;">
              <!-- Stars -->
              <div style="display:flex; gap:3px;">
                {[...Array(5)].map(() => (
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="#D1B27F"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>

              <span class="quote-mark">"</span>
              <blockquote>{r.quote}"</blockquote>

              <!-- Author with gold left bar -->
              <div style="display:flex; align-items:center; gap:12px; margin-top:8px;">
                <div style="width:3px; height:36px; background:#D1B27F; border-radius:2px; flex-shrink:0;"></div>
                <div>
                  <p class="author-name">{r.client_name}</p>
                  {r.sub_label && <p class="author-sub">{r.sub_label}</p>}
                </div>
              </div>
            </div>

            {/* Horizontal divider between reviews */}
            {i < reviews.length - 1 && (
              <div style="display:flex; align-items:center; gap:16px; margin-bottom:40px;">
                <div style="flex:1; height:1px; background:rgba(209,178,127,0.2);"></div>
                <svg width="16" height="16" viewBox="0 0 20 20" fill="#D1B27F" style="opacity:0.4; flex-shrink:0;"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <div style="flex:1; height:1px; background:rgba(209,178,127,0.2);"></div>
              </div>
            )}
          </>
        ))}
      </div>

      <!-- CTA -->
      <div style="margin-top:16px; text-align:center;">
        <a href="#" style="display:inline-block; background:#D1B27F; color:#0B2744; font-family:'Inter',sans-serif; font-weight:700; font-size:14px; letter-spacing:0.1em; text-transform:uppercase; padding:14px 32px; border-radius:8px; text-decoration:none;">View the Transformations</a>
      </div>
    </div>
  </section>
</body>
</html>
