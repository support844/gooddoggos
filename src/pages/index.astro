                                </div>

                                <!-- Best Fit Column -->
                                <div
                                    class="lg:w-[45%] lg:border-l border-secondary-slate/10 lg:pl-10 flex flex-col gap-4 w-full"
                                >
                                    <div>
                                        <div
                                            class="flex items-center justify-between mb-2"
                                        >
                                            <p
                                                class="text-[11px] font-bold text-secondary-slate/40 uppercase tracking-widest"
                                            >
                                                Best Fit:
                                            </p>
                                            <div
                                                class="flex items-center gap-2"
                                            >
                                                <span
                                                    class="text-[10px] font-bold font-body text-secondary-slate/50"
                                                    >Intensity: <span
                                                        class="text-primary-navy"
                                                        >Low</span
                                                    >
                                                </span>
                                                <div class="flex gap-1">
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-[#00727A]"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-[#00727A]"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-secondary-slate/10"
                                                    >
                                                    </div>
                                                    <div
