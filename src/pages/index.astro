                    <div
                        class="relative h-full flex flex-col justify-between py-10 text-[11px] font-bold text-secondary-slate/60 uppercase tracking-widest leading-none"
                    >
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center translate-y-4"
                        >
                            <span>LOW</span>
                            <span class="rotate-90">→</span>
                        </div>
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center"
                        >
                            <span>MODERATE</span>
                            <span class="rotate-90">→</span>
                        </div>
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center -translate-y-4"
