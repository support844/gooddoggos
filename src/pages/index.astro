                                >
                                </div>
                                <!-- Color Overlay Layer -->
                                <div class="absolute inset-0 bg-[#00727A]/78">
                                </div>
                                <!-- Gloss Highlight -->
                                <div
                                    class="absolute inset-0 bg-gradient-to-tr from-white/15 via-transparent to-transparent pointer-events-none"
                                >
                                </div>

                                <!-- Slant overlay for the panel edge -->
                                <div
                                    class="absolute top-0 bottom-0 -right-8 w-16 bg-[#00727A] transform -skew-x-[15deg] hidden md:block"
                                >
