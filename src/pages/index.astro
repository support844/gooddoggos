---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import CTASection from "../components/CTASection.astro";
import { getCollection } from "astro:content";
import Parser from "rss-parser";

// Fetch Substack Feed
let latestPosts: any[] = [];
try {
    const parser = new Parser();
    const feed = await parser.parseURL("https://gooddoggos.substack.com/feed");
    latestPosts = feed.items.slice(0, 3);
} catch (e) {
    console.error("Failed to fetch Substack feed", e);
}

const programs = await getCollection("programs");
---

<Layout>
    <Hero />

    <!-- What to Expect in Your Free Session -->
    <section class="py-24 px-4 relative overflow-hidden bg-[#FBF1E9]">
        <!-- Lighting layers for depth -->
        <!-- Center Spotlight (Subtle) -->
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] bg-white opacity-40 rounded-full blur-[140px] pointer-events-none z-0"
        >
        </div>

        <!-- Subtle brand watermark/dog outline on the right -->
        <div
            class="absolute right-[-10%] top-1/2 -translate-y-1/2 opacity-[0.05] pointer-events-none z-0 w-[600px] h-[600px]"
        >
            <img
                src="/images/Horizontal logo - Good Doggos - Navy.png"
                alt="Watermark"
                class="w-full h-full object-contain filter grayscale invert"
            />
        </div>

        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center mb-20">
                <p class="kicker kicker-dark mb-4">Our Process</p>
                <h2
                    class="text-4xl md:text-5xl font-heading font-bold text-primary-navy mb-4 leading-tight"
                >
                    What to Expect in Your <br />
                    <span
                        class="headline-accent text-4xl md:text-5xl font-bold mt-2 block"
                        >Free Session</span
                    >
                </h2>
                <p
                    class="text-lg text-primary-navy/70 max-w-2xl mx-auto font-body"
                >
                    Our proven protocol to understand your dog and build the
                    perfect roadmap for transformation.
                </p>
            </div>

            <div class="grid lg:grid-cols-3 gap-8 items-stretch mb-12">
                <!-- ================= THE 3 PROTOCOL STEPS ================= -->

                <!-- STEP 1: Application -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4px_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        01
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        The Application
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        Secure your spot. Because we take a limited number of
                        cases, we review every application so we can come
                        prepared with the right plan and confirm you're a
                        candidate for our programs.
                    </p>
                </div>

                <!-- STEP 2: In-Person Diagnostic -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4px_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        02
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        In-Person Diagnostic
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        We assess triggers, reactivity patterns, and handling
                        gaps, then teach you 1–2 starter drills you can use
                        immediately to start shifting your dog's state.
                    </p>
                </div>

                <!-- STEP 3: The Roadmap -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        03
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        The Roadmap
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        We sit down to review findings and hand you a custom
                        plan. You'll know what's driving the behavior, what to
                        do first, and the best program to support you.
                    </p>
                </div>
            </div>

            <!-- "You'll Leave With" Card -->
            <div class="max-w-3xl mx-auto">
                <div
                    class="bg-primary-navy rounded-[24px] shadow-[0_30px_60px_rgba(11,39,68,0.25)] p-8 md:p-12 relative overflow-hidden"
                >
                    <!-- Material Sheen -->
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent pointer-events-none z-0"
                    >
                    </div>

                    <div
                        class="relative z-10 flex flex-col md:flex-row items-center gap-10"
                    >
                        <div class="flex-grow">
                            <h3
                                class="text-2xl font-heading font-bold text-white mb-8"
                            >
                                You'll Leave With:
                            </h3>
                            <ul class="space-y-4">
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <div
                                        class="w-2 h-2 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(209,178,127,0.5)]"
                                    >
                                    </div>
                                    Your dog's root triggers
                                </li>
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <div
                                        class="w-2 h-2 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(209,178,127,0.5)]"
                                    >
                                    </div>
                                    Custom weekly roadmap
                                </li>
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <div
                                        class="w-2 h-2 rounded-full bg-accent-gold shadow-[0_0_10px_rgba(209,178,127,0.5)]"
                                    >
                                    </div>
                                    First steps toward faster progress
                                </li>
                            </ul>
                        </div>

                        <div class="flex-shrink-0">
                            <a href="/apply" class="btn-apply px-10">
                                Book Your Free Assessment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reactivity Spectrum -->
    <section class="py-24 bg-[#FCF9FA] px-4 relative overflow-hidden">
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center mb-20">
                <p class="kicker kicker-dark mb-4">Diagnostics</p>
                <h2
