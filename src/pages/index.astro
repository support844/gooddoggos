                                                </div>
                                            </div>
                                        </div>
                                        <div
                                            class="bg-[#00727A]/5 border border-[#00727A]/10 rounded-xl px-6 py-3 w-full"
                                        >
                                            <span
                                                class="text-primary-navy font-bold text-[16px] block leading-tight tracking-tight text-center lg:text-left"
                                                >Calm Companion Challenge</span
                                            >
                                        </div>
                                    </div>
                                    <a
                                        href="/programs#calm-companion"
                                        class="bg-[#00727A] text-white font-bold text-[13px] py-3.5 rounded-xl w-full flex items-center justify-center gap-2 hover:bg-[#005F65] transition-colors tracking-wide shadow-sm"
                                    >
                                        Learn More <span>&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TIER 2: Reactive Protector (Gold) -->
                    <div class="relative">
                        <div
                            class="bg-white rounded-[24px] shadow-[0_15px_60px_rgba(11,39,68,0.06)] border border-[#EAE1D3]/50 overflow-hidden flex flex-col md:flex-row items-stretch group transition-all duration-500"
                        >
                            <!-- Left Slanted Color Panel -->
                            <div
                                class="w-full md:w-[28%] flex-shrink-0 relative overflow-hidden flex items-center p-6 md:p-8"
