---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import CTASection from "../components/CTASection.astro";
import { getCollection } from "astro:content";

// Asset Imports
import brandLogoNavy from "../assets/images/horizontal-logo---good-doggos---navy.png";
import alexasFotos from "../assets/images/alexas_fotos-8Uw56bHhuOc-unsplash.jpg";
import christianTesta from "../assets/images/christian-testa-kQLL6Ao7V4k-unsplash.jpg";
import jamieStreet from "../assets/images/jamie-street-s9Tf1eBdFqw-unsplash.jpg";
import simbaPackBanner from "../assets/images/Simba-and-Pack-Banner.png";
import sumeetSingh from "../assets/images/sumeet-singh-0Jefpcomlzs-unsplash.jpg";
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
import paulineLoroy from "../assets/images/pauline-loroy-U3aF7hgUSrk-unsplash.jpg";
// Paw print bullet
import goldPawPrint from "../assets/images/Paw Prints/Gold Paw Print.png";
// Rotating banner photos
import rotatingAvi from "../assets/images/avi-richards-aYHgchNOsGY-unsplash.jpg";
import rotatingDiana from "../assets/images/diana-parkhouse-e2YwwTG-viI-unsplash.jpg";
import rotatingVictor from "../assets/images/victor-walking-pack.png";
import rotatingBruce from "../assets/images/bruce-warrington-WSAOGHKEqFc-unsplash.jpg";
import rotatingKojirou from "../assets/images/kojirou-sasaki-Tx7cJ3t207k-unsplash.jpg";
import rotatingJoe from "../assets/images/joe-caione-qO-PIF84Vxg-unsplash.jpg";
import rotatingDavid from "../assets/images/david-taffet-DNViTo3BUpk-unsplash.jpg";

const programs = await getCollection("programs");
---

<Layout title="Dog Trainer San Jacinto CA | Reactive Dogs | Good Doggos" description="Good Doggos — San Jacinto's expert dog trainer specializing in reactive and aggressive dogs. Apply for a Free Behavioral Assessment today.">
    <Fragment slot="head">
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "Good Doggos",
          "description": "Expert dog trainer in San Jacinto, CA specializing in reactive, aggressive, and fear-based dog behavior. Using a balanced training approach to transform problem dogs into calm companions.",
          "url": "https://gooddoggos.com",
          "telephone": "+19514016252",
          "priceRange": "$$",
          "image": "https://gooddoggos.com/images/Circle%20Navy%20Dog%20Mascot%20Light%20Gold%20BG%20Transparent%20-%20Good%20Doggos.png",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Jacinto",
            "addressRegion": "CA",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 33.7847,
            "longitude": -116.9589
          },
          "areaServed": [
            { "@type": "City", "name": "San Jacinto" },
            { "@type": "City", "name": "Hemet" },
            { "@type": "AdministrativeArea", "name": "Riverside County" },
            { "@type": "AdministrativeArea", "name": "Inland Empire" }
          ],
          "serviceType": [
            "Dog Training",
            "Pet Training",
            "Dog Walking",
            "Pet Sitting",
            "Aggression Rehabilitation",
            "Leash Reactivity Training"
          ],
          "sameAs": [
            "https://gooddoggos.substack.com"
          ]
        }
        </script>
    </Fragment>
    <Hero />

    <!-- What to Expect in Your Free Session -->
    <section class="py-24 px-4 relative overflow-hidden bg-[#FBF1E9]">
        <!-- Lighting layers for depth -->
        <!-- Center Spotlight (Subtle) -->
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] bg-white opacity-40 rounded-full blur-[140px] pointer-events-none z-0"
        >
        </div>

        <!-- Subtle brand watermark/dog outline on the right -->
        <div
            class="absolute right-[-10%] top-1/2 -translate-y-1/2 opacity-[0.05] pointer-events-none z-0 w-[600px] h-[600px]"
        >
            <Image
                src={brandLogoNavy}
                alt="Watermark"
                class="w-full h-full object-contain filter grayscale invert"
            />
        </div>

        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center mb-20">
                <p class="kicker kicker-dark mb-4">Our Process</p>
                <h2
                    class="text-4xl md:text-5xl font-heading font-bold text-primary-navy mb-4 leading-tight"
                >
                    What to Expect in Your <br />
                    <span
                        class="headline-accent text-4xl md:text-5xl font-bold mt-2 block"
                        >Free Session</span
                    >
                </h2>
                <p
                    class="text-lg text-primary-navy/70 max-w-2xl mx-auto font-body"
                >
                    Our proven protocol to understand your dog and build the perfect dog training roadmap for transformation, guided by an expert pet trainer.
                </p>
            </div>

            <div class="grid lg:grid-cols-3 gap-8 items-stretch mb-12">
                <!-- ================= THE 3 PROTOCOL STEPS ================= -->

                <!-- STEP 1: Application -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4px_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        01
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        The Application
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        Secure your spot. Because we take a limited number of
                        cases, we review every application so we can come
                        prepared with the right plan and confirm you're a
                        candidate for our programs.
                    </p>
                </div>

                <!-- STEP 2: In-Person Diagnostic -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4px_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        02
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        In-Person Diagnostic
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        We assess triggers, reactivity patterns, and handling
                        gaps, then teach you 1–2 starter drills you can use
                        immediately to start shifting your dog's state.
                    </p>
                </div>

                <!-- STEP 3: The Roadmap -->
                <div
                    class="bg-[#FCF9FA] rounded-[24px] border border-[#EAE1D3]/60 shadow-[0_15px_40px_rgba(11,39,68,0.06),0_4_10px_rgba(11,39,68,0.04)] p-8 md:p-10 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-500"
                >
                    <!-- Step Watermark Number -->
                    <div
                        class="absolute top-6 right-8 font-heading font-bold text-[80px] leading-none text-primary-navy/10 select-none group-hover:text-primary-navy/15 transition-colors"
                    >
                        03
                    </div>

                    <!-- Icon Chip -->
                    <div
                        class="w-14 h-14 bg-accent-gold/10 rounded-2xl flex items-center justify-center mb-8 border border-accent-gold/20"
                    >
                        <svg
                            class="w-7 h-7 text-accent-gold"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-heading font-bold text-primary-navy mb-4"
                    >
                        The Roadmap
                    </h3>
                    <p
                        class="text-secondary-slate/85 leading-[1.7] text-[15px] font-body"
                    >
                        We sit down to review findings and hand you a custom
                        plan. You'll know what's driving the behavior, what to
                        do first, and the best program to support you.
                    </p>
                </div>
            </div>

            <!-- "You'll Leave With" Card -->
            <div class="max-w-3xl mx-auto">
                <div
                    class="bg-primary-navy rounded-[24px] shadow-[0_30px_60px_rgba(11,39,68,0.25)] p-8 md:p-12 relative overflow-hidden"
                >
                    <!-- Material Sheen -->
                    <div
                        class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent pointer-events-none z-0"
                    >
                    </div>

                    <div
                        class="relative z-10 flex flex-col md:flex-row items-center gap-10"
                    >
                        <div class="flex-grow">
                            <h3
                                class="text-2xl font-heading font-bold text-white mb-8"
                            >
                                You'll Leave With:
                            </h3>
                            <ul class="space-y-4">
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <Image
                                        src={goldPawPrint}
                                        alt=""
                                        class="w-5 h-5 object-contain flex-shrink-0 opacity-90"
                                        loading="eager"
                                    />
                                    Your dog's root triggers
                                </li>
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <Image
                                        src={goldPawPrint}
                                        alt=""
                                        class="w-5 h-5 object-contain flex-shrink-0 opacity-90"
                                        loading="eager"
                                    />
                                    Custom weekly roadmap
                                </li>
                                <li
                                    class="flex items-center gap-4 text-white/90 font-body"
                                >
                                    <Image
                                        src={goldPawPrint}
                                        alt=""
                                        class="w-5 h-5 object-contain flex-shrink-0 opacity-90"
                                        loading="eager"
                                    />
                                    First steps toward faster progress
                                </li>
                            </ul>
                        </div>

                        <div class="flex-shrink-0">
                            <a href="/apply" class="btn-apply px-10">
                                Book Your Free Assessment
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reactivity Spectrum -->
    <section class="py-24 bg-[#FCF9FA] px-4 relative overflow-hidden">
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="text-center mb-20">
                <p class="kicker kicker-dark mb-4">DOG TRAINING PROGRAMS</p>
                <h2
                    class="text-4xl md:text-5xl font-heading font-bold text-primary-navy mb-4 leading-tight"
                >
                    Find Your Dog On The <br />
                    <span
                        class="headline-accent text-4xl md:text-5xl font-bold mt-2 block"
                        >Reactivity Spectrum</span
                    >
                </h2>
                <p
                    class="text-lg text-primary-navy/70 max-w-2xl mx-auto font-body"
                >
                    Where does your dog fall? We have a tailored <a href="/programs" class="text-accent-teal hover:underline font-semibold">dog training program</a> for every stage of arousal and reactivity.
                </p>
            </div>

            <div class="lg:max-w-[1140px] lg:mx-auto">
            <div class="relative flex flex-col md:flex-row gap-8 lg:gap-12">
                <!-- FAR LEFT VERTICAL RAIL (Desktop) -->
                <div
                    class="hidden md:flex flex-col items-center py-10 w-12 flex-shrink-0 relative"
                >
                    <!-- The Gradient Rail -->
                    <div
                        class="absolute inset-y-0 w-2.5 bg-gradient-to-b from-accent-brightTeal via-accent-warmGold to-[#6B1B1B] rounded-full opacity-80"
                    >
                    </div>

                    <div
                        class="relative h-full flex flex-col justify-between py-10 text-[11px] font-bold text-secondary-slate/60 uppercase tracking-widest leading-none"
                    >
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center translate-y-4"
                        >
                            <span>LOW</span>
                            <span class="rotate-90">→</span>
                        </div>
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center"
                        >
                            <span>MODERATE</span>
                            <span class="rotate-90">→</span>
                        </div>
                        <div
                            class="flex flex-col items-center gap-2 transform -rotate-90 origin-center -translate-y-4"
                        >
                            <span>HIGH</span>
                            <span class="rotate-90">→</span>
                        </div>
                    </div>
                </div>

                <!-- SPECTRUM BANDS -->
                <div class="flex-grow space-y-6">
                    <!-- TIER 1: Frustrated Greeter (Teal) -->
                    <div class="relative">
                        <div
                            class="bg-white rounded-[22px] shadow-[0_12px_45px_rgba(11,39,68,0.05)] border border-[#EAE1D3]/50 overflow-hidden flex flex-col md:flex-row items-stretch group transition-all duration-500"
                        >
                            <!-- Left Slanted Color Panel -->
                            <div
                                class="w-full md:w-[28%] flex-shrink-0 relative overflow-hidden flex items-center p-6 md:p-8"
                            >
                                <!-- Dog Photo Background Texture Layer -->
                                <Image
                                    src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&q=80&w=1000"
                                    alt="Frustrated greeter dog"
                                    class="absolute inset-0 w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-110"
                                    width={1000}
                                    height={667}
                                />
                                <!-- Color Overlay Layer -->
                                <div class="absolute inset-0 bg-[#00727A]/70">
                                </div>
                                <!-- Gloss Highlight -->
                                <div
                                    class="absolute inset-0 bg-gradient-to-tr from-white/15 via-transparent to-transparent pointer-events-none"
                                >
                                </div>

                                <!-- Slant overlay for the panel edge -->
                                <div
                                    class="absolute top-0 bottom-0 -right-8 w-16 bg-[#00727A] transform -skew-x-[15deg] hidden md:block"
                                >
                                </div>

                                <div class="relative z-10 flex flex-col gap-3">
                                    <!-- Icon Badge Overlapping Panel -->
                                    <div
                                        class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center border border-white/20 shadow-lg"
                                    >
                                        <svg
                                            class="w-6 h-6 text-white"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3
                                            class="text-[22px] font-heading font-bold text-white leading-tight"
                                        >
                                            Frustrated Greeter
                                        </h3>
                                        <p
                                            class="text-white/80 font-body italic text-[13px] mt-0.5"
                                        >
                                            Pulling & Excitement
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Content area -->
                            <div
                                class="p-6 md:p-8 md:pl-12 flex-grow flex flex-col lg:flex-row items-start lg:items-center gap-6 md:gap-12"
                            >
                                <!-- Bullets Column -->
                                <div class="lg:w-[45%]">
                                    <ul class="space-y-3">
                                        <li
                                            class="flex items-start gap-4 text-secondary-slate text-[14px] font-body leading-relaxed"
                                        >
                                            <div
                                                class="w-1.5 h-1.5 rounded-full bg-[#00727A] mt-1.5 flex-shrink-0"
                                            >
                                            </div>
                                            Pulls on leash toward people or dogs
                                        </li>
                                        <li
                                            class="flex items-start gap-4 text-secondary-slate text-[14px] font-body leading-relaxed"
                                        >
                                            <div
                                                class="w-1.5 h-1.5 rounded-full bg-[#00727A] mt-1.5 flex-shrink-0"
                                            >
                                            </div>
                                            Whines or barks out of excitement
                                        </li>
                                        <li
                                            class="flex items-start gap-4 text-secondary-slate text-[14px] font-body leading-relaxed"
                                        >
                                            <div
                                                class="w-1.5 h-1.5 rounded-full bg-[#00727A] mt-1.5 flex-shrink-0"
                                            >
                                            </div>
                                            Friendly intent but over-aroused
                                        </li>
                                    </ul>
                                </div>

                                <!-- Best Fit Column -->
                                <div
                                    class="lg:w-[45%] lg:border-l border-secondary-slate/10 lg:pl-10 flex flex-col gap-4 w-full"
                                >
                                    <div>
                                        <div
                                            class="flex items-center justify-between mb-2"
                                        >
                                            <p
                                                class="text-[11px] font-bold text-secondary-slate/40 uppercase tracking-widest"
                                            >
                                                Best Fit:
                                            </p>
                                            <div
                                                class="flex items-center gap-2"
                                            >
                                                <span
                                                    class="text-[10px] font-bold font-body text-secondary-slate/50"
                                                    >Intensity: <span
                                                        class="text-primary-navy"
                                                        >Low</span
                                                    >
                                                </span>
                                                <div class="flex gap-1">
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-[#00727A]"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-[#00727A]"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-secondary-slate/10"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-secondary-slate/10"
                                                    >
                                                    </div>
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-secondary-slate/10"
                                                    >
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div
                                            class="bg-[#00727A]/5 border border-[#00727A]/10 rounded-xl px-6 py-3 w-full"
                                        >
                                            <span
                                                class="text-primary-navy font-bold text-[13px] block leading-tight tracking-tight text-center lg:text-left"
                                                >Calm Companion Challenge</span
                                            >
                                        </div>
                                    </div>
                                    <a
                                        href="/programs#calm-companion"
                                        class="bg-[#00727A] text-white font-bold text-[13px] py-3.5 rounded-xl w-full flex items-center justify-center gap-2 hover:bg-[#005F65] transition-colors tracking-wide shadow-sm"
                                    >
                                        Learn More <span>&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TIER 2: Reactive Protector (Gold) -->
                    <div class="relative">
                        <div
                            class="bg-white rounded-[24px] shadow-[0_15px_60px_rgba(11,39,68,0.06)] border border-[#EAE1D3]/50 overflow-hidden flex flex-col md:flex-row items-stretch group transition-all duration-500"
                        >
                            <!-- Left Slanted Color Panel -->
                            <div
                                class="w-full md:w-[28%] flex-shrink-0 relative overflow-hidden flex items-center p-6 md:p-8"
                            >
                                <!-- Dog Photo Background Texture Layer -->
                                <Image
                                    src={sumeetSingh}
                                    alt="Reactive protector dog"
                                    class="absolute inset-0 w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-110"
                                />
                                <!-- Color Overlay Layer -->
                                <div class="absolute inset-0 bg-[#D1B27F]/70">
                                </div>
                                <!-- Gloss Highlight -->
                                <div
                                    class="absolute inset-0 bg-gradient-to-tr from-white/15 via-transparent to-transparent pointer-events-none"
                                >
                                </div>

                                <!-- Slant overlay for the panel edge -->
                                <div
                                    class="absolute top-0 bottom-0 -right-8 w-16 bg-[#D1B27F] transform -skew-x-[15deg] hidden md:block"
                                >
                                </div>

                                <div class="relative z-10 flex flex-col gap-3">
                                    <div
                                        class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-xl flex items-center justify-center border border-white/30 shadow-lg"
                                    >
                                        <svg
                                            class="w-6 h-6 text-white"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3
                                            class="text-[22px] font-heading font-bold text-white leading-tight"
                                        >
                                            Reactive Protector
                                        </h3>
                                        <p
                                            class="text-white/80 font-body italic text-[13px] mt-0.5"
                                        >
                                            Lunging & Barking
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="p-6 md:p-8 md:pl-12 flex-grow flex flex-col lg:flex-row items-start lg:items-center gap-6 md:gap-12"
