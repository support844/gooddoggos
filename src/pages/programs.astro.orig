  <CTASection />
</Layout>

<script>
  function toggleSlab(id: string) {
    const drawer = document.getElementById(`${id}-drawer`);
    const label = document.getElementById(`${id}-label`);
    const chev = document.getElementById(`${id}-chevron`);
    if (!drawer || !label || !chev) return;
    const wasHidden = drawer.classList.toggle("hidden");
    label.textContent = wasHidden ? "View Full Details" : "Hide Details";
    (chev as HTMLElement).style.transform = wasHidden ? "" : "rotate(180deg)";
  }
  function toggleFaqBlock(id: string) {
    const block = document.getElementById(id);
    const chev = document.getElementById(`${id}-chevron`);
    if (!block || !chev) return;
    const wasHidden = block.classList.toggle("hidden");
    (chev as HTMLElement).style.transform = wasHidden ? "" : "rotate(180deg)";
  }
  function toggleFaq(id: string) {
    const content = document.getElementById(id);
    const icon = document.getElementById(`${id}-icon`);
    if (!content || !icon) return;
    const wasHidden = content.classList.toggle("hidden");
    (icon as HTMLElement).style.transform = wasHidden ? "" : "rotate(45deg)";
  }
  (window as any).toggleSlab = toggleSlab;
  (window as any).toggleFaqBlock = toggleFaqBlock;
  (window as any).toggleFaq = toggleFaq;
</script>
