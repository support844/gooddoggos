---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";

// ── Canonical program color tokens ──
const TEAL = {
  bg: "#0F6D72",
  text: "white",
  border: "rgba(15,109,114,0.3)",
  tint: "rgba(15,109,114,0.08)",
};
const GOLD = {
  bg: "#D1B27F",
  text: "#0B2744",
  border: "rgba(209,178,127,0.35)",
  tint: "rgba(209,178,127,0.10)",
};
const RED = {
  bg: "#7D2C2D",
  text: "white",
  border: "rgba(125,44,45,0.25)",
  tint: "rgba(125,44,45,0.07)",
};
---

<style>
  /* Anchor pill hover/active color-coded states */
  .pill-teal:hover {
    background: rgba(15, 109, 114, 0.1) !important;
    outline-color: #0f6d72 !important;
    color: #0f6d72 !important;
  }
  .pill-gold:hover {
    background: rgba(209, 178, 127, 0.12) !important;
    outline-color: #d1b27f !important;
    color: #b8983f !important;
  }
  .pill-red:hover {
    background: rgba(125, 44, 45, 0.08) !important;
    outline-color: #7d2c2d !important;
    color: #7d2c2d !important;
  }
  .pill-teal:focus,
  .pill-teal.active {
    background: rgba(15, 109, 114, 0.1) !important;
    outline-color: #0f6d72 !important;
    color: #0f6d72 !important;
  }
  .pill-gold:focus,
  .pill-gold.active {
    background: rgba(209, 178, 127, 0.12) !important;
    outline-color: #d1b27f !important;
    color: #b8983f !important;
  }
  .pill-red:focus,
  .pill-red.active {
    background: rgba(125, 44, 45, 0.08) !important;
    outline-color: #7d2c2d !important;
    color: #7d2c2d !important;
  }
</style>

<Layout>
  <!-- ════════════════════════════════════════
     HERO — "Choose Your Path"
════════════════════════════════════════ -->
  <section
    class="relative flex items-end overflow-hidden bg-[#0B2744]"
    style="min-height: 52vh;"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?auto=format&fit=crop&q=80&w=2400"
        alt="Dog training"
        class="w-full h-full object-cover object-center opacity-35"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/85 via-[#0B2744]/65 to-[#0B2744]"
      >
      </div>
    </div>

    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-14"
      style="padding-top: 160px;"
    >
      <div class="text-center max-w-2xl mx-auto">
        <p
          class="text-[11px] font-bold tracking-[0.28em] uppercase mb-4"
          style="color: rgba(209,178,127,0.65);"
        >
          Training Programs
        </p>
        <h1
          class="text-5xl md:text-6xl font-heading font-bold text-white leading-tight mb-3"
        >
          Choose Your Path
        </h1>
        <p class="text-gray-300 mb-8 text-lg">
          Guaranteed results for families who want <span
            class="headline-accent"
            style="color:#D1B27F;">the best for their dog.</span
          >
        </p>

        <!-- Anchor Pills — each colored by program -->
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="#calm-companion"
            class="pill-teal px-5 py-2 rounded-full text-xs font-bold tracking-wider uppercase transition-all duration-200"
            style="outline: 1px solid rgba(15,109,114,0.5); color: rgba(209,178,127,0.8); background: transparent;"
          >
            Calm Companion
          </a>
          <a
            href="#private-accelerator"
            class="pill-gold px-5 py-2 rounded-full text-xs font-bold tracking-wider uppercase transition-all duration-200"
            style="outline: 1px solid rgba(209,178,127,0.45); color: rgba(209,178,127,0.8); background: transparent;"
          >
            Private Accelerator
          </a>
          <a
            href="#red-zone"
            class="pill-red px-5 py-2 rounded-full text-xs font-bold tracking-wider uppercase transition-all duration-200"
            style="outline: 1px solid rgba(125,44,45,0.4); color: rgba(209,178,127,0.8); background: transparent;"
          >
            Red Zone Intensive
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
     PROGRAMS — HORIZONTAL SLABS
════════════════════════════════════════ -->
  <div class="bg-[#FBF1E9] py-10">
    <div class="max-w-7xl mx-auto px-4 md:px-8 space-y-4">
      <!-- ══════════════════════════════════
         SLAB 1 — CALM COMPANION (TEAL)
    ══════════════════════════════════ -->
      <div
        id="calm-companion"
        class="scroll-mt-36 rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.07)] flex flex-col"
      >
        <!-- Teal left accent strip via flex row wrapper -->
        <div class="flex flex-col md:flex-row flex-1">
          <!-- Accent Strip -->
          <div
            class="hidden md:block flex-shrink-0"
            style="width: 11px; background: #0F6D72; border-radius: 16px 0 0 0;"
          >
          </div>
          <div
            class="block md:hidden h-[9px] w-full"
            style="background: #0F6D72;"
          >
          </div>

          <div
            class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0"
          >
            <!-- Photo -->
            <div class="relative overflow-hidden" style="min-height: 260px;">
              <img
                src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?auto=format&fit=crop&q=80&w=600"
                alt="Calm Companion Training"
                class="w-full h-full object-cover"
                style="min-height:260px;"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"
              >
              </div>
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase text-white px-3 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.80); backdrop-filter: blur(6px);"
                  >★ Flagship Offer</span
                >
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >4–6 Weeks</span
                >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >Group + Private</span
                >
              </div>
              <h2
                class="text-2xl font-heading font-bold mb-0.5"
                style="color: #112032;"
              >
                Calm Companion
              </h2>
              <p class="text-sm font-semibold mb-3" style="color: #0F6D72;">
                The Foundation for a Happy Home
              </p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                $1,800 – <span style="color: #0F6D72;">$2,500</span>
              </p>
              <p
                class="text-sm leading-relaxed"
                style="color: rgba(17,32,50,0.72);"
              >
                Perfect for puppies and adult dogs needing basic obedience and
                manner refinement. We focus on engagement, neutrality, and
                household manners — building the foundation your dog needs to
                thrive everywhere.
              </p>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-7 flex flex-col justify-between">
              <ul class="space-y-2 mb-6">
                {
                  [
                    "Loose leash walking mastery",
                    "Recall foundation & place command",
                    "Social neutrality training",
                    "Helper dog exposure reps",
                    "Daily homework & practice plans",
                    "Results guarantee",
                  ].map((item) => (
                    <li
                      class="flex items-start gap-2.5 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <svg
                        class="w-4 h-4 mt-0.5 flex-shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="#0F6D72"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      {item}
                    </li>
                  ))
                }
              </ul>
              <a
                href="/apply"
                class="inline-flex items-center justify-center gap-2 text-sm font-bold tracking-widest uppercase rounded-full transition-all duration-200 hover:-translate-y-0.5"
                style="background:#0F6D72; color:white; padding:14px 28px; box-shadow:0 4px 14px rgba(15,109,114,0.30);"
              >
                Apply for Assessment →
              </a>
            </div>
          </div>
        </div>

        <!-- Centered "View Full Details" pill -->
        <div class="flex justify-center py-4 border-t border-[#E6DAC6]/60">
          <button
            id="calm-toggle"
            onclick="toggleSlab('calm')"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-bold tracking-wide transition-all duration-200"
            style="border: 1px solid #E6DAC6; background: #FCF9FA; color: #112032;"
          >
            <span id="calm-label">View Full Details</span>
            <svg
              id="calm-chevron"
              class="w-3.5 h-3.5 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <!-- Expandable Drawer -->
        <div id="calm-drawer" class="hidden border-t border-[#E6DAC6]">
          <div class="grid md:grid-cols-2 gap-8 px-8 py-8">
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-4"
                style="color: rgba(17,32,50,0.40);"
              >
                What's Included
              </p>
              <ul class="space-y-3">
                {
                  [
                    {
                      icon: "👥",
                      text: "4–6 Weekly Group Sessions (90 min each)",
                    },
                    { icon: "📋", text: "Daily Homework & Practice Plans" },
                    { icon: "✉️", text: "Weekly Check-Ins & Feedback" },
                    { icon: "🐕", text: "Helper Dog Exposure Reps" },
                    { icon: "🔒", text: "Private Community Access" },
                    {
                      icon: "🏆",
                      text: "100% Money-Back Guarantee (requirements apply)",
                    },
                  ].map((i) => (
                    <li
                      class="flex items-start gap-3 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <span>{i.icon}</span>
                      {i.text}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-4"
                style="color: rgba(17,32,50,0.40);"
              >
                Value Stack
              </p>
              <div
                class="rounded-xl border border-[#E6DAC6] bg-white p-5 text-sm"
              >
                {
                  [
                    ["4-Week Transformation Curriculum", "$800"],
                    ["Daily HW Reviews & Feedback", "$600"],
                    ["Helper Dog Demos & Exposure", "$500"],
                    ["Basic Obedience Vault (Lifetime)", "$297"],
                    ["Money-Back Guarantee Opportunity", "$799"],
                  ].map(([label, price]) => (
                    <div class="flex justify-between py-2 border-b border-[#E6DAC6]/50 last:border-0">
                      <span style="color:rgba(17,32,50,0.65);">{label}</span>
                      <span class="font-bold" style="color:#0F6D72;">
                        {price}
                      </span>
                    </div>
                  ))
                }
                <div class="flex justify-between pt-3">
                  <span class="font-bold" style="color:#112032;"
                    >Total Value:</span
                  >
                  <span class="font-extrabold text-base" style="color:#0F6D72;"
                    >$2,995+</span
                  >
                </div>
              </div>
              <p class="text-xs mt-2 italic" style="color:rgba(17,32,50,0.38);">
                * Helper dogs are for demonstration only until graduation
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ: CALM COMPANION -->
      <div class="rounded-xl overflow-hidden border border-[#E6DAC6]/50">
        <button
          onclick="toggleFaqBlock('cc-faqs')"
          class="w-full flex items-center justify-between px-6 py-4 bg-white text-left"
        >
          <span
            class="text-xs font-bold tracking-widest uppercase"
            style="color:rgba(17,32,50,0.42);">Calm Companion FAQs (4)</span
          >
          <svg
            id="cc-faqs-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#0F6D72"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="cc-faqs" class="hidden">
          {
            [
              {
                q: "Is this right for excited greeters and leash pullers?",
                a: "Yes — it's our most common entry point. We address over-arousal, threshold reactivity, and pulling using structured exposure and helper dog setups that simulate real-world triggers.",
              },
              {
                q: "What if I miss a session?",
                a: "We offer one makeup credit per program cycle. Sessions can be rescheduled within the same window if space allows. 48-hour cancellation notice required.",
              },
              {
                q: "What does the guarantee require?",
                a: "Complete all sessions, submit all homework on time, and follow the daily protocol. Clients who meet all requirements and don't see measurable progress receive a full refund.",
              },
              {
                q: "Can I start if my dog has never been trained?",
                a: "Absolutely. The Calm Companion is our foundational program — no prior training required.",
              },
            ].map((faq, i) => (
              <div class="border-t border-[#E6DAC6]/50 bg-white">
                <button
                  class="w-full flex justify-between items-center px-6 py-4 text-left"
                  onclick={`toggleFaq('cc-q${i}')`}
                >
                  <span class="text-sm font-medium pr-4" style="color:#112032;">
                    {faq.q}
                  </span>
                  <svg
                    id={`cc-q${i}-icon`}
                    class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="#0F6D72"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                </button>
                <div id={`cc-q${i}`} class="hidden px-6 pb-4">
                  <p
                    class="text-sm leading-relaxed"
                    style="color:rgba(17,32,50,0.65);"
                  >
                    {faq.a}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ══════════════════════════════════
         SLAB 2 — PRIVATE ACCELERATOR (GOLD)
    ══════════════════════════════════ -->
      <div
        id="private-accelerator"
        class="scroll-mt-36 rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.07)] flex flex-col"
      >
        <div class="flex flex-col md:flex-row flex-1">
          <div
            class="hidden md:block flex-shrink-0"
            style="width: 11px; background: #D1B27F; border-radius: 16px 0 0 0;"
          >
          </div>
          <div
            class="block md:hidden h-[9px] w-full"
            style="background: #D1B27F;"
          >
          </div>

          <div
            class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0"
          >
            <!-- Photo -->
            <div class="relative overflow-hidden" style="min-height: 260px;">
              <img
                src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&q=80&w=600"
                alt="Private Accelerator Training"
                class="w-full h-full object-cover"
                style="min-height:260px;"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"
              >
              </div>
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.85); backdrop-filter: blur(6px); color: #0B2744;"
                  >🏆 Most Popular</span
                >
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.12); color: #B08A4A; border: 1px solid rgba(209,178,127,0.30);"
                  >8–10 Weeks</span
                >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.12); color: #B08A4A; border: 1px solid rgba(209,178,127,0.30);"
                  >1-on-1 Sessions</span
                >
              </div>
              <h2
                class="text-2xl font-heading font-bold mb-0.5"
                style="color: #112032;"
              >
                Private Accelerator
              </h2>
              <p class="text-sm font-semibold mb-3" style="color: #D1B27F;">
                Intensive On-Leash & Off-Leash Reliability
              </p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                $3,200 – <span style="color: #D1B27F;">$4,500</span>
              </p>
              <p
                class="text-sm leading-relaxed"
                style="color: rgba(17,32,50,0.72);"
              >
                Our most popular program. Comprehensive obedience training that
                gives you freedom and confidence anywhere you go — on or off
                leash. Built for high-energy dogs, selective listeners, and
                families with off-leash goals.
              </p>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-7 flex flex-col justify-between">
              <ul class="space-y-2 mb-6">
                {
                  [
                    "6+ Private 1-on-1 sessions",
                    "Off-leash recall & reliability",
                    "Public training trip transfers",
                    "Daily homework & accountability",
                    "24/7 trainer reachability",
                    "Good Doggos Results Guarantee",
                  ].map((item) => (
                    <li
                      class="flex items-start gap-2.5 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <svg
                        class="w-4 h-4 mt-0.5 flex-shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="#D1B27F"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      {item}
                    </li>
                  ))
                }
              </ul>
              <a
                href="/apply"
                class="inline-flex items-center justify-center gap-2 text-sm font-bold tracking-widest uppercase rounded-full transition-all duration-200 hover:-translate-y-0.5"
                style="background:#D1B27F; color:#0B2744; padding:14px 28px; box-shadow:0 4px 14px rgba(209,178,127,0.35);"
              >
                Apply for Assessment →
              </a>
            </div>
          </div>
        </div>

        <!-- Centered pill toggle -->
        <div class="flex justify-center py-4 border-t border-[#E6DAC6]/60">
          <button
            id="pa-toggle"
            onclick="toggleSlab('pa')"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-bold tracking-wide transition-all duration-200"
            style="border: 1px solid #E6DAC6; background: #FCF9FA; color: #112032;"
          >
            <span id="pa-label">View Full Details</span>
            <svg
              id="pa-chevron"
              class="w-3.5 h-3.5 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <!-- Expandable Drawer -->
        <div id="pa-drawer" class="hidden border-t border-[#E6DAC6]">
          <div class="grid md:grid-cols-2 gap-8 px-8 py-8">
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-4"
                style="color: rgba(17,32,50,0.40);"
              >
                What's Included
              </p>
              <ul class="space-y-3">
                {
                  [
                    { icon: "🎯", text: "6+ Private 1-on-1 Training Sessions" },
                    { icon: "🌍", text: "Public Training Trip Transfers" },
                    {
                      icon: "📋",
                      text: "Daily Homework & Accountability Reviews",
                    },
                    {
                      icon: "🐕",
                      text: "Helper Dog Exposure & Socialization Reps",
                    },
                    { icon: "📞", text: "24/7 Trainer Support Line" },
                    { icon: "🏆", text: "Full Good Doggos Results Guarantee" },
                  ].map((i) => (
                    <li
                      class="flex items-start gap-3 text-sm"
                      style="color:rgba(17,32,50,0.78);"
                    >
                      <span>{i.icon}</span>
                      {i.text}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-4"
                style="color: rgba(17,32,50,0.40);"
              >
                Value Stack
              </p>
              <div
                class="rounded-xl border border-[#E6DAC6] bg-white p-5 text-sm"
              >
                {
                  [
                    ["6 Private Sessions", "$1,800"],
                    ["Public Transfer Training Trips", "$900"],
                    ["Daily HW Reviews", "$600"],
                    ["Helper Dog Exposure Reps", "$750"],
                    ["Advanced Obedience Vault", "$497"],
                  ].map(([label, price]) => (
                    <div class="flex justify-between py-2 border-b border-[#E6DAC6]/50 last:border-0">
                      <span style="color:rgba(17,32,50,0.65);">{label}</span>
                      <span class="font-bold" style="color:#D1B27F;">
                        {price}
                      </span>
                    </div>
                  ))
                }
                <div class="flex justify-between pt-3">
                  <span class="font-bold" style="color:#112032;"
                    >Total Value:</span
                  >
                  <span class="font-extrabold text-base" style="color:#D1B27F;"
                    >$4,547+</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ: PRIVATE ACCELERATOR -->
      <div class="rounded-xl overflow-hidden border border-[#E6DAC6]/50">
        <button
