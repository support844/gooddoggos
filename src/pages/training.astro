  <CTASection />

  <script>
    // ── RDI accordion ──
    const ACCORDION_GROUPS: Record<string, string[]> = {
      rdi: ['rdi-panel'],
    };

    // ── Board & Train: full-width shared panel (desktop) / inline panel (mobile) ──
    const BT_PANELS   = ['bt-core-panel', 'bt-advanced-panel', 'bt-elite-panel'];
    const BT_PREFIXES = ['bt-core', 'bt-advanced', 'bt-elite'];
    const BT_ACTIVE_BG: Record<string, string> = {
      'bt-core':     'rgba(15,109,114,0.50)',
      'bt-advanced': 'rgba(11,39,68,0.50)',
      'bt-elite':    'rgba(202,164,103,0.50)',
    };
    const BT_COL_IDS: Record<string, string> = {
      'bt-core-panel':     'bt-core-col',
      'bt-advanced-panel': 'bt-advanced-col',
      'bt-elite-panel':    'bt-elite-col',
    };

    function resetBTButtons() {
      const btContainer = document.getElementById('bt-panels-container')!;
      BT_PREFIXES.forEach(prefix => {
        const label = document.getElementById(`${prefix}-label`);
        const chev  = document.getElementById(`${prefix}-chevron`);
        const btn   = document.getElementById(`${prefix}-btn`) as HTMLElement | null;
        if (label) label.textContent = 'View Details';
        if (chev)  (chev as HTMLElement).style.transform = '';
        if (btn) {
          btn.style.background = 'transparent';
          btn.style.borderColor = '';
          btn.style.color = btn.getAttribute('data-color') || '';
          btn.style.opacity = '';
        }
        // Return any out-of-place panel back to the shared container
        const panel = document.getElementById(`${prefix}-panel`);
        if (panel && panel.parentElement !== btContainer) btContainer.appendChild(panel);
      });
    }

    function toggleBTPanel(panelId: string) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      const wasHidden = panel.classList.contains('hidden');
      // Close all panels and restore them to the container
      BT_PANELS.forEach(id => document.getElementById(id)?.classList.add('hidden'));
      resetBTButtons();
      if (wasHidden) {
        const isMobile = window.innerWidth < 768;
        if (isMobile) {
          // Move the panel into the card's own column so it appears directly below the card
          const col = document.getElementById(BT_COL_IDS[panelId]);
          if (col) col.appendChild(panel);
        }
        panel.classList.remove('hidden');
        const prefix = panelId.replace('-panel', '');
        const label  = document.getElementById(`${prefix}-label`);
        const chev   = document.getElementById(`${prefix}-chevron`);
        const btn    = document.getElementById(`${prefix}-btn`) as HTMLElement | null;
        if (label) label.textContent = 'Hide Details';
        if (chev)  (chev as HTMLElement).style.transform = 'rotate(180deg)';
        if (btn) {
          const tierColor = btn.getAttribute('data-color') || '';
          btn.style.background = BT_ACTIVE_BG[prefix] || '';
          btn.style.borderColor = tierColor;
          btn.style.color = '#ffffff';
          btn.style.opacity = '1';
        }
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // On resize across breakpoint, close any open panel and return it home
    let _btResizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(_btResizeTimer);
      _btResizeTimer = setTimeout(() => {
        BT_PANELS.forEach(id => {
          const p = document.getElementById(id);
          if (p && !p.classList.contains('hidden')) {
            p.classList.add('hidden');
            resetBTButtons();
          }
        });
      }, 200);
    });

    function openPanel(panelId: string) {
      const panel   = document.getElementById(panelId);
      if (!panel) return;
      panel.classList.remove('hidden');
      const chevron = document.getElementById(`${panelId}-chevron`);
      const label   = document.getElementById(`${panelId}-label`);
      const trigger = document.getElementById(`${panelId}-trigger`);
      const btn     = document.getElementById(`${panelId}-btn`) as HTMLElement | null;
      if (chevron) (chevron as HTMLElement).style.transform = 'rotate(180deg)';
      if (label)   label.textContent = 'Hide Details';
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
      if (btn) {
        const tierColor = btn.getAttribute('data-color') || '';
        const activeBg  = btn.getAttribute('data-active-bg') || '';
        btn.style.background  = activeBg;
        btn.style.borderColor = tierColor;
        btn.style.color       = '#ffffff';
        btn.style.opacity     = '1';
      }
    }

    function closePanel(panelId: string) {
      const panel   = document.getElementById(panelId);
      if (!panel) return;
      panel.classList.add('hidden');
      const chevron = document.getElementById(`${panelId}-chevron`);
      const label   = document.getElementById(`${panelId}-label`);
      const trigger = document.getElementById(`${panelId}-trigger`);
      const btn     = document.getElementById(`${panelId}-btn`) as HTMLElement | null;
      if (chevron) (chevron as HTMLElement).style.transform = '';
      if (label)   label.textContent = 'View Details';
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      if (btn) {
        btn.style.background  = 'transparent';
        btn.style.borderColor = '';
        btn.style.color       = btn.getAttribute('data-color') || '';
        btn.style.opacity     = '';
      }
    }

    function toggleAccordion(panelId: string, groupId: string) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      const wasHidden = panel.classList.contains('hidden');
      (ACCORDION_GROUPS[groupId] ?? []).forEach(id => closePanel(id));
      if (wasHidden) openPanel(panelId);
    }

    // ── Private Lessons: full-width shared panel (desktop) / inline panel (mobile) ──
    const PL_PANELS = ['pl-starter-panel', 'pl-advanced-panel', 'pl-premier-panel'];
    const PL_PREFIXES = ['pl-starter', 'pl-advanced', 'pl-premier'];
    const PL_ACTIVE_BG: Record<string, string> = {
      'pl-starter': 'rgba(15,109,114,0.50)',
      'pl-advanced': 'rgba(11,39,68,0.50)',
      'pl-premier': 'rgba(202,164,103,0.50)',
    };
    const PL_COL_IDS: Record<string, string> = {
      'pl-starter-panel': 'pl-starter-col',
      'pl-advanced-panel': 'pl-advanced-col',
      'pl-premier-panel': 'pl-premier-col',
    };

    function resetPLButtons() {
      const plContainer = document.getElementById('pl-panels-container')!;
      PL_PREFIXES.forEach(prefix => {
        const label = document.getElementById(`${prefix}-label`);
        const chev  = document.getElementById(`${prefix}-chevron`);
        const btn   = document.getElementById(`${prefix}-btn`) as HTMLElement | null;
        if (label) label.textContent = 'View Details';
        if (chev)  (chev as HTMLElement).style.transform = '';
        if (btn) {
          btn.style.background  = 'transparent';
          btn.style.borderColor = '';
          btn.style.color       = btn.getAttribute('data-color') || '';
          btn.style.opacity     = '';
        }
        // Return any out-of-place panel back to the shared container
        const panel = document.getElementById(`${prefix}-panel`);
        if (panel && panel.parentElement !== plContainer) plContainer.appendChild(panel);
      });
    }

    function togglePLPanel(panelId: string) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      const wasHidden = panel.classList.contains('hidden');
      // Close all PL panels and restore them to the container
      PL_PANELS.forEach(id => document.getElementById(id)?.classList.add('hidden'));
      resetPLButtons();
      // If it was closed, open it and update its button
      if (wasHidden) {
        const isMobile = window.innerWidth < 768;
        if (isMobile) {
          // Move the panel into the card's own column so it appears directly below the card
          const col = document.getElementById(PL_COL_IDS[panelId]);
          if (col) col.appendChild(panel);
        }
        panel.classList.remove('hidden');
        const prefix = panelId.replace('-panel', '');
        const label  = document.getElementById(`${prefix}-label`);
        const chev   = document.getElementById(`${prefix}-chevron`);
        const btn    = document.getElementById(`${prefix}-btn`) as HTMLElement | null;
        if (label) label.textContent = 'Hide Details';
        if (chev)  (chev as HTMLElement).style.transform = 'rotate(180deg)';
        if (btn) {
          const tierColor = btn.getAttribute('data-color') || '';
          btn.style.background  = PL_ACTIVE_BG[prefix] || '';
          btn.style.borderColor = tierColor;
          btn.style.color       = '#ffffff';
          btn.style.opacity     = '1';
        }
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // On resize across breakpoint, close any open PL panel and return it home
    let _plResizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(_plResizeTimer);
      _plResizeTimer = setTimeout(() => {
        PL_PANELS.forEach(id => {
          const p = document.getElementById(id);
          if (p && !p.classList.contains('hidden')) {
            p.classList.add('hidden');
            resetPLButtons();
          }
        });
      }, 200);
    });

    // ── FAQ section toggles ──
    function toggleFaqBlock(id: string) {
      const block = document.getElementById(id);
      const chev  = document.getElementById(`${id}-chevron`);
      if (!block || !chev) return;
      const wasHidden = block.classList.toggle('hidden');
      (chev as HTMLElement).style.transform = wasHidden ? '' : 'rotate(180deg)';
    }

    // ── Individual FAQ items ──
    function toggleFaq(id: string) {
      const content = document.getElementById(id);
      const icon    = document.getElementById(`${id}-icon`);
      if (!content || !icon) return;
      const wasHidden = content.classList.toggle('hidden');
      (icon as HTMLElement).style.transform = wasHidden ? '' : 'rotate(45deg)';
    }

    (window as any).toggleAccordion = toggleAccordion;
    (window as any).toggleBTPanel   = toggleBTPanel;
    (window as any).togglePLPanel   = togglePLPanel;
    (window as any).toggleFaqBlock  = toggleFaqBlock;
    (window as any).toggleFaq       = toggleFaq;

    // ── Segmented nav scroll spy + smooth scroll ──
    const navItems   = document.querySelectorAll('.segment-item');
    const sectionIds = ['board-train', 'private-lessons', 'reactivity', 'individual-sessions'];
    const sections   = sectionIds.map(id => document.getElementById(id));

    navItems.forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        const targetId = (item as HTMLAnchorElement).getAttribute('href');
        const el = document.querySelector(targetId!);
        if (el) {
          window.scrollTo({ top: (el as HTMLElement).offsetTop - 120, behavior: 'smooth' });
          navItems.forEach(i => i.classList.remove('active'));
          item.classList.add('active');
          history.pushState(null, '', targetId);
        }
      });
    });

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navItems.forEach(item => {
            item.classList.toggle('active', item.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { root: null, rootMargin: '-20% 0px -70% 0px', threshold: 0 });

    sections.forEach(s => { if (s) observer.observe(s); });
  </script>

</Layout>
