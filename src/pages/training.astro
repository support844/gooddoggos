---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import GuaranteeBadge from "../components/GuaranteeBadge.astro";

// Hero
import heroImage from "../assets/images/oleksandr-horbach-qBnIX-B4n-w-unsplash.jpg";

// Board & Train: one image per card
import coreBTImage from "../assets/images/victor-and-cocoa.png";
import advancedBTImage from "../assets/images/Victor and Tupac at Park Zoomed Out.png";
import eliteBTImage from "../assets/images/victor-cocoa-landscape-mountains.png";

// Private Lessons: one image per card
import starterPLImage from "../assets/images/puppy-teal-harness.png";
import advancedPLImage from "../assets/images/oleksandr-horbach-qBnIX-B4n-w-unsplash.jpg";
import premierPLImage from "../assets/images/victor-happy-walking-pack.png";

// Reactivity: 3 photos for the RDI card
import rdiPhoto2 from "../assets/images/cerberus.png";
import rdiPhoto3 from "../assets/images/david-taffet-DNViTo3BUpk-unsplash.jpg";
import rdiPhoto4 from "../assets/images/sumeet-singh-0JEfPcomlZs-unsplash.jpg";

// Individual Sessions (kept exactly as-is)
import breakthroughStandard from "../assets/images/ben-blumentritt-GbCee6shpx4-unsplash.jpg";
import breakthroughReactive from "../assets/images/andrescarlofotografia-muzzle-5240921_1920.jpg";

// Shared assets
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
import tealPaw from "../assets/images/Paw Prints/Teal Paw Print.png";
import goldPaw from "../assets/images/Paw Prints/Gold Paw Print.png";
import redPaw from "../assets/images/Paw Prints/Red Paw Print.png";
import navyPaw from "../assets/images/Paw Prints/Ink Black Paw Print.png";
---

<style>
  /* ── Segmented Navigation ── */
  .segmented-nav {
    display: flex;
    background: rgba(248, 250, 252, 0.08);
    backdrop-filter: blur(12px);
    border-radius: 100px;
    padding: 6px;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4);
  }
  .segment-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.75);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
  }
  .segment-item[href="#board-train"]:hover,
  .segment-item[href="#board-train"].active {
    background: #0B2744; color: white !important;
    box-shadow: 0 4px 15px rgba(11, 39, 68, 0.45);
  }
  .segment-item[href="#private-lessons"]:hover,
  .segment-item[href="#private-lessons"].active {
    background: #0f6d72; color: white !important;
    box-shadow: 0 4px 15px rgba(15, 109, 114, 0.35);
  }
  .segment-item[href="#reactivity"]:hover,
  .segment-item[href="#reactivity"].active {
    background: #7D2C2D; color: white !important;
    box-shadow: 0 4px 15px rgba(125, 44, 45, 0.40);
  }
  .segment-item[href="#individual-sessions"]:hover,
  .segment-item[href="#individual-sessions"].active {
    background: #d1b27f; color: #0b2744 !important;
    box-shadow: 0 4px 15px rgba(209, 178, 127, 0.35);
  }
  @media (max-width: 768px) {
    .segmented-nav { max-width: 100%; gap: 2px; }
    .segment-item { font-size: 8px; padding: 10px 3px; letter-spacing: 0.06em; }
  }

  /* ── Section divider ── */
  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, #E6DAC6 40%, #E6DAC6 60%, transparent);
  }

  /* ── Panel section labels ── */
  .panel-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(17, 32, 50, 0.38);
    margin-bottom: 10px;
  }

  /* ── Secondary "View Details" toggle ── */
  .view-details-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    border-radius: 9999px;
    border: 1.5px solid currentColor;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    opacity: 0.75;
    font-family: var(--font-heading, 'Poppins', sans-serif);
  }
  .view-details-btn:hover { opacity: 1; }
  .view-details-btn-full {
    width: 100%;
    justify-content: center;
  }

  /* ── Clickable card header (B&T only) ── */
  .card-header { cursor: pointer; }
  .card-header:hover .card-image-col img { transform: scale(1.03); }
  .card-image-col img { transition: transform 0.4s ease; }

  /* ── At-a-glance bullet dot (fallback) ── */
  .glance-dot {
    width: 6px; height: 6px;
    border-radius: 9999px;
    flex-shrink: 0;
    margin-top: 7px;
  }

  /* ── Private Lessons 3-col cards equal height ── */
  .pl-card { display: flex; flex-direction: column; height: 100%; }

  @media (max-width: 767px) {
    .rdi-photo { object-position: center 20% !important; }
    /* Panels containers are hidden on mobile; panels move into card columns via JS */
    #bt-panels-container, #pl-panels-container { display: none !important; }
    /* Let cards size to their own content (no cross-row height stretching) */
    .pl-card { height: auto; }
  }
</style>

<Layout
  title="Dog Training | Good Doggos | Murrieta & Temecula"
  description="Expert dog training in Murrieta and Temecula. Board & Train, Private Lessons, Reactive Dog Intensive, and Individual Sessions. Guaranteed results for every family."
>

  <!-- ════════════════════════════════════════
       HERO: Choose Your Path
  ════════════════════════════════════════ -->
  <section class="relative flex items-end overflow-hidden bg-[#0B2744]" style="min-height: 52vh;">
    <div class="absolute inset-0 z-0">
      <Image src={heroImage} alt="Dog training programs" class="w-full h-full object-cover opacity-50" style="object-position: center 15%;" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-14 pt-[240px] md:pt-[160px]">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-[11px] font-bold tracking-[0.28em] uppercase mb-4" style="color: rgba(209,178,127,0.65);">Dog Training</p>
        <h1 class="text-5xl md:text-6xl font-heading font-bold text-white leading-tight mb-3">Choose Your Path</h1>
        <p class="text-gray-300 mb-8 text-lg">
          For families who want <span class="headline-accent" style="color:#D1B27F;">the best for their dog.</span> We do not just train dogs. We train owners too, so your dog listens better with you, your family, and the people who care for them.
        </p>
        <nav class="segmented-nav" aria-label="Program sections">
          <a href="#board-train" class="segment-item">Board &amp; Train</a>
          <a href="#private-lessons" class="segment-item">Private Lessons</a>
          <a href="#reactivity" class="segment-item">Reactivity</a>
          <a href="#individual-sessions" class="segment-item">Individual Sessions</a>
        </nav>
      </div>
    </div>
  </section>


  <!-- ════════════════════════════════════════
       BOARD & TRAIN
  ════════════════════════════════════════ -->
  <section id="board-train" class="scroll-mt-28 bg-[#FBF1E9] py-12">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">

      <div class="text-center mb-10">
        <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-3" style="color: rgba(15,109,114,0.65);">Residential Training</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3" style="color: #0B2744;">Board &amp; <span class="headline-accent">Train</span></h2>
        <p class="max-w-2xl mx-auto text-base leading-relaxed" style="color: rgba(17,32,50,0.65);">Your dog lives with our trainer and is cared for as part of the household. The fastest path to a reliable foundation, with full owner support built in.</p>
      </div>

      <!-- Three side-by-side B&T cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

        <!-- ── CORE BOARD & TRAIN (Level 1 · Teal) ── -->
        <div id="bt-core-col">
        <div class="pl-card rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_6px_28px_rgba(0,0,0,0.09)]">
          <div class="relative overflow-hidden flex-shrink-0" style="height: 240px;">
            <Image src={coreBTImage} alt="Core Board and Train residential dog training" class="w-full h-full object-cover" style="object-position: center 60%;" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,39,68,0.55) 0%, transparent 60%);"></div>
            <div class="absolute bottom-3 left-3 flex gap-1.5">
              <span class="text-[10px] font-bold tracking-widest uppercase text-white px-2.5 py-1 rounded-full" style="background: rgba(15,109,114,0.88); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">Level 1</span>
              <span class="text-[10px] font-bold tracking-widest uppercase text-white px-2.5 py-1 rounded-full" style="background: rgba(15,109,114,0.88); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">2 Weeks</span>
            </div>
          </div>
          <div class="h-[6px] w-full" style="background: #0F6D72;"></div>
          <div class="flex flex-col flex-1 px-6 py-6">
            <h3 class="text-2xl font-heading font-extrabold mb-1.5" style="color: #0F6D72;">CORE</h3>
            <p class="text-sm leading-relaxed mb-4" style="color: rgba(17,32,50,0.65);">Foundations, leash manners, and everyday structure for dogs starting from scratch.</p>
            <ul class="space-y-2 mb-6">
              {["Foundation reset & basic obedience", "Leash manners, crate & settle routines", "Threshold, door manners & impulse control"].map(s => (
                <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.72);">
                  <Image src={tealPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />{s}
                </li>
              ))}
            </ul>
            <div class="mt-auto space-y-4">
              <div>
                <a href="/apply" class="btn-apply-teal w-full justify-center">
                  Apply for Free Assessment
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                <p class="text-center text-[11px] mt-2" style="color: rgba(17,32,50,0.42);">Availability is limited. Apply today to secure your spot.</p>
              </div>
              <button onclick="toggleBTPanel('bt-core-panel')" id="bt-core-btn" data-color="#0F6D72" class="view-details-btn view-details-btn-full" style="color: #0F6D72;">
                <span id="bt-core-label">View Details</span>
                <svg id="bt-core-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
            </div>
          </div>
        </div>
        </div><!-- /bt-core-col -->

        <!-- ── ADVANCED BOARD & TRAIN (Level 2 · Navy) ── -->
        <div id="bt-advanced-col">
        <div class="pl-card rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_6px_28px_rgba(0,0,0,0.09)]">
          <div class="relative overflow-hidden flex-shrink-0" style="height: 240px;">
            <Image src={advancedBTImage} alt="Advanced Board and Train dog training" class="w-full h-full object-cover" style="object-position: center 50%;" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,39,68,0.55) 0%, transparent 60%);"></div>
            <div class="absolute bottom-3 left-3 flex gap-1.5">
              <span class="text-[10px] font-bold tracking-widest uppercase text-white px-2.5 py-1 rounded-full" style="background: rgba(11,39,68,0.88); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">Level 2</span>
              <span class="text-[10px] font-bold tracking-widest uppercase text-white px-2.5 py-1 rounded-full" style="background: rgba(11,39,68,0.88); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">3 Weeks</span>
            </div>
          </div>
          <div class="h-[6px] w-full" style="background: #0B2744;"></div>
          <div class="flex flex-col flex-1 px-6 py-6">
            <h3 class="text-2xl font-heading font-extrabold mb-1.5" style="color: #0B2744;">PLUS</h3>
            <p class="text-sm leading-relaxed mb-4" style="color: rgba(17,32,50,0.65);">Household manners, place work, and deeper consistency for dogs ready to go further.</p>
            <ul class="space-y-2 mb-6">
              {["Deeper consistency across daily situations", "Place work, greeting & household manners", "Leash reliability in real environments"].map(s => (
                <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.72);">
                  <Image src={navyPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />{s}
                </li>
              ))}
            </ul>
            <div class="mt-auto space-y-4">
              <div>
                <a href="/apply" class="btn-apply-navy w-full justify-center">
                  Apply for Free Assessment
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                <p class="text-center text-[11px] mt-2" style="color: rgba(17,32,50,0.42);">Availability is limited. Apply today to secure your spot.</p>
              </div>
              <button onclick="toggleBTPanel('bt-advanced-panel')" id="bt-advanced-btn" data-color="#0B2744" class="view-details-btn view-details-btn-full" style="color: #0B2744;">
                <span id="bt-advanced-label">View Details</span>
                <svg id="bt-advanced-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
            </div>
          </div>
        </div>
        </div><!-- /bt-advanced-col -->

        <!-- ── ELITE BOARD & TRAIN (Level 3 · Gold) ── -->
        <div class="relative" id="bt-elite-col">
          <!-- "Best Value" corner ribbon -->
          <div class="absolute top-[22px] -right-[30px] z-20 w-[130px] pointer-events-none select-none" style="transform: rotate(45deg);">
            <div class="text-white text-[10px] font-extrabold tracking-[0.16em] uppercase text-center py-[5px] w-full" style="background: #CAA467; box-shadow: 0 2px 6px rgba(0,0,0,0.22), inset 0 1px 0 rgba(255,255,255,0.25);">Best Value</div>
          </div>
        <div class="pl-card rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_6px_28px_rgba(0,0,0,0.09)]">
          <div class="relative overflow-hidden flex-shrink-0" style="height: 240px;">
            <Image src={eliteBTImage} alt="Elite Board and Train advanced dog training" class="w-full h-full object-cover" style="transform: scale(1.8); transform-origin: 50% 86%;" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,39,68,0.55) 0%, transparent 60%);"></div>
            <div class="absolute bottom-3 left-3 flex gap-1.5">
              <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background: rgba(209,178,127,0.90); backdrop-filter: blur(6px); color: #0B2744; border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">Level 3</span>
              <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background: rgba(209,178,127,0.90); backdrop-filter: blur(6px); color: #0B2744; border: 1px solid rgba(255,255,255,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.18);">4 Weeks</span>
            </div>
          </div>
          <div class="h-[6px] w-full" style="background: #D1B27F;"></div>
          <div class="flex flex-col flex-1 px-6 py-6">
            <h3 class="text-2xl font-heading font-extrabold mb-1.5" style="color: #CAA467;">ELITE</h3>
            <p class="text-sm leading-relaxed mb-4" style="color: rgba(17,32,50,0.65);">Advanced reliability, recall foundations, and real-world proofing for the most complete transformation.</p>
            <ul class="space-y-2 mb-6">
              {["Recall foundations & real-world proofing", "Distance, duration & distraction work", "Most advanced residential transformation"].map(s => (
                <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.72);">
                  <Image src={goldPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" widths={[50,100,200]} sizes="16px" />{s}
                </li>
              ))}
            </ul>
            <div class="mt-auto space-y-4">
              <div>
                <a href="/apply" class="btn-apply w-full justify-center">
                  Apply for Free Assessment
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                <p class="text-center text-[11px] mt-2" style="color: rgba(17,32,50,0.42);">Availability is limited. Apply today to secure your spot.</p>
              </div>
              <button onclick="toggleBTPanel('bt-elite-panel')" id="bt-elite-btn" data-color="#CAA467" class="view-details-btn view-details-btn-full" style="color: #CAA467;">
                <span id="bt-elite-label">View Details</span>
                <svg id="bt-elite-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
            </div>
          </div>
        </div>
        </div><!-- /Elite wrapper -->

      </div><!-- /bt cards grid -->

      <!-- Full-width B&T detail panels (one at a time below the row; hidden on mobile via CSS) -->
      <div id="bt-panels-container" class="mt-5">

        <div id="bt-core-panel" class="hidden rounded-2xl border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_16px_rgba(0,0,0,0.07)]">
          <div class="border-t-[3px] rounded-t-2xl" style="border-color: #0F6D72;"></div>
          <div class="px-7 md:px-10 py-8 space-y-6">
            <p class="text-sm leading-relaxed" style="color: rgba(17,32,50,0.72);">Your dog lives with our trainer for 2 weeks, trained and cared for as part of the household. Core is for dogs with no prior structured training, building leash manners, basic obedience, and calm daily structure from the ground up.</p>
            <div class="grid md:grid-cols-2 gap-x-10 gap-y-5">
              <div>
                <span class="panel-label">Training Focus</span>
                <ul class="space-y-2">
                  {["Leash manners and walking structure", "Sit, down, stay, and place foundations", "Crate and settle routines", "Door and threshold manners", "Impulse control and handler focus"].map(s => (
                    <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
                      <Image src={tealPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />{s}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <span class="panel-label">Included Support</span>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style="color:#0F6D72;" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                    Structured owner handoff session at pickup
                  </li>
                  <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style="color:#0F6D72;" viewBox="0 0 20 20" fill="currentColor"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/></svg>
                    1 follow-up private lesson
                  </li>
                  <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" style="color:#0F6D72;" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
                    Regular photo and video updates
                  </li>
                  <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
