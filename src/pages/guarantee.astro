---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/images/high-five.jpg";
---

<Layout>
  <!-- ══════════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
  <section
    class="relative overflow-hidden bg-[#0B2744] flex items-end"
    style="min-height: 46vh;"
  >
    <div class="absolute inset-0 z-0 text-white">
      <Image
        src={heroImage}
        alt="Our Guarantee"
        class="w-full h-full object-cover opacity-50"
        style="object-position: center 35%;"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"
      >
      </div>
    </div>
    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-16 pt-[220px] md:pt-[150px]"
    >
      <div class="flex items-center gap-3 mb-5">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center"
          style="background: rgba(209,178,127,0.15); border: 1px solid rgba(209,178,127,0.30);"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#D1B27F"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
        </div>
        <p
          class="text-[11px] font-bold tracking-[0.28em] uppercase"
          style="color: rgba(209,178,127,0.65);"
        >
          Backed by Our Promise
        </p>
      </div>
      <h1
        class="font-heading font-bold text-white leading-[1.06] mb-4"
        style="font-size: clamp(2.6rem, 5vw, 4rem);"
      >
        Our Guarantee
      </h1>
      <p
        class="headline-accent text-2xl md:text-3xl mb-5"
        style="color: #D1B27F; font-style: italic; font-weight: 700;"
      >
        "Your success is our success."
      </p>
      <p class="text-gray-300 max-w-xl leading-relaxed">
        We stand behind our training with powerful, program-specific guarantees.
        Every program has clearly defined terms — and we honor them without
        hesitation.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
     PROGRAM GUARANTEE CARDS
══════════════════════════════════════════════ -->
  <div class="bg-[#FBF1E9] py-20 px-4">
    <div class="max-w-4xl mx-auto space-y-8">
      <!-- ── BOARD & TRAIN GUARANTEE ── -->
      <div
        id="bt-guarantee"
        class="rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_6px_28px_rgba(0,0,0,0.07)] bg-[#FCF9FA] flex flex-col"
      >
        <div class="h-[6px] w-full" style="background: #0B2744;"></div>
        <div class="p-8 md:p-10">
          <!-- Header -->
          <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
            <div>
              <span
                class="text-[10px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-3 inline-block"
                style="background: rgba(11,39,68,0.07); color: #0B2744; border: 1px solid rgba(11,39,68,0.18);"
                >5-Day Blitz · Board &amp; Train</span
              >
              <h2
                class="text-2xl md:text-3xl font-heading font-bold"
                style="color: #0B2744;"
              >
                Full Satisfaction Guarantee
              </h2>
            </div>
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: rgba(11,39,68,0.08); border: 1.5px solid rgba(11,39,68,0.18);"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0B2744"
                stroke-width="1.8"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
          </div>

          <p class="text-base leading-relaxed mb-8" style="color: rgba(17,32,50,0.72);">
            We're so confident you'll see a real transformation in your dog's behavior during the 5-Day Blitz, we back every stay with a simple promise: if you don't see a noticeable difference in your dog's behavior compared to where they started, you get your money back.
          </p>

          <!-- What We Guarantee callout -->
          <div
            class="rounded-xl p-5 border mb-7"
            style="background: rgba(11,39,68,0.04); border-color: rgba(11,39,68,0.14);"
          >
            <p class="font-bold text-sm mb-2" style="color: #0B2744;">What We Guarantee</p>
            <p class="text-sm leading-relaxed" style="color: rgba(17,32,50,0.78);">
              A visible, noticeable improvement in your dog's behavior by the end of the 5 days — compared to where they started. This could be calmer leash behavior, improved responsiveness to basic cues, better social manners with other dogs, or any agreed-upon behavior we discussed at drop-off. You'll see it on pickup day. Or you get a full refund.
            </p>
          </div>

          <!-- How It Works -->
          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(11,39,68,0.55);"
            >
              How It Works
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Day 1 Baseline",
                    desc: "We note where your dog is starting and agree on the behaviors you most want to see improve.",
                  },
                  {
                    step: "02",
                    title: "5 Days of Work",
                    desc: "Your dog trains, socializes, and bonds with our trainer every day in a structured home environment.",
                  },
                  {
                    step: "03",
                    title: "Pickup Day",
                    desc: "We demonstrate the progress. You see the difference with your own eyes — or you get a full refund.",
                  },
                ].map((s) => (
                  <div
                    class="rounded-xl p-5 border border-[#E6DAC6]"
                    style="background: rgba(11,39,68,0.02);"
                  >
                    <p class="font-heading font-extrabold text-2xl mb-1" style="color: rgba(11,39,68,0.18);">{s.step}</p>
                    <p class="font-bold text-sm mb-1" style="color: #0B2744;">{s.title}</p>
                    <p class="text-xs leading-relaxed" style="color: rgba(17,32,50,0.60);">{s.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Conditions accordion -->
          <div class="rounded-xl border border-[#E6DAC6] overflow-hidden mb-5">
            <button
              class="w-full flex justify-between items-center px-6 py-4 text-left bg-white transition-colors hover:bg-gray-50"
              onclick="toggleGuaranteeFaq('bt-conditions')"
            >
              <span class="font-bold text-sm" style="color: #0B2744;">Conditions Apply — See Full Details</span>
              <svg
                id="bt-conditions-icon"
                class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0B2744"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
            <div
              id="bt-conditions"
              class="hidden px-6 py-4 border-t border-[#E6DAC6]"
              style="background: rgba(11,39,68,0.02);"
            >
              <p class="text-[11px] mb-3 leading-relaxed" style="color: rgba(17,32,50,0.72);">
                This guarantee is built around honest intake and full participation. The following may affect eligibility:
              </p>
              <ul
                class="text-[11px] leading-relaxed space-y-2 list-disc pl-4 mb-4"
                style="color: rgba(17,32,50,0.72);"
              >
                <li>Dog does not complete the full 5-day stay (early pickup without prior agreement)</li>
                <li>Owner withholds or misrepresents behavioral history, bite incidents, medical conditions, or known triggers at drop-off</li>
                <li>A medical or health issue arises during the stay that prevents normal training participation</li>
                <li>Owner refuses the recommended follow-up plan or handoff instructions on pickup day</li>
                <li>The "noticeable difference" claim is assessed against the behaviors agreed upon at intake — not open-ended lifestyle expectations</li>
              </ul>
              <p class="text-[11px] font-medium mb-2" style="color: rgba(11,39,68,0.70);">
                If something comes up during the stay that might affect outcomes, we'll communicate with you promptly and work toward the best path forward.
              </p>
              <p class="text-[10px]" style="color: rgba(17,32,50,0.5);">
                <a href="/terms" class="hover:underline transition-colors">Additional terms of service can be found here.</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── CCC GUARANTEE ── -->
      <div
        id="ccc-guarantee"
        class="rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_6px_28px_rgba(0,0,0,0.07)] bg-[#FCF9FA] flex flex-col"
      >
        <!-- Accent bar -->
        <div class="h-[6px] w-full" style="background: #0F6D72;"></div>
        <div class="p-8 md:p-10">
          <!-- Header -->
          <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
            <div>
              <span
                class="text-[10px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-3 inline-block"
                style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.20);"
                >Calm Companion Challenge</span
              >
              <h2
                class="text-2xl md:text-3xl font-heading font-bold"
                style="color: #0B2744;"
              >
                Win-Your-Money-Back Guarantee
              </h2>
            </div>
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: rgba(15,109,114,0.10); border: 1.5px solid rgba(15,109,114,0.22);"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0F6D72"
                stroke-width="1.8"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
          </div>

          <p
            class="text-base leading-relaxed mb-8"
            style="color: rgba(17,32,50,0.72);"
          >
            If you show up, do the work, and complete every requirement, you
            qualify to earn 100% of your investment back — regardless of
            results. We're so confident the process works, we're willing to PAY
            YOU to follow it.
          </p>

          <!-- How it works -->
          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(15,109,114,0.65);"
            >
              How It Works
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Complete Everything",
                    desc: "Attend all sessions, submit all homework, and actively participate throughout the 4 weeks.",
                  },
                  {
                    step: "02",
                    title: "Document Progress",
                    desc: "Submit your 'before' videos on Day 1 and your 'after' proof at graduation.",
                  },
                  {
                    step: "03",
                    title: "Graduate",
                    desc: "Win 100% of your money back. Guaranteed.",
                  },
                ].map((s) => (
                  <div
                    class="rounded-xl p-5 border border-[#E6DAC6]"
                    style="background: rgba(15,109,114,0.03);"
                  >
                    <p
                      class="font-heading font-extrabold text-2xl mb-1"
                      style="color: rgba(15,109,114,0.25);"
                    >
                      {s.step}
                    </p>
                    <p class="font-bold text-sm mb-1" style="color: #0B2744;">
                      {s.title}
                    </p>
                    <p
                      class="text-xs leading-relaxed"
                      style="color: rgba(17,32,50,0.60);"
                    >
                      {s.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Requirements checklist -->
          <div>
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(15,109,114,0.65);"
            >
              What You Must Complete
            </p>
            <div class="rounded-xl border border-[#E6DAC6] overflow-hidden">
              {
                [
                  {
                    icon: "🎬",
                    label: "Before Day 1",
                    desc: "Submit 'before' videos: your dog walking on leash and performing sit, down, and place.",
                  },
                  {
                    icon: "📅",
                    label: "All 4 Live Group Sessions",
                    desc: "Attend every scheduled session, including weekly check-ins and graduation.",
                  },
                  {
                    icon: "📣",
                    label: "Weekly Progress Post",
                    desc: "Post at least one progress update in the group channel each week.",
                  },
                  {
                    icon: "📋",
                    label: "All Weekly Homework",
                    desc: "Submit practice videos and complete all assigned homework on time, every week.",
                  },
                  {
                    icon: "🙋",
                    label: "Active Participation",
                    desc: "Engage in the community — ask questions, report struggles, receive feedback.",
                  },
                ].map((r, i) => (
                  <div
                    class="flex items-start gap-4 px-6 py-4"
                    style={`border-bottom: 1px solid #E6DAC6; ${
                      i % 2 === 1
                        ? "background: rgba(15,109,114,0.02);"
                        : "background: white;"
                    }`}
                  >
                    <span class="text-lg mt-0.5 flex-shrink-0">{r.icon}</span>
                    <div>
                      <p
                        class="font-bold text-sm mb-0.5"
                        style="color: #0B2744;"
                      >
                        {r.label}
                      </p>
                      <p
                        class="text-xs leading-relaxed"
                        style="color: rgba(17,32,50,0.62);"
                      >
                        {r.desc}
                      </p>
                    </div>
                    <svg
                      class="w-4 h-4 mt-1 ml-auto flex-shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="#0F6D72"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                ))
              }
            </div>

            <!-- New Disqualifying Accordion -->
            <div
              class="mt-4 rounded-xl border border-[#E6DAC6] overflow-hidden"
            >
              <button
                class="w-full flex justify-between items-center px-6 py-4 text-left bg-white transition-colors hover:bg-gray-50"
                onclick="toggleGuaranteeFaq('ccc-disqualify')"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lg flex-shrink-0">⚠️</span>
                  <span class="font-bold text-sm" style="color: #0B2744;"
                    >What would disqualify me?</span
                  >
                </div>
                <svg
                  id="ccc-disqualify-icon"
                  class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="#0F6D72"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4v16m8-8H4"></path>
                </svg>
              </button>
              <div
                id="ccc-disqualify"
                class="hidden px-6 py-4 border-t border-[#E6DAC6]"
                style="background: rgba(15,109,114,0.02);"
              >
                <p
                  class="text-[11px] mb-3 leading-relaxed"
                  style="color: rgba(17,32,50,0.72);"
                >
                  This guarantee is built to reward full participation. The
                  items below may make you ineligible for the
                  win-your-money-back outcome.
                </p>
                <ul
                  class="text-[11px] leading-relaxed space-y-2 list-disc pl-4 mb-4"
                  style="color: rgba(17,32,50,0.72);"
                >
                  <li>
                    Missing required live sessions, check-ins, or graduation
                    without coordinating an approved make-up per policy
                  </li>
                  <li>
                    Not submitting the required baseline ("before") videos on
                    time (or submitting videos that don't meet the required
                    criteria for verification)
                  </li>
                  <li>
                    Not submitting weekly homework / practice videos as
                    required, or repeatedly submitting incomplete work after
                    reminders
                  </li>
                  <li>
                    Refusing or repeatedly failing to follow the program's
                    required management plan during the challenge (handling
                    rules, setup rules, safety protocols)
                  </li>
                  <li>
                    Using training tools or methods that conflict with the
                    program rules during the challenge (e.g., aversive/punitive
                    methods if prohibited), which makes progress and
                    verification unreliable
                  </li>
                  <li>
                    Withholding, minimizing, or misrepresenting key safety
                    information during intake (e.g., bite history,
                    human-directed aggression, severe reactivity, known
                    triggers, legal restrictions)
                  </li>
                  <li>
                    Arriving to sessions without required safety equipment
                    (leash, collar/harness, muzzle if required, etc.) or
                    refusing required handling instructions needed to keep
                    sessions safe
                  </li>
                  <li>
                    Behavior that makes safe participation impossible (e.g.,
                    repeated attempts to bite, uncontrolled aggression at
                    sessions, inability to remain under threshold with the
                    required management tools) if the team determines the
                    current program format is unsafe
                  </li>
                  <li>
                    Violating community standards in a way that disrupts safe
                    participation (harassment, unsafe advice, refusal to follow
                    group rules), including removal from the community space
                  </li>
                  <li>
                    Failing to engage with support when needed (e.g., repeatedly
                    not responding to coach outreach when homework is missing
                    and deadlines pass)
                  </li>
                  <li>
                    Requesting a refund after initiating a chargeback, disputing
                    payments, or engaging in fraudulent behavior (the guarantee
                    is void in these cases)
                  </li>
                  <li>
                    Attempting to transfer participation to another handler/dog,
                    or substantially changing the dog's training environment
                    mid-challenge in a way that prevents consistent verification
                    (unless the coach approves a plan)
                  </li>
                  <li>
                    Not using reasonable veterinary care when a medical issue is
                    clearly impacting training (pain/injury/illness) and
                    continuing without clearance, making results unverifiable
                    and potentially unsafe
                  </li>
                </ul>
                <p
                  class="text-[11px] leading-relaxed mb-3 font-medium"
                  style="color: rgba(15,109,114,0.8);"
                >
                  If something happens that could affect your eligibility
                  (travel, illness, emergencies), tell us as soon as possible.
                  When we can safely do so, we'll help you stay on track with
                  make-ups or an adjusted plan.
                </p>
                <p class="text-[10px]" style="color: rgba(17,32,50,0.5);">
                  <a href="/terms" class="hover:underline transition-colors"
                    >Additional terms of service can be found here.</a
                  >
                </p>
              </div>
            </div>

            <p
              class="text-xs mt-5 text-center font-semibold"
              style="color: rgba(15,109,114,0.70);"
            >
              Complete all five — and if the program doesn't deliver, you don't
              pay.
            </p>
          </div>
        </div>
      </div>

      <!-- ── PRIVATE ACCELERATOR GUARANTEE ── -->
      <div
        id="pa-guarantee"
        class="rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_6px_28px_rgba(0,0,0,0.07)] bg-[#FCF9FA] flex flex-col"
      >
        <div class="h-[6px] w-full" style="background: #D1B27F;"></div>
        <div class="p-8 md:p-10">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
            <div>
              <span
                class="text-[10px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-3 inline-block"
                style="background: rgba(209,178,127,0.12); color: #D1B27F; border: 1px solid rgba(209,178,127,0.28);"
                >Private Accelerator</span
              >
              <h2
                class="text-2xl md:text-3xl font-heading font-bold"
                style="color: #0B2744;"
              >
                Goal-Based Guarantee
              </h2>
            </div>
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: rgba(209,178,127,0.10); border: 1.5px solid rgba(209,178,127,0.25);"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#D1B27F"
                stroke-width="1.8"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
          </div>

          <p
            class="text-base leading-relaxed mb-8"
            style="color: rgba(17,32,50,0.72);"
          >
            This is a focused private program. We pick ONE measurable goal
            together at the start (the "Primary Goal"). We work the full
            advertised program scope AND track the Primary Goal. If you meet the
            requirements and your dog does not hit the Primary Goal by the end
            of the program, you receive a full refund.
          </p>

          <!-- How it works -->
          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(209,178,127,0.8);"
            >
              How It Works
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Define the Goal",
                    desc: "We pick ONE measurable and observable Primary Goal at the start.",
                  },
                  {
                    step: "02",
                    title: "Follow the Plan",
                    desc: "Attend sessions, complete homework, and maintain the management plan.",
                  },
                  {
                    step: "03",
                    title: "Measure & Verify",
                    desc: "We use clear before/after criteria to verify the goal was met.",
                  },
                ].map((s) => (
                  <div
                    class="rounded-xl p-5 border border-[#E6DAC6]"
                    style="background: rgba(209,178,127,0.03);"
                  >
                    <p
                      class="font-heading font-extrabold text-2xl mb-1"
                      style="color: rgba(209,178,127,0.4);"
                    >
                      {s.step}
                    </p>
                    <p class="font-bold text-sm mb-1" style="color: #0B2744;">
                      {s.title}
                    </p>
                    <p
                      class="text-xs leading-relaxed"
                      style="color: rgba(17,32,50,0.60);"
                    >
                      {s.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-3"
              style="color: rgba(209,178,127,0.8);"
            >
              Example Primary Goals
            </p>
            <ul
              class="text-[13px] leading-relaxed list-disc pl-4 space-y-2"
