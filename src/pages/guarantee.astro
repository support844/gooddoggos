---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/images/high-five.jpg";
---

<Layout>
  <!-- ══════════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
  <section
    class="relative overflow-hidden bg-[#0B2744] flex items-end"
    style="min-height: 46vh;"
  >
    <div class="absolute inset-0 z-0 text-white">
      <Image
        src={heroImage}
        alt="Our Guarantee"
        class="w-full h-full object-cover opacity-50"
        style="object-position: center 35%;"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"
      >
      </div>
    </div>
    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-16 pt-[220px] md:pt-[150px]"
    >
      <div class="flex items-center gap-3 mb-5">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center"
          style="background: rgba(209,178,127,0.15); border: 1px solid rgba(209,178,127,0.30);"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#D1B27F"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
        </div>
        <p
          class="text-[11px] font-bold tracking-[0.28em] uppercase"
          style="color: rgba(209,178,127,0.65);"
        >
          Backed by Our Promise
        </p>
      </div>
      <h1
        class="font-heading font-bold text-white leading-[1.06] mb-4"
        style="font-size: clamp(2.6rem, 5vw, 4rem);"
      >
        Our Guarantee
      </h1>
      <p
        class="headline-accent text-2xl md:text-3xl mb-5"
        style="color: #D1B27F; font-style: italic; font-weight: 700;"
      >
        "Your success is our success."
      </p>
      <p class="text-gray-300 max-w-xl leading-relaxed">
        Our Goal-Based Guarantee applies to Board &amp; Train programs and Private Lessons. We define one measurable goal together at the start — and we stand behind it.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
     PROGRAM GUARANTEE CARDS
══════════════════════════════════════════════ -->
  <div class="bg-[#FBF1E9] py-20 px-4">
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- ── BOARD & TRAIN GUARANTEE ── -->
      <div
        id="bt-guarantee"
        class="rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_6px_28px_rgba(0,0,0,0.07)] bg-[#FCF9FA] flex flex-col"
      >
        <div class="h-[6px] w-full" style="background: #0B2744;"></div>
        <div class="p-8 md:p-10">
          <!-- Header -->
          <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
            <div>
              <span
                class="text-[10px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-3 inline-block"
                style="background: rgba(11,39,68,0.07); color: #0B2744; border: 1px solid rgba(11,39,68,0.18);"
                >Board &amp; Train</span
              >
              <h2
                class="text-2xl md:text-3xl font-heading font-bold"
                style="color: #0B2744;"
              >
                Goal-Based Guarantee
              </h2>
            </div>
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: rgba(11,39,68,0.08); border: 1.5px solid rgba(11,39,68,0.18);"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0B2744"
                stroke-width="1.8"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
          </div>

          <p class="text-base leading-relaxed mb-8" style="color: rgba(17,32,50,0.72);">
            We define ONE measurable Primary Goal together at drop-off. Over the stay, your dog trains with our trainer in a structured home environment. On pickup day, we demonstrate progress toward that goal — or you receive a full refund.
          </p>

          <!-- What We Guarantee callout -->
          <div
            class="rounded-xl p-5 border mb-7"
            style="background: rgba(11,39,68,0.04); border-color: rgba(11,39,68,0.14);"
          >
            <p class="font-bold text-sm mb-2" style="color: #0B2744;">What We Guarantee</p>
            <p class="text-sm leading-relaxed" style="color: rgba(17,32,50,0.78);">
              One agreed-upon Primary Goal, documented at drop-off. We measure your dog's progress against that specific, observable goal — not against open-ended expectations. If the goal isn't demonstrably met on pickup day, you get a full refund.
            </p>
          </div>

          <!-- How It Works -->
          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(11,39,68,0.55);"
            >
              How It Works
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Define the Goal",
                    desc: "At drop-off, we pick ONE measurable Primary Goal together and document where your dog is starting.",
                  },
                  {
                    step: "02",
                    title: "Training Stay",
                    desc: "Your dog trains, socializes, and bonds with our trainer every day in a structured home environment.",
                  },
                  {
                    step: "03",
                    title: "Pickup Day",
                    desc: "We demonstrate progress toward the Primary Goal. You see it with your own eyes — or you get a full refund.",
                  },
                ].map((s) => (
                  <div
                    class="rounded-xl p-5 border border-[#E6DAC6]"
                    style="background: rgba(11,39,68,0.02);"
                  >
                    <p class="font-heading font-extrabold text-2xl mb-1" style="color: rgba(11,39,68,0.18);">{s.step}</p>
                    <p class="font-bold text-sm mb-1" style="color: #0B2744;">{s.title}</p>
                    <p class="text-xs leading-relaxed" style="color: rgba(17,32,50,0.60);">{s.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Conditions accordion -->
          <div class="rounded-xl border border-[#E6DAC6] overflow-hidden mb-5">
            <button
              class="w-full flex justify-between items-center px-6 py-4 text-left bg-white transition-colors hover:bg-gray-50"
              onclick="toggleGuaranteeFaq('bt-conditions')"
            >
              <span class="font-bold text-sm" style="color: #0B2744;">Conditions Apply — See Full Details</span>
              <svg
                id="bt-conditions-icon"
                class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0B2744"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
            <div
              id="bt-conditions"
              class="hidden px-6 py-4 border-t border-[#E6DAC6]"
              style="background: rgba(11,39,68,0.02);"
            >
              <p class="text-[11px] mb-3 leading-relaxed" style="color: rgba(17,32,50,0.72);">
                This guarantee is built around honest intake and full participation. The following may affect eligibility:
              </p>
              <ul
                class="text-[11px] leading-relaxed space-y-2 list-disc pl-4 mb-4"
                style="color: rgba(17,32,50,0.72);"
              >
                <li>Dog does not complete the full stay (early pickup without prior agreement)</li>
                <li>Owner withholds or misrepresents behavioral history, bite incidents, medical conditions, or known triggers at drop-off</li>
                <li>A medical or health issue arises during the stay that prevents normal training participation</li>
                <li>Owner refuses the recommended follow-up plan or handoff instructions on pickup day</li>
                <li>The Primary Goal claim is assessed against the goal agreed upon at intake — not open-ended lifestyle expectations</li>
              </ul>
              <p class="text-[11px] font-medium mb-2" style="color: rgba(11,39,68,0.70);">
                If something comes up during the stay that might affect outcomes, we'll communicate with you promptly and work toward the best path forward.
              </p>
              <p class="text-[10px]" style="color: rgba(17,32,50,0.5);">
                <a href="/terms" class="hover:underline transition-colors">Additional terms of service can be found here.</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── PRIVATE LESSONS GUARANTEE ── -->
      <div
        id="pa-guarantee"
        class="rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_6px_28px_rgba(0,0,0,0.07)] bg-[#FCF9FA] flex flex-col"
      >
        <div class="h-[6px] w-full" style="background: #0F6D72;"></div>
        <div class="p-8 md:p-10">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
            <div>
              <span
                class="text-[10px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full mb-3 inline-block"
                style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                >Private Lessons</span
              >
              <h2
                class="text-2xl md:text-3xl font-heading font-bold"
                style="color: #0B2744;"
              >
                Goal-Based Guarantee
              </h2>
            </div>
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: rgba(15,109,114,0.10); border: 1.5px solid rgba(15,109,114,0.22);"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0F6D72"
                stroke-width="1.8"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
          </div>

          <p
            class="text-base leading-relaxed mb-8"
            style="color: rgba(17,32,50,0.72);"
          >
            This is a focused private program. We pick ONE measurable goal
            together at the start (the "Primary Goal"). We work the full
            advertised program scope AND track the Primary Goal. If you meet the
            requirements and your dog does not hit the Primary Goal by the end
            of the program, you receive a full refund.
          </p>

          <!-- How it works -->
          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-4"
              style="color: rgba(15,109,114,0.75);"
            >
              How It Works
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Define the Goal",
                    desc: "We pick ONE measurable and observable Primary Goal at the start.",
                  },
                  {
                    step: "02",
                    title: "Follow the Plan",
                    desc: "Attend sessions, complete homework, and maintain the management plan.",
                  },
                  {
                    step: "03",
                    title: "Measure & Verify",
                    desc: "We use clear before/after criteria to verify the goal was met.",
                  },
                ].map((s) => (
                  <div
                    class="rounded-xl p-5 border border-[#E6DAC6]"
                    style="background: rgba(15,109,114,0.03);"
                  >
                    <p
                      class="font-heading font-extrabold text-2xl mb-1"
                      style="color: rgba(15,109,114,0.30);"
                    >
                      {s.step}
                    </p>
                    <p class="font-bold text-sm mb-1" style="color: #0B2744;">
                      {s.title}
                    </p>
                    <p
                      class="text-xs leading-relaxed"
                      style="color: rgba(17,32,50,0.60);"
                    >
                      {s.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="mb-7">
            <p
              class="text-[11px] font-bold tracking-[0.22em] uppercase mb-3"
              style="color: rgba(15,109,114,0.75);"
            >
              Example Primary Goals
            </p>
            <ul
              class="text-[13px] leading-relaxed list-disc pl-4 space-y-2"
              style="color: rgba(17,32,50,0.72);"
            >
              <li>Walk calmly past other dogs without lunging</li>
              <li>Hold a reliable down-stay in a public setting</li>
              <li>Demonstrate comfortable on-leash exposure to neutral dogs</li>
              <li>Greet unfamiliar people without aggression</li>
              <li>Respond to handler cues under threshold distractions</li>
              <li>
                Achieve agreed-upon threshold distances with measurable
                improvement
              </li>
            </ul>
          </div>

          <!-- Requirements Accordion -->
          <div class="rounded-xl border border-[#E6DAC6] overflow-hidden mb-5">
            <button
              class="w-full flex justify-between items-center px-6 py-4 text-left bg-white transition-colors hover:bg-gray-50"
              onclick="toggleGuaranteeFaq('pa-requirements')"
            >
              <span class="font-bold text-sm" style="color: #0B2744;"
                >Conditions Apply — See Full Details</span
              >
              <svg
                id="pa-requirements-icon"
                class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#0F6D72"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
            <div
              id="pa-requirements"
              class="hidden px-6 py-4 border-t border-[#E6DAC6]"
              style="background: rgba(15,109,114,0.02);"
            >
              <ul
                class="text-[11px] leading-relaxed space-y-2 list-disc pl-4 mb-4"
                style="color: rgba(17,32,50,0.72);"
              >
                <li>Missing sessions without approved reschedule window</li>
                <li>
                  Not completing assigned reps/homework required to measure the
                  goal
                </li>
                <li>
                  Not using required management/safety equipment (e.g., leash,
                  long line, muzzle if recommended/required)
                </li>
                <li>
                  Withholding bite history, aggression incidents, or other
                  material intake details that change the plan/safety profile
                </li>
                <li>
                  Safety rule violations that prevent safe training sessions
                  (for people, dogs, staff, or the public)
                </li>
                <li>
                  Using tools or methods that directly conflict with the
                  training plan/safety protocol during the program (if
                  applicable)
                </li>
                <li>
                  Major medical/medication/health changes that materially affect
                  behavior not disclosed during the program (if relevant)
                </li>
                <li>
                  Any conduct that prevents completing sessions safely (e.g.,
                  repeated no-shows, hostile behavior, unsafe handling)
                </li>
              </ul>
              <p
                class="text-[11px] font-medium"
                style="color: rgba(15,109,114,0.80);"
              >
                If you have questions about eligibility, contact us before your
                first session.
              </p>
              <p class="text-[10px] mt-2" style="color: rgba(17,32,50,0.5);">
                <a href="/terms" class="hover:underline transition-colors"
                  >Additional terms of service can be found here.</a
                >
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════════════════════
     FAQ ACCORDION
══════════════════════════════════════════════ -->
  <div class="bg-[#112032] py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <p
          class="text-[11px] font-bold tracking-[0.25em] uppercase mb-3"
          style="color: rgba(209,178,127,0.55);"
        >
          Common Questions
        </p>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-white">
          Guarantee FAQ
        </h2>
      </div>

      <div class="space-y-2">
        {
          [
            {
              q: "What counts as \"completing the requirements\"?",
              a: "Each program has specific attendance, homework, and safety requirements to ensure we can accurately measure progress safely. Please check the \"Conditions Apply\" section under your specific program above for the exact details.",
            },
            {
              q: "What happens if I miss a session?",
              a: "Consistent participation is key to our guarantee. While life happens, missing sessions without an approved reschedule may void your coverage. Always communicate with us as early as possible if an emergency arises.",
            },
            {
              q: "Can the Primary Goal change mid-program?",
              a: "Yes. If your priorities or your dog's needs change significantly, we can adjust together. Any mutually agreed-upon changes to the Primary Goal will be documented and the guarantee applies to those updated baselines.",
            },
            {
              q: "Does the guarantee apply to Individual Sessions or the Reactive Dog Intensive?",
              a: "The Goal-Based Guarantee is designed for structured, multi-session programs where we can set a clear goal, build toward it over time, and measure the outcome. Individual Sessions are great for targeted skills or a one-time check-in, but a single session doesn't give us the runway to set and track a meaningful goal. The Reactive Dog Intensive involves complex, layered behavior that depends heavily on variables outside of our sessions — progress is real, but it unfolds differently than a single trackable goal allows for. In both cases, we still show up fully committed to helping your dog. The guarantee structure just doesn't fit how these programs work.",
            },
            {
              q: "What could disqualify me?",
              a: "Generally, failing to follow the safety plan, withholding critical behavior history (like bite incidents), or repeatedly not completing the required work will void coverage. See the \"Conditions Apply\" section under your program above for the full list.",
            },
          ].map((faq, i) => (
            <div class="rounded-xl overflow-hidden border border-white/10">
              <button
                class="w-full flex justify-between items-center px-6 py-4 text-left"
                onclick={`toggleGuaranteeFaq('gfaq-${i}')`}
                style="background: rgba(255,255,255,0.04);"
              >
                <span class="text-sm font-medium text-white pr-4">{faq.q}</span>
                <svg
                  id={`gfaq-${i}-icon`}
                  class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="#D1B27F"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4v16m8-8H4"
                  />
                </svg>
              </button>
              <div
                id={`gfaq-${i}`}
                class="hidden px-6 pb-4"
                style="background: rgba(255,255,255,0.02);"
              >
                <p
                  class="text-sm leading-relaxed"
                  style="color: rgba(255,255,255,0.55);"
                >
                  {faq.a}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
     FINAL CTA
══════════════════════════════════════════════ -->
  <div class="relative overflow-hidden bg-[#FBF1E9]">
    <div
      class="w-full h-[3px]"
      style="background: linear-gradient(to right, #0B2744, #D1B27F);"
    >
    </div>
    <div class="max-w-4xl mx-auto px-4 py-20 md:py-24 text-center">
      <p
        class="text-[11px] font-bold tracking-[0.25em] uppercase mb-4"
        style="color: rgba(15,109,114,0.60);"
      >
        Zero Risk. Real Results.
      </p>
      <h2
        class="text-3xl md:text-4xl font-heading font-bold mb-4"
        style="color: #0B2744;"
      >
        Ready to Get Started?<br />
        <span
          class="headline-accent"
          style="color: #D1B27F; font-style: italic; font-weight: 700;"
          >We've Got You Covered.</span
        >
      </h2>
      <p
        class="text-base mb-10 max-w-lg mx-auto"
        style="color: rgba(17,32,50,0.60);"
      >
        Board &amp; Train and Private Lessons both come with our Goal-Based Guarantee. Start with a free behavioral assessment and we'll find the right fit for your dog.
      </p>
      <a
        href="/apply"
        class="inline-flex items-center justify-center gap-2 font-bold text-sm tracking-widest uppercase rounded-full transition-all duration-200 hover:-translate-y-0.5"
        style="background: #D1B27F; color: #0B2744; padding: 18px 44px; box-shadow: 0 6px 24px rgba(209,178,127,0.35);"
      >
        Apply for Free Behavioral Assessment →
      </a>
      <div class="mt-5">
        <a
          href="tel:951-401-6252"
          class="text-xs transition-colors"
          style="color: rgba(17,32,50,0.45); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(17,32,50,0.20);"
          >Have questions? Contact us.</a
        >
      </div>
    </div>
  </div>
</Layout>

<script>
  function toggleGuaranteeFaq(id: string) {
    const el = document.getElementById(id);
    const icon = document.getElementById(`${id}-icon`);
    if (!el || !icon) return;
    const hidden = el.classList.toggle("hidden");
    (icon as HTMLElement).style.transform = hidden ? "" : "rotate(45deg)";
  }
  (window as any).toggleGuaranteeFaq = toggleGuaranteeFaq;
</script>
