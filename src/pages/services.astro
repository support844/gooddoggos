  <script>
    function toggleFaqBlock(id: string) {
      const block = document.getElementById(id);
      const chev = document.getElementById(`${id}-chevron`);
      if (!block || !chev) return;
      const wasHidden = block.classList.toggle("hidden");
      (chev as HTMLElement).style.transform = wasHidden ? "" : "rotate(180deg)";
    }
    function toggleFaq(id: string) {
      const content = document.getElementById(id);
      const icon = document.getElementById(`${id}-icon`);
      if (!content || !icon) return;
      const wasHidden = content.classList.toggle("hidden");
      (icon as HTMLElement).style.transform = wasHidden ? "" : "rotate(45deg)";
    }
    (window as any).toggleFaqBlock = toggleFaqBlock;
    (window as any).toggleFaq = toggleFaq;

    // Smooth scroll + active state for segmented nav
    const navItems = document.querySelectorAll('.segment-item');
    navItems.forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (item as HTMLAnchorElement).getAttribute('href');
        const el = document.querySelector(href!);
        if (el) {
          window.scrollTo({ top: (el as HTMLElement).offsetTop - 80, behavior: 'smooth' });
          navItems.forEach(i => i.classList.remove('active'));
          item.classList.add('active');
        }
      });
    });

    // Scroll spy
    const sections = ['dog-walking','pet-sitting'].map(id => document.getElementById(id));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navItems.forEach(item => {
            item.classList.toggle('active', item.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => { if (s) observer.observe(s); });
  </script>
