---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

// Asset Imports
import heroImage from "../assets/images/joe-caione-qO-PIF84Vxg-unsplash.jpg";
import standardWalking from "../assets/images/christian-testa-kqLl6Ao7V4k-unsplash.jpg";
import reactiveWalking from "../assets/images/sumeet-singh-0JEfPcomlZs-unsplash.jpg";
import standardSitting from "../assets/images/jamie-street-s9Tf1eBDFqw-unsplash.jpg";
import reactiveSitting from "../assets/images/andrescarlofotografia-muzzle-5240921_1920.jpg";
import bottomCtaImage from "../assets/images/samantha-fortney-u3nTreADKH8-unsplash.jpg";
import tealPaw from "../assets/images/Paw Prints/Teal Paw Print.png";
import redPaw from "../assets/images/Paw Prints/Red Paw Print.png";
import goldPaw from "../assets/images/Paw Prints/Gold Paw Print.png";
import logoWhite from "../assets/images/Brand-Name-Logo---White---Good-Doggos.png";
import membershipImage from "../assets/images/diana-parkhouse-e2YwwTG-viI-unsplash.jpg";
---

<style>
  /* ─── Segmented Navigation ─── */
  .segmented-nav {
    display: flex;
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(12px);
    border-radius: 100px;
    padding: 5px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .segment-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.7);
    transition: all 0.3s ease;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .segment-item:hover,
  .segment-item.active {
    color: #FFFFFF !important;
  }
  .segment-item[href="#dog-walking"]:hover,
  .segment-item[href="#dog-walking"].active {
    background: #0F6D7F;
  }
  .segment-item[href="#pet-sitting"]:hover,
  .segment-item[href="#pet-sitting"].active {
    background: #D1B27F;
  }

  /* ─── Paw Bullet ─── */
  .paw-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: #374151;
    line-height: 1.5;
  }
  .bullet-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ─── Service Card ─── */
  .service-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #EEE6D9;
    box-shadow: 0 8px 24px rgba(11,39,68,0.06), 0 2px 6px rgba(11,39,68,0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(11,39,68,0.10), 0 4px 10px rgba(11,39,68,0.06);
  }

  /* ─── Details / Dropdown ─── */
  details summary {
    list-style: none;
    cursor: pointer;
  }
  details summary::-webkit-details-marker { display: none; }
  details[open] summary .chevron {
    transform: rotate(180deg);
  }
  .chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  /* ─── Color accents ─── */
  .accent-teal  { color: #0F6D7F; }
  .accent-gold  { color: #D1B27F; }
  .accent-red   { color: #7D2C2D; }
  .accent-navy  { color: #0B2744; }

  .bg-teal-soft { background: rgba(15,109,127,0.06); border-color: rgba(15,109,127,0.18); }
  .bg-gold-soft { background: rgba(177,144,74,0.07); border-color: rgba(177,144,74,0.18); }
  .bg-red-soft  { background: rgba(125,44,45,0.06);  border-color: rgba(125,44,45,0.16); }

  /* ─── Card Pills — solid, readable, polished ─── */
  .badge-teal {
    background: rgba(15,109,127,0.88);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.22);
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    backdrop-filter: blur(4px);
  }
  .badge-gold {
    background: rgba(177,144,74,0.88);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.22);
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    backdrop-filter: blur(4px);
  }
  .badge-red {
    background: rgba(125,44,45,0.88);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.22);
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    backdrop-filter: blur(4px);
  }

  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, #E6DAC6 40%, #E6DAC6 60%, transparent);
  }
</style>

<Layout title="Support Services | Good Doggos">
  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-[#0B2744]" style="min-height: 52vh; display:flex; align-items:flex-end;">
    <div class="absolute inset-0 z-0 text-white">
      <Image
        src={heroImage}
        alt="Support Services — Good Doggos"
        class="w-full h-full object-cover opacity-65"
        style="object-position: center 40%;"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/45 via-[#0B2744]/25 to-[#0B2744]/65"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-5 md:px-10 pb-12 pt-[220px] md:pt-[140px]">
      <div class="max-w-xl">
        <p class="text-[10px] font-bold tracking-[0.3em] uppercase mb-3" style="color:rgba(209,178,127,0.75);">Premium Care + Dog Training</p>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-white leading-tight mb-4">Support Services</h1>
        <p class="text-gray-300 text-base md:text-lg leading-relaxed mb-8 max-w-md">
          Unlike other dog walking or pet sitting services, <span class="headline-accent">we train your dogs too.</span> Every visit is a structured session designed to maintain neutrality and reinforce professional standards.
        </p>
        <nav class="segmented-nav" style="max-width:320px;">
          <a href="#dog-walking" class="segment-item">Dog Walking</a>
          <a href="#pet-sitting" class="segment-item">Pet Sitting</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       POSITIONING STRIP
  ══════════════════════════════════════ -->
  <div class="bg-[#0B2744] border-t border-white/5">
    <div class="max-w-7xl mx-auto px-5 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/10">

        <div class="flex items-start gap-4 py-6 md:pr-8">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(15,109,127,0.25);">
            <svg class="w-4 h-4 text-[#5BB8C9]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-white text-sm">Dog Walking</p>
            <p class="text-gray-400 text-xs mt-0.5 leading-snug">Structured walks with light training, leash reinforcement, and real-world exposure reps.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 py-6 md:px-8">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(177,144,74,0.22);">
            <svg class="w-4 h-4" style="color:#D1B27F;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-white text-sm">Pet Sitting</p>
            <p class="text-gray-400 text-xs mt-0.5 leading-snug">In-home care with training built in to reinforce routines, structure, and boundaries.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 py-6 md:pl-8">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(11,39,68,0.5); border:1px solid rgba(255,255,255,0.12);">
            <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-white text-sm">Need deeper behavior work?</p>
            <p class="text-gray-400 text-xs mt-0.5 leading-snug">Support services help maintain training or provide a lighter entry point. <a href="/programs" class="underline text-[#D1B27F] hover:text-white transition-colors">Training Programs</a> are for deeper transformation.</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       GENERAL SUPPORT SERVICES FAQ
  ══════════════════════════════════════ -->
  <div class="bg-[#F8F4EF] pt-10 pb-2">
    <div class="max-w-7xl mx-auto px-5 md:px-10">
      <div class="rounded-xl overflow-hidden border border-[#E6DAC6]/50">
        <button
          onclick="toggleFaqBlock('gen-faqs')"
          class="w-full flex items-center justify-between px-6 py-4 bg-white text-left"
        >
          <span
            class="text-xs font-bold tracking-widest uppercase"
            style="color:rgba(17,32,50,0.42);">General Support Services FAQs (6)</span
          >
          <svg
            id="gen-faqs-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#0B2744"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="gen-faqs" class="hidden">
          {
            [
              {
                q: "What makes Good Doggos support services different from regular dog walking or pet sitting?",
                a: "Our support services are built to do more than cover care. Each visit is structured to reinforce calm behavior, routines, leash manners, and household expectations, so your dog is practicing better habits while you get help.",
              },
              {
                q: 'What does "+ training" mean in these services?',
                a: "It means we reinforce the standards your dog is learning, not just supervise them. Depending on the service, that may include leash structure, calm exits, boundaries around doors, settling, crate routine, place work, engagement, and everyday manners.",
              },
              {
                q: "Do I need to schedule a consultation before booking?",
                a: "Yes. All new support service clients begin with a free consultation so we can meet your dog, understand behavior and handling needs, and make sure we place you in the right service tier. Because of this, we typically cannot accept last-minute first-time bookings.",
              },
              {
                q: "Are these services only for existing Good Doggos training clients?",
                a: "No. New clients are welcome. We simply require a consultation first so we can make sure the service is a safe and appropriate fit for your dog.",
              },
              {
                q: "Who are support services best for?",
                a: "Support services are a fit for several kinds of dogs and owners. Some clients use them to maintain progress after training. Others use them as a structured starting point because their dog has never had formal training before. They can also be a great fit for busy owners who want help reinforcing better habits, or for families who are interested in a Good Doggos program and want to start with a lower-commitment service first.",
              },
              {
                q: "How do I know whether my dog needs the standard tier or the reactive/aggressive tier?",
                a: "The standard tier is for dogs who can be handled safely in normal everyday situations. The reactive/aggressive tier is for dogs with more serious behavior concerns, such as lunging, intense reactivity, stranger danger, handling sensitivity, or bite history. We will help place you in the correct tier during your consultation.",
              },
            ].map((faq, i) => (
              <div class="border-t border-[#E6DAC6]/50 bg-white">
                <button
                  class="w-full flex justify-between items-center px-6 py-4 text-left"
                  onclick={`toggleFaq('gen-q${i}')`}
                >
                  <span class="text-sm font-medium pr-4" style="color:#112032;">
                    {faq.q}
                  </span>
                  <svg
                    id={`gen-q${i}-icon`}
                    class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="#0B2744"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                </button>
                <div id={`gen-q${i}`} class="hidden px-6 pb-4">
                  <p
                    class="text-sm leading-relaxed"
                    style="color:rgba(17,32,50,0.65);"
                  >
                    {faq.a}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       DOG WALKING
  ══════════════════════════════════════ -->
  <section id="dog-walking" class="bg-[#F8F4EF] py-16 md:py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-5 md:px-10">

      <div class="mb-10">
        <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#0B2744]/40 mb-1">Service Category</p>
        <h2 class="text-3xl font-heading font-bold text-[#0B2744] mb-3">Dog Walking + Training</h2>
        <p class="text-sm text-[#0B2744]/60 max-w-xl leading-relaxed">A rare hybrid of structured exercise and real-world training, built for dogs who need more than a casual walk. We use the walk itself as a chance to reinforce better behavior where it counts most.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">

        <!-- ── Standard Walking ── -->
        <div class="service-card">
          <div class="relative" style="height:200px; overflow:hidden;">
            <Image src={standardWalking} alt="Standard Dog Walking" class="w-full h-full object-cover" style="object-position: center 30%;" />
            <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(11,39,68,0.45) 0%, transparent 60%);"></div>
            <span class="absolute bottom-3 left-4 text-[9px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full badge-teal">Tier 1: Standard</span>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <!-- Title row -->
            <div class="flex justify-between items-start mb-1">
              <h3 class="text-xl font-heading font-bold text-[#0B2744]">Standard Walking</h3>
              <span class="text-base font-bold accent-teal ml-3 whitespace-nowrap">$50/hr</span>
            </div>
            <p class="text-[13px] accent-teal font-semibold mb-4">Leash reinforcement + calm focus on every walk.</p>

            <!-- Bullets -->
            <ul class="space-y-2.5 mb-5">
              {[
                "Loose-leash reinforcement reps",
                "Calm entry and exit rituals",
                "Neutrality around distractions",
                "GPS route tracking + session photo",
              ].map(b => (
                <li class="paw-bullet">
                  <span class="bullet-icon">
                    <Image src={tealPaw} alt="" width="14" height="14" />
                  </span>
                  {b}
                </li>
              ))}
            </ul>

            <!-- Dropdown -->
            <details class="mb-4">
              <summary class="flex items-center justify-between text-[11px] font-bold tracking-[0.15em] uppercase text-[#0B2744]/60 hover:text-[#0F6D7F] transition-colors py-2 border-t border-[#EEE6D9]">
                <span>View details</span>
                <svg class="chevron w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="pt-3 pb-1">
                <p class="text-[13.5px] text-gray-600 leading-relaxed mb-4">
                  This is more than a walk around the block. Each session is structured to reinforce leash manners, engagement, and calm behavior in the real world. Whether your dog is maintaining progress from formal training or just starting to build better habits, each session is structured and intentional. Trust us. You'll notice the difference.
                </p>
                <!-- Best for moved inside dropdown -->
                <div class="rounded-xl p-4 bg-teal-soft border">
                  <p class="text-[9px] font-extrabold tracking-[0.2em] uppercase accent-teal mb-1">Best For</p>
                  <p class="text-[13px] font-semibold text-[#0B2744]/80">Well-adjusted dogs needing regular exercise with consistent structure.</p>
                </div>
              </div>
            </details>

            <a href="/apply" class="inline-flex items-center justify-center gap-2 w-full text-[11px] font-bold tracking-[0.18em] uppercase rounded-full py-4 transition-all duration-300 hover:-translate-y-0.5" style="background:#0B2744; color:#fff; box-shadow: 0 6px 16px rgba(11,39,68,0.18);">
              Request Booking
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

        <!-- ── Reactive Walking ── -->
        <div class="service-card">
          <div class="relative" style="height:200px; overflow:hidden;">
            <Image src={reactiveWalking} alt="Reactive Dog Walking" class="w-full h-full object-cover" style="object-position: center 30%;" />
            <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(11,39,68,0.50) 0%, transparent 60%);"></div>
            <span class="absolute bottom-3 left-4 text-[9px] font-bold tracking-widest uppercase px-3 py-1.5 rounded-full badge-red">Tier 2: Specialized</span>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex justify-between items-start mb-1">
              <h3 class="text-xl font-heading font-bold text-[#0B2744]">Reactive / Aggressive</h3>
              <span class="text-base font-bold accent-red ml-3 whitespace-nowrap">$80/hr</span>
            </div>
            <p class="text-[13px] accent-red font-semibold mb-4">Expert-level handling for high-stakes walks.</p>

            <ul class="space-y-2.5 mb-5">
              {[
                "Advanced leash mechanics and body positioning",
                "Strategic routing for threshold management",
                "Counter-conditioning reps on route",
                "Zero-contact protocols enforced",
              ].map(b => (
                <li class="paw-bullet">
                  <span class="bullet-icon">
                    <Image src={redPaw} alt="" width="14" height="14" />
                  </span>
                  {b}
                </li>
              ))}
            </ul>

            <details class="mb-4">
              <summary class="flex items-center justify-between text-[11px] font-bold tracking-[0.15em] uppercase text-[#0B2744]/60 hover:text-[#7D2C2D] transition-colors py-2 border-t border-[#EEE6D9]">
                <span>View details</span>
                <svg class="chevron w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="pt-3 pb-1">
                <p class="text-[13.5px] text-gray-600 leading-relaxed mb-4">
                  Most walkers are intimidated by reactive dogs. We LOVE working with them, and we believe they're capable of real change. Every walk includes threshold management, counter-conditioning reps, and calm-behavior practice designed to create better patterns over time. Whether your dog is maintaining existing training or getting structured exposure for the first time, our handlers know how to challenge them productively without pushing them past threshold.
                </p>
                <!-- Best for moved inside dropdown -->
                <div class="rounded-xl p-4 bg-red-soft border">
                  <p class="text-[9px] font-extrabold tracking-[0.2em] uppercase accent-red mb-1">Best For</p>
                  <p class="text-[13px] font-semibold text-[#0B2744]/80">Reactive, leash-aggressive, or high-drive dogs that need expert management on every walk.</p>
                </div>
              </div>
            </details>

            <a href="/apply" class="inline-flex items-center justify-center gap-2 w-full text-[11px] font-bold tracking-[0.18em] uppercase rounded-full py-4 transition-all duration-300 hover:-translate-y-0.5" style="background:#0B2744; color:#fff; box-shadow: 0 6px 16px rgba(11,39,68,0.18);">
              Request Booking
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- FAQ: DOG WALKING -->
      <div class="mt-10 rounded-xl overflow-hidden border border-[#E6DAC6]/50">
        <button
          onclick="toggleFaqBlock('dw-faqs')"
          class="w-full flex items-center justify-between px-6 py-4 bg-white text-left"
        >
          <span
            class="text-xs font-bold tracking-widest uppercase"
            style="color:rgba(17,32,50,0.42);">Dog Walking FAQs (5)</span
          >
          <svg
            id="dw-faqs-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#0F8992"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="dw-faqs" class="hidden">
          {
            [
              {
                q: "What is included in Dog Walking + Training?",
                a: "Dog Walking + Training includes a structured walk with built-in reinforcement of better behavior. We focus on calm leash handling, engagement, walking manners, and real-world exposure so your dog is practicing useful skills during every outing.",
              },
              {
                q: "Is this a good fit for dogs that pull, bark, lunge, or get overstimulated on walks?",
                a: "Absolutely. Dogs who struggle with arousal, pulling, barking, or leash frustration often benefit from more structured handling. Dogs with more serious behavior issues may need the reactive/aggressive tier so we can approach the walk with the right level of caution and skill.",
              },
              {
                q: "Will this still help if my dog has never had formal training before?",
                a: "Yes. Dog Walking + Training can be helpful for dogs who already have training, but it can also be a strong starting point for dogs who need more structure and better habits in everyday life. For busy owners, it can also provide helpful consistency while deciding whether a fuller training program is the right next step.",
              },
              {
                q: "Will you reinforce my dog's existing commands, structure, and walking tools?",
                a: "Yes. We aim to keep handling consistent and reinforce the structure your dog already knows, as long as it is safe and appropriate. That way, your dog gets clearer repetition instead of mixed messages.",
              },
              {
                q: "Are walks done solo or with other dogs?",
                a: "Support walks are planned based on your dog's needs and safety. For many dogs, especially those working on behavior, solo handling is the best fit. We will discuss what is most appropriate during your consultation.",
              },
            ].map((faq, i) => (
              <div class="border-t border-[#E6DAC6]/50 bg-white">
                <button
