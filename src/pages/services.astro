          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BOTTOM CTA — Bridge to Programs
  ══════════════════════════════════════ -->
  <section class="relative min-h-[520px] md:min-h-[640px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0 text-white">
      <Image src={bottomCtaImage} alt="" class="w-full h-full object-cover object-center" />
      <!-- Cinematic overlay: heavy navy on left fading toward photo on right -->
      <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(11,39,68,0.92) 0%, rgba(11,39,68,0.75) 35%, rgba(11,39,68,0.40) 62%, rgba(11,39,68,0.10) 100%);"></div>
      <!-- Subtle bottom grounding -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B2744]/40 via-transparent to-transparent"></div>
    </div>

    <!-- Watermark Logo -->
    <div class="absolute right-0 bottom-0 top-0 z-10 flex items-end justify-end pr-8 pb-8 md:pr-16 md:pb-12 pointer-events-none select-none">
      <Image src={logoWhite} alt="" aria-hidden="true" class="w-48 md:w-72 h-auto opacity-[0.08] object-contain" />
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 md:px-8 lg:px-12 py-20 w-full">
      <div class="max-w-xl">
        <!-- Pill -->
        <div class="inline-flex items-center gap-2 mb-7">
          <span class="text-[11px] font-bold tracking-[0.22em] uppercase px-4 py-2 rounded-full border border-[#D1B27F]/60 text-[#D1B27F]" style="background: rgba(209,178,127,0.12);">
            Training Programs
          </span>
        </div>

        <!-- Headline -->
        <h2 class="font-heading font-bold text-white leading-[1.08] mb-6">
          <span class="block text-4xl md:text-6xl lg:text-7xl">Looking for Real</span>
          <span class="headline-accent block text-4xl md:text-6xl lg:text-7xl mt-1">Behavior Change?</span>
        </h2>

        <!-- Body -->
        <p class="text-gray-300 text-lg leading-relaxed mb-10 max-w-md">
          Support services help maintain structure, reinforce progress, or offer a lighter entry into training. If your dog needs deeper structure, obedience, or behavior work, start with our training programs.
        </p>

        <!-- CTA Button -->
        <a href="/programs" class="btn-apply">
          Explore Training Programs
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    // Smooth scroll + active state for segmented nav
    const navItems = document.querySelectorAll('.segment-item');
    navItems.forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (item as HTMLAnchorElement).getAttribute('href');
        const el = document.querySelector(href!);
        if (el) {
          window.scrollTo({ top: (el as HTMLElement).offsetTop - 80, behavior: 'smooth' });
          navItems.forEach(i => i.classList.remove('active'));
          item.classList.add('active');
        }
      });
    });

    // Scroll spy
    const sections = ['dog-walking','pet-sitting'].map(id => document.getElementById(id));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navItems.forEach(item => {
            item.classList.toggle('active', item.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => { if (s) observer.observe(s); });
  </script>
</Layout>
