---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';

// Asset Imports
import summerImage from "../assets/images/lukas-vanatko-M7_cpdicN44-unsplash.jpg";
import eligibilityImage from "../assets/images/ben-moreland-ISy9WVUXduw-unsplash.jpg";
import journeyImage from "../assets/images/jametlene-reskp-fliwkBbS7oM-unsplash.jpg";
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
import heroImage from "../assets/images/pauline-loroy-U3aF7hgUSrk-unsplash.jpg";
import ctaImage from "../assets/images/pauline-loroy-U3aF7hgUSrk-unsplash.jpg";
---

<Layout>

<!-- ══════════════════════════════════════════════
     A) CINEMATIC HERO
══════════════════════════════════════════════ -->
<section class="relative overflow-hidden bg-[#0B2744] flex items-end" style="min-height: 90vh;">
  <div class="absolute inset-0 z-0">
    <Image src={heroImage} alt="Dog training" class="absolute inset-0 w-full h-full object-cover object-center" widths={[800, 1200, 1920]} sizes="100vw" loading="eager" />
    <!-- Cinematic overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-20 md:pb-28" style="padding-top: 180px;">
    <!-- Kicker pill -->
    <div class="mb-7">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-[11px] font-semibold tracking-[0.20em] uppercase"
            style="background: rgba(0,0,0,0.18); border: 1px solid #D1B27F; color: #D1B27F; backdrop-filter: blur(6px);">
        <span style="width:5px; height:5px; border-radius:50%; background:#D1B27F; display:inline-block;"></span>
        Accepting <span id="ccc-next-month">March 2026</span> Applicants
      </span>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-end">
      <!-- Left: Headline + CTAs -->
      <div>
        <h1 class="font-heading font-bold text-white leading-[1.06] mb-6" style="font-size: clamp(2.6rem, 5vw, 4.2rem);">
          The Only Dog Training Program<br />
          That <span class="headline-accent" style="color: #D1B27F;">Pays You</span> to Get Results
        </h1>
        <p class="text-lg text-gray-300 leading-relaxed mb-10 max-w-lg">
          Our signature challenge transforms your dog's behavior in just 4 weeks. Complete every challenge requirement and win 100% of your money back.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 flex-wrap">
          <a href="/apply"
             class="btn-apply-teal">
            Apply for Free Behavioral Assessment
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a href="#fit" data-slide-to="1"
             class="inline-flex items-center justify-center font-bold text-[13px] tracking-wide rounded-full transition-all duration-200 whitespace-nowrap flex-shrink-0"
             style="border: 1px solid rgba(255,255,255,0.25); color: white; padding: 14px 26px; background: rgba(255,255,255,0.06);">
            See if You're a Fit ↓
          </a>
        </div>
      </div>

      <!-- Right: Quick stats card -->
      <div class="hidden md:block">
        <div class="rounded-2xl p-7 border" style="background: rgba(252,249,250,0.07); border-color: rgba(255,255,255,0.12); backdrop-filter: blur(10px);">
          <div class="grid grid-cols-2 gap-5">
            {[
              {stat: "4", label: "Weeks"},
              {stat: "$799", label: "Investment"},
              {stat: "100%", label: "Money Back"},
              {stat: "∞", label: "Results"},
            ].map(s => (
              <div class="text-center py-4 border-b border-white/10 last:border-0 col-span-1">
                <p class="font-heading font-extrabold text-3xl mb-1" style="color: #4ECDC4;">{s.stat}</p>
                <p class="text-xs font-bold tracking-widest uppercase text-gray-400">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     B) PREMIUM PRE-APPLICATION BAND
══════════════════════════════════════════════ -->
<div id="fit" class="bg-[#FCF9FA] py-16 md:py-20 border-t border-b border-[#E6DAC6]/60 scroll-mt-28 px-4 lg:px-[clamp(9rem,13vw,16rem)]">
  <div style="width: 100%;">

    <!-- STACKED: visible below lg (mobile) -->
    <div class="lg:hidden flex flex-col gap-6">
      <div class="rounded-3xl overflow-hidden shadow-[0_8px_32px_rgba(15,109,114,0.06)] border border-[#E6DAC6] flex flex-col sm:flex-row bg-white relative">
        <div class="block sm:hidden absolute top-0 left-0 right-0 h-2" style="background:#0F6D72;"></div>
        <div class="hidden sm:block absolute left-0 top-0 bottom-0 w-2" style="background:#0F6D72;"></div>
        <div class="sm:w-[40%] relative aspect-[4/3] sm:aspect-auto text-white">
          <Image src={summerImage} alt="Dog training at sunset" class="absolute inset-0 w-full h-full object-cover" style="object-position:right center;" />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-[#0F6D72]/40 to-transparent"></div>
          <div class="absolute top-4 left-4 sm:left-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase bg-white/95 text-[#0F6D72] shadow-sm backdrop-blur-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              Special Offer
            </span>
          </div>
        </div>
        <div class="sm:w-[60%] p-6 sm:p-8 sm:pl-10 flex flex-col justify-center">
          <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-2" style="color:rgba(15,109,114,0.70);">Seasonal Summer Rate</p>
          <h2 class="text-2xl font-heading font-bold leading-tight mb-2" style="color:#112032;">$200 Off During Heat Advisory Months</h2>
          <p class="text-sm leading-relaxed mb-4" style="color:rgba(17,32,50,0.68);">When extreme heat or weather advisories make full daytime sessions unsafe, the Calm Companion Challenge shifts to a summer format: brief sunset field sessions paired with increased remote coaching and support. To reflect that adjustment, we offer a seasonal rate of <strong style="color:#0F6D72;">$200 off</strong> during qualifying hot weather periods.</p>
          <div class="flex items-start gap-3 p-3.5 rounded-xl" style="background:rgba(15,109,114,0.04);border:1px solid rgba(15,109,114,0.12);">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="#0F6D72" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <p class="text-xs font-semibold leading-relaxed" style="color:rgba(17,32,50,0.8);">Same structure. Same coaching.<br/>Weather-adjusted delivery for safety.</p>
          </div>
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden shadow-[0_8px_32px_rgba(15,109,114,0.06)] border border-[#E6DAC6] flex flex-col sm:flex-row bg-white relative">
        <div class="block sm:hidden absolute top-0 left-0 right-0 h-2" style="background:#0F6D72;"></div>
        <div class="hidden sm:block absolute left-0 top-0 bottom-0 w-2" style="background:#0F6D72;"></div>
        <div class="sm:w-[40%] relative aspect-[4/3] sm:aspect-auto text-white">
          <Image src={eligibilityImage} alt="Calm dog relaxing outdoors" class="absolute inset-0 w-full h-full object-cover" style="object-position:right 15%;" />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-[#0F6D72]/40 to-transparent"></div>
          <div class="absolute top-4 left-4 sm:left-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase bg-white/95 text-[#0F6D72] shadow-sm backdrop-blur-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              Honest Eligibility
            </span>
          </div>
        </div>
        <div class="sm:w-[60%] p-6 sm:p-8 sm:pl-10 flex flex-col justify-center">
          <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-2" style="color:rgba(15,109,114,0.70);">IS THIS A FIT?</p>
          <h2 class="text-2xl font-heading font-bold leading-tight mb-2" style="color:#112032;">Is This Challenge Right For Your Dog?</h2>
          <p class="text-sm leading-relaxed mb-3" style="color:rgba(17,32,50,0.68);">We only accept dogs who are a good fit for this system to ensure maximal success.</p>
          <div class="grid grid-cols-2 gap-4 mb-3">
            <div>
              <p class="text-[11px] font-bold tracking-widest uppercase mb-2 flex items-center gap-1.5" style="color:#0F6D72;">Good Fit <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></p>
              <ul class="space-y-1.5">
                {["Leash reactive to other dogs or people","Excited, over-aroused greeter","Mild-to-moderate pulling or jumping","Puppy or rescue with no bad habits yet","Owner willing to do daily homework"].map(item => (
                  <li class="flex items-start gap-2 text-xs leading-[1.3]" style="color:rgba(17,32,50,0.78);"><span class="block w-1 h-1 mt-[5px] rounded-full flex-shrink-0" style="background:rgba(15,109,114,0.5);"></span>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-[11px] font-bold tracking-widest uppercase mb-2 flex items-center gap-1.5" style="color:#7D2C2D;">Not a Fit <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></p>
              <ul class="space-y-1.5">
                {["Confirmed bite history or human aggression","Severe resource guarding","Dog-aggressive with no prior training","Owner unable to commit to the full program"].map(item => (
                  <li class="flex items-start gap-2 text-xs leading-[1.3]" style="color:rgba(17,32,50,0.78);"><span class="block w-1 h-1 mt-[5px] rounded-full flex-shrink-0" style="background:rgba(125,44,45,0.4);"></span>{item}</li>
                ))}
              </ul>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl" style="background:rgba(125,44,45,0.03);border:1px solid rgba(125,44,45,0.12);">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="#7D2C2D" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-[11px] leading-relaxed" style="color:rgba(17,32,50,0.75);">If your dog doesn't qualify for the Calm Companion Challenge, we may recommend our <a href="/programs#red-zone" class="font-bold underline underline-offset-2" style="color:#7D2C2D;">Reactive Dog Intensive</a> or a private evaluation first.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CAROUSEL: visible at lg+ (desktop) -->
    <div class="hidden lg:block">
      <div class="max-w-5xl mx-auto relative">
      <!-- Prev Arrow -->
      <button id="fit-prev" class="absolute left-[-52px] top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-10 h-10 rounded-full border border-[#E6DAC6] bg-white shadow-sm hover:bg-[#F5F0E8] transition-colors" aria-label="Previous card">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#0B2744" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <!-- Next Arrow -->
      <button id="fit-next" class="absolute right-[-52px] top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-10 h-10 rounded-full border border-[#E6DAC6] bg-white shadow-sm hover:bg-[#F5F0E8] transition-colors" aria-label="Next card">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#0B2744" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
      <div id="fit-carousel" class="overflow-hidden">
        <div id="fit-track" class="flex transition-transform duration-500 ease-in-out">

          <!-- SLIDE 1 -->
          <div class="w-full flex-shrink-0">
            <div class="rounded-3xl overflow-hidden shadow-[0_8px_32px_rgba(15,109,114,0.06)] border border-[#E6DAC6] flex flex-col sm:flex-row bg-white relative h-[490px]">
              <div class="block sm:hidden absolute top-0 left-0 right-0 h-2" style="background:#0F6D72;"></div>
              <div class="hidden sm:block absolute left-0 top-0 bottom-0 w-2" style="background:#0F6D72;"></div>
              <div class="sm:w-[45%] relative aspect-[4/3] sm:aspect-auto text-white">
                <Image src={summerImage} alt="Dog training at sunset" class="absolute inset-0 w-full h-full object-cover" style="object-position:right center;" />
                <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-[#0F6D72]/40 to-transparent"></div>
                <div class="absolute top-4 left-4 sm:left-6">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase bg-white/95 text-[#0F6D72] shadow-sm backdrop-blur-sm">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Special Offer
                  </span>
                </div>
              </div>
              <div class="sm:w-[55%] p-8 sm:p-12 sm:pl-14 flex flex-col justify-center">
                <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-4" style="color:rgba(15,109,114,0.70);">Seasonal Summer Rate</p>
                <h2 class="text-3xl font-heading font-bold leading-tight mb-4" style="color:#112032;">$200 Off During Heat Advisory Months</h2>
                <p class="text-sm leading-relaxed mb-4" style="color:rgba(17,32,50,0.68);">When extreme heat or weather advisories make full daytime sessions unsafe, the Calm Companion Challenge shifts to a summer format: brief sunset field sessions paired with increased remote coaching and support. To reflect that adjustment, we offer a seasonal rate of <strong style="color:#0F6D72;">$200 off</strong> during qualifying hot weather periods.</p>
                <div class="flex items-start gap-3 p-3.5 rounded-xl" style="background:rgba(15,109,114,0.04);border:1px solid rgba(15,109,114,0.12);">
                  <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="#0F6D72" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <p class="text-xs font-semibold leading-relaxed" style="color:rgba(17,32,50,0.8);">Same structure. Same coaching.<br/>Weather-adjusted delivery for safety.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- SLIDE 2 -->
          <div class="w-full flex-shrink-0">
            <div class="rounded-3xl overflow-hidden shadow-[0_8px_32px_rgba(15,109,114,0.06)] border border-[#E6DAC6] flex flex-col sm:flex-row bg-white relative h-[490px]">
              <div class="block sm:hidden absolute top-0 left-0 right-0 h-2" style="background:#0F6D72;"></div>
              <div class="hidden sm:block absolute left-0 top-0 bottom-0 w-2" style="background:#0F6D72;"></div>
              <div class="sm:w-[45%] relative aspect-[4/3] sm:aspect-auto text-white">
                <Image src={eligibilityImage} alt="Calm dog relaxing outdoors" class="absolute inset-0 w-full h-full object-cover" style="object-position:right 15%;" />
                <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-[#0F6D72]/40 to-transparent"></div>
                <div class="absolute top-4 left-4 sm:left-6">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase bg-white/95 text-[#0F6D72] shadow-sm backdrop-blur-sm">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                    Honest Eligibility
                  </span>
                </div>
              </div>
              <div class="sm:w-[55%] p-8 sm:p-12 sm:pl-14 flex flex-col justify-center">
                <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-2" style="color:rgba(15,109,114,0.70);">IS THIS A FIT?</p>
                <h2 class="text-3xl font-heading font-bold leading-tight mb-2" style="color:#112032;">Is This Challenge Right For Your Dog?</h2>
                <p class="text-sm leading-relaxed mb-3" style="color:rgba(17,32,50,0.68);">We only accept dogs who are a good fit for this system to ensure maximal success.</p>
                <div class="grid grid-cols-2 gap-4 mb-3">
                  <div>
                    <p class="text-[11px] font-bold tracking-widest uppercase mb-2 flex items-center gap-1.5" style="color:#0F6D72;">Good Fit <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></p>
                    <ul class="space-y-1.5">
                      {["Leash reactive to other dogs or people","Excited, over-aroused greeter","Mild-to-moderate pulling or jumping","Puppy or rescue with no bad habits yet","Owner willing to do daily homework"].map(item => (
                        <li class="flex items-start gap-2 text-xs leading-[1.3]" style="color:rgba(17,32,50,0.78);"><span class="block w-1 h-1 mt-[5px] rounded-full flex-shrink-0" style="background:rgba(15,109,114,0.5);"></span>{item}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="text-[11px] font-bold tracking-widest uppercase mb-2 flex items-center gap-1.5" style="color:#7D2C2D;">Not a Fit <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></p>
                    <ul class="space-y-1.5">
                      {["Confirmed bite history or human aggression","Severe resource guarding","Dog-aggressive with no prior training","Owner unable to commit to the full program"].map(item => (
                        <li class="flex items-start gap-2 text-xs leading-[1.3]" style="color:rgba(17,32,50,0.78);"><span class="block w-1 h-1 mt-[5px] rounded-full flex-shrink-0" style="background:rgba(125,44,45,0.4);"></span>{item}</li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="flex items-start gap-3 p-3 rounded-xl" style="background:rgba(125,44,45,0.03);border:1px solid rgba(125,44,45,0.12);">
                  <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="#7D2C2D" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <p class="text-[11px] leading-relaxed" style="color:rgba(17,32,50,0.75);">If your dog doesn't qualify for the Calm Companion Challenge, we may recommend our <a href="/programs#red-zone" class="font-bold underline underline-offset-2" style="color:#7D2C2D;">Reactive Dog Intensive</a> or a private evaluation first.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
      <div class="flex justify-center items-center gap-2 mt-6">
        <button id="fit-dot-0" class="rounded-full transition-all duration-300" style="width:20px;height:8px;background:#0F6D72;" aria-label="Card 1"></button>
        <button id="fit-dot-1" class="rounded-full transition-all duration-300" style="width:8px;height:8px;background:rgba(15,109,114,0.25);" aria-label="Card 2"></button>
      </div>
      </div>
    </div>


  </div>
</div>

<script>
(function () {
  var track = document.getElementById('fit-track');
  var dot0  = document.getElementById('fit-dot-0');
  var dot1  = document.getElementById('fit-dot-1');
  if (!track || !dot0 || !dot1) return;
  var dots = [dot0, dot1];
  var current = 0;
  function goTo(i) {
    current = i;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots.forEach(function(d, idx) {
      d.style.width      = idx === current ? '20px' : '8px';
      d.style.background = idx === current ? '#0F6D72' : 'rgba(15,109,114,0.25)';
    });
  }
  var timer = setInterval(function() { goTo((current + 1) % 2); }, 10000);
  function reset() { clearInterval(timer); timer = setInterval(function() { goTo((current + 1) % 2); }, 10000); }
  dots.forEach(function(d, i) { d.addEventListener('click', function() { goTo(i); reset(); }); });
  var prev = document.getElementById('fit-prev');
  var next = document.getElementById('fit-next');
  if (prev) prev.addEventListener('click', function() { goTo((current + 1) % 2); reset(); });
  if (next) next.addEventListener('click', function() { goTo((current + 1) % 2); reset(); });
  var carousel = document.getElementById('fit-carousel');
  if (carousel) {
    carousel.addEventListener('mouseenter', function() { clearInterval(timer); });
    carousel.addEventListener('mouseleave', reset);
  }
  var slideTo = document.querySelector('[data-slide-to]');
  if (slideTo) {
    slideTo.addEventListener('click', function() {
      var idx = parseInt(this.getAttribute('data-slide-to'), 10);
      setTimeout(function() { goTo(idx); reset(); }, 400);
    });
  }
})();
</script>



