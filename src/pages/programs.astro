  <script>
    function toggleSlab(id: string) {
      const drawer = document.getElementById(`${id}-drawer`);
      const label = document.getElementById(`${id}-label`);
      const chev = document.getElementById(`${id}-chevron`);
      if (!drawer || !label || !chev) return;
      const wasHidden = drawer.classList.toggle("hidden");
      label.textContent = wasHidden
        ? "View Full Program Details"
        : "Hide Details";
      (chev as HTMLElement).style.transform = wasHidden ? "" : "rotate(180deg)";
    }
    function toggleFaqBlock(id: string) {
      const block = document.getElementById(id);
      const chev = document.getElementById(`${id}-chevron`);
      if (!block || !chev) return;
      const wasHidden = block.classList.toggle("hidden");
      (chev as HTMLElement).style.transform = wasHidden ? "" : "rotate(180deg)";
    }
    function toggleFaq(id: string) {
      const content = document.getElementById(id);
      const icon = document.getElementById(`${id}-icon`);
      if (!content || !icon) return;
      const wasHidden = content.classList.toggle("hidden");
      (icon as HTMLElement).style.transform = wasHidden ? "" : "rotate(45deg)";
    }
    (window as any).toggleSlab = toggleSlab;
    (window as any).toggleFaqBlock = toggleFaqBlock;
    (window as any).toggleFaq = toggleFaq;

    // --- Segmented Nav Scroll Spy & Smooth Scroll ---
    const navItems = document.querySelectorAll(".segment-item");
    const sections = ["board-train", "training-programs", "breakthrough-sessions"].map(
      (id) => document.getElementById(id)
    );

    // Smooth scroll
    navItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = (item as HTMLAnchorElement).getAttribute("href");
        const element = document.querySelector(targetId!);
        if (element) {
          window.scrollTo({
            top: (element as HTMLElement).offsetTop - 120, // Adjust for header height
            behavior: "smooth",
          });
          // Update active state manually on click
          navItems.forEach((i) => i.classList.remove("active"));
          item.classList.add("active");
          // Update URL without jump
          history.pushState(null, "", targetId);
        }
      });
    });

    // Scroll Spy
    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -70% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navItems.forEach((item) => {
            if (item.getAttribute("href") === `#${id}`) {
              item.classList.add("active");
            } else {
              item.classList.remove("active");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => {
      if (section) observer.observe(section);
    });
  </script>
