---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import GuaranteeBadge from "../components/GuaranteeBadge.astro";

// Asset Imports
import heroImage from "../assets/images/oleksandr-horbach-qBnIX-B4n-w-unsplash.jpg";
import calmCompanionImage from "../assets/images/dog-in-water.jpg";
import privateAcceleratorImage from "../assets/images/hamza-gharnati-9S4GyfpxnTI-unsplash.jpg";
import redZoneImage from "../assets/images/muzzle-photo.jpg";
import breakthroughStandard from "../assets/images/ben-blumentritt-GbCee6shpx4-unsplash.jpg";
import breakthroughReactive from "../assets/images/andrescarlofotografia-muzzle-5240921_1920.jpg";
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
import logoWhite from "../assets/images/Brand-Name-Logo---White---Good-Doggos.png";
import tealPaw from "../assets/images/Paw Prints/Teal Paw Print.png";
import goldPaw from "../assets/images/Paw Prints/Gold Paw Print.png";
import redPaw from "../assets/images/Paw Prints/Red Paw Print.png";

// ── Canonical program color tokens ──
const TEAL = {
  bg: "#0F6D72",
  text: "white",
  border: "rgba(15,109,114,0.3)",
  tint: "rgba(15,109,114,0.08)",
};
const GOLD = {
  bg: "#D1B27F",
  text: "#0B2744",
  border: "rgba(209,178,127,0.35)",
  tint: "rgba(209,178,127,0.10)",
};
const RED = {
  bg: "#7D2C2D",
  text: "white",
  border: "rgba(125,44,45,0.25)",
  tint: "rgba(125,44,45,0.07)",
};

const showPromoBanner = true;
const promoBannerText = "Seasonal Summer Rate: Save $200 during hot-weather months, when training shifts to brief sunset sessions and additional remote support.";
---

<style>
  /* Segmented Navigation */
  .segmented-nav {
    display: flex;
    background: rgba(248, 250, 252, 0.08); /* Minimal frosted rail */
    backdrop-filter: blur(12px);
    border-radius: 100px;
    padding: 6px;
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4);
  }

  .segment-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.75);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
  }

  /* Segment Hover & Active States */
  .segment-item[href="#calm-companion"]:hover,
  .segment-item[href="#calm-companion"].active {
    background: #0f6d72; /* Teal */
    color: white !important;
    box-shadow: 0 4px 15px rgba(15, 109, 114, 0.35);
  }

  .segment-item[href="#private-accelerator"]:hover,
  .segment-item[href="#private-accelerator"].active {
    background: #d1b27f; /* Gold */
    color: #0b2744 !important;
    box-shadow: 0 4px 15px rgba(209, 178, 127, 0.35);
  }

  .segment-item[href="#red-zone"]:hover,
  .segment-item[href="#red-zone"].active {
    background: #7d2c2d; /* red */
    color: white !important;
    box-shadow: 0 4px 15px rgba(125, 44, 45, 0.35);
  }

  @media (max-width: 768px) {
    .segmented-nav {
      max-width: 100%;
      gap: 4px;
    }
    .segment-item {
      font-size: 8.5px;
      padding: 10px 4px;
      letter-spacing: 0.08em;
    }
  }

  @media (max-width: 767px) {
    .pa-photo {
      object-position: center 20%;
    }
  }
</style>

<Layout>
  <!-- ════════════════════════════════════════
     HERO — "Choose Your Path"
════════════════════════════════════════ -->
  <section
    class="relative flex items-end overflow-hidden bg-[#0B2744]"
    style="min-height: 52vh;"
  >
    <div class="absolute inset-0 z-0 text-white">
      <Image
        src={heroImage}
        alt="Dog training"
        class="w-full h-full object-cover opacity-50"
        style="object-position: center 15%;"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"
      >
      </div>
    </div>

    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-14"
      style="padding-top: 160px;"
    >
      <div class="text-center max-w-2xl mx-auto">
        <p
          class="text-[11px] font-bold tracking-[0.28em] uppercase mb-4"
          style="color: rgba(209,178,127,0.65);"
        >
          Dog Training Programs
        </p>
        <h1
          class="text-5xl md:text-6xl font-heading font-bold text-white leading-tight mb-3"
        >
          Choose Your Path
        </h1>
        <p class="text-gray-300 mb-8 text-lg">
          Guaranteed results for families who want <span
            class="headline-accent"
            style="color:#D1B27F;">the best for their dog.</span
          >
        </p>

        <!-- Segmented Navigation -->
        <nav class="segmented-nav">
          <a href="#calm-companion" class="segment-item">Calm Companion</a>
          <a href="#private-accelerator" class="segment-item"
            >Private Accelerator</a
          >
          <a href="#red-zone" class="segment-item">Reactive Dog Intensive</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
     PROGRAMS — HORIZONTAL SLABS
════════════════════════════════════════ -->
  <div class="bg-[#FBF1E9] py-10">
    <div class="max-w-7xl mx-auto px-4 md:px-8 space-y-4">
      <!-- ══════════════════════════════════
         SLAB 1 — CALM COMPANION (TEAL)
    ══════════════════════════════════ -->
      <div
        id="calm-companion"
        class="scroll-mt-36 rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.07)] flex flex-col"
      >
        {showPromoBanner && (
          <div class="bg-[#EBF3F4] text-[#0B2744] text-[13px] md:text-sm font-medium px-5 py-3 border-b border-[#E6DAC6] flex items-start md:items-center justify-center gap-2 text-center">
            <svg class="w-4 h-4 text-[#0F6D72] flex-shrink-0 mt-0.5 md:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span class="leading-relaxed text-left md:text-center"><strong style="color:#0F6D72;">Seasonal Summer Rate:</strong> Save $200 during hot-weather months, when training shifts to brief sunset sessions and additional remote support.</span>
          </div>
        )}
        <!-- Teal left accent strip via flex row wrapper -->
        <div class="flex flex-col md:flex-row flex-1">
          <!-- Accent Strip -->
          <div
            class="hidden md:block flex-shrink-0"
            style="width: 11px; background: #0F6D72;"
          >
          </div>
          <div
            class="block md:hidden h-[9px] w-full"
            style="background: #0F6D72;"
          >
          </div>

          <div
            class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0"
          >
            <!-- Photo -->
            <div class="relative overflow-hidden" style="height: 300px;">
              <Image
                src={calmCompanionImage}
                alt="Calm Companion Training"
                class="w-full h-full object-cover"
                style="height: 300px; transform: scale(1.35); transform-origin: center;"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"
              >
              </div>
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase text-white px-3 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.80); backdrop-filter: blur(6px);"
                  >★ Flagship Offer</span
                >
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >4 Weeks</span
                >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >Group + Remote Hybrid Training</span
                >
              </div>
              <h2
                class="text-2xl font-heading font-bold mb-0.5"
                style="color: #112032;"
              >
                Calm Companion Challenge
              </h2>
              <p class="text-sm font-semibold mb-3" style="color: #0F6D72;">
                The Foundation for a Happy Home
              </p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                <span style="color: #0F6D72;">$799</span>
              </p>
              <p
                class="text-sm leading-relaxed"
                style="color: rgba(17,32,50,0.72);"
              >
                Perfect for adult dogs needing basic obedience and manner
                refinement. We focus on engagement, neutrality, and household
                manners — building the foundation your dog needs to thrive
                everywhere.
              </p>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-7 flex flex-col justify-between">
              <ul class="space-y-2 mb-6">
                {
                  [
                    "Loose-leash walking proficiency",
                    "Engagement and focus framework",
                    "Core obedience reliability",
                    "Calm settling routine (off-switch)",
                    "Household manners and boundary skills",
                    "Social neutrality in real-world settings",
                  ].map((item) => (
                    <li
                      class="flex items-start gap-2.5 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <Image src={tealPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
                      {item}
                    </li>
                  ))
                }
              </ul>
              <a
                href="/apply"
                class="btn-apply-teal"
              >
                Apply for Free Assessment
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Footer Strip -->
        <div
          class="flex flex-col md:flex-row items-center justify-between px-7 py-4 border-t border-[#E6DAC6]/60 gap-4"
        >
          <!-- Constrained wrapper: narrower, left-aligned callout -->
          <div class="w-full md:max-w-[520px] mr-auto flex-shrink-0">
            <GuaranteeBadge program="ccc" />
          </div>
          <button
            id="calm-toggle"
            onclick="toggleSlab('calm')"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-bold tracking-wide transition-all duration-200"
            style="border: 1px solid #E6DAC6; background: #FCF9FA; color: #112032;"
          >
            <span id="calm-label">View Full Program Details</span>
            <svg
              id="calm-chevron"
              class="w-3.5 h-3.5 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <!-- Expandable Drawer -->
        <div id="calm-drawer" class="hidden border-t border-[#E6DAC6]">
          <div class="grid md:grid-cols-2 gap-8 px-8 py-8">
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-4"
                style="color: rgba(17,32,50,0.40);"
              >
                What We'll Focus On:
              </p>
              <ul class="space-y-3">
                {
                  [
                    {
                      icon: "👥",
                      text: "4–6 Weekly Group Sessions (90 min each)",
                    },
                    { icon: "📋", text: "Daily Homework & Practice Plans" },
                    { icon: "✉️", text: "Weekly Check-Ins & Feedback" },
                    { icon: "🐕", text: "Helper Dog Exposure Reps" },
                    { icon: "🔒", text: "Private Community Access" },
                    { icon: "🎓", text: "Graduation Certificate" },
                    {
                      icon: "🏆",
                      text: "100% Money-Back Guarantee (<a href=\"/guarantee\" class=\"underline\" style=\"color:#0F6D72\">conditions apply</a>)",
                    },
                  ].map((i) => (
                    <li
                      class="flex items-start gap-3 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <span>{i.icon}</span>
                      <span set:html={i.text} />
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p
                class="text-xs font-bold tracking-widest uppercase mb-1"
                style="color: rgba(17,32,50,0.40);"
              >
                Included in Your Enrollment
              </p>
              <p class="text-[11px] leading-snug mb-4" style="color: rgba(17,32,50,0.55);">
                Everything below is included at no extra cost. Values shown reflect standalone retail value.
              </p>
              <div
                class="rounded-xl border border-[#E6DAC6] bg-white p-5 text-sm"
              >
                {
                  [
                    ["4-Week Transformation Curriculum", "$800"],
                    ["Daily Homework Reviews & Feedback", "$600"],
                    ["Helper Dog Demos & Exposure", "$500"],
                    ["Basic Obedience Vault (Lifetime Access)", "$297"],
                    ["100% Win-Your-Money-Back Guarantee", "Included"],
                  ].map(([label, price]) => (
                    <div class="flex justify-between py-2 border-b border-[#E6DAC6]/50 last:border-0 items-center">
                      <span class="pr-3 leading-snug" style="color:rgba(17,32,50,0.65);">{label}</span>
                      {price === "Included" ? (
                        <span class="font-bold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full whitespace-nowrap" style="background:rgba(15,109,114,0.1); color:#0F6D72; border:1px solid rgba(15,109,114,0.2);">
                          Included
                        </span>
                      ) : (
                        <span class="font-bold whitespace-nowrap" style="color:#0F6D72;">
                          {price}
                        </span>
                      )}
                    </div>
                  ))
                }
                <div class="flex justify-between items-center pt-4 pb-1">
                  <span class="font-bold text-sm" style="color:rgba(17,32,50,0.45);"
                    >Retail Value:</span
                  >
                  <span class="font-bold text-sm line-through" style="color:rgba(17,32,50,0.45);"
                    >$2,996+</span
                  >
                </div>
                <div class="flex justify-between items-center pt-3 mt-1 border-t border-[#E6DAC6]">
                  <span class="font-bold text-base" style="color:#112032;"
                    >Your Price Today:</span
                  >
                  <span class="font-extrabold text-2xl" style="color:#0F6D72;"
                    >$799</span
                  >
                </div>
              </div>
              <p class="text-xs mt-2 italic" style="color:rgba(17,32,50,0.38);">
                * Helper dogs are for demonstration only until graduation
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ: CALM COMPANION -->
      <div class="rounded-xl overflow-hidden border border-[#E6DAC6]/50">
        <button
          onclick="toggleFaqBlock('cc-faqs')"
          class="w-full flex items-center justify-between px-6 py-4 bg-white text-left"
        >
          <span
            class="text-xs font-bold tracking-widest uppercase"
            style="color:rgba(17,32,50,0.42);">Calm Companion FAQs (5)</span
          >
          <svg
            id="cc-faqs-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#0F6D72"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="cc-faqs" class="hidden">
          {
            [
              {
                q: "Do I leave my dog for training, or am I part of it?",
                a: "You’re absolutely a part of it! And a significant part, at that. This is not a drop-off program. We train both you and your dog so the results carry over into daily life, real routines, and the moments that actually matter.",
              },
              {
                q: "Is this right for excited greeters and leash pullers?",
                a: "Yes — it's our most common entry point. We address over-arousal, threshold reactivity, and pulling using structured exposure and helper dog setups that simulate real-world triggers.",
              },
              {
                q: "What if I miss a session?",
                a: "We offer one makeup credit per program cycle. Sessions can be rescheduled within the same program window if space allows. A 12-hour cancellation notice is required.",
              },
              {
                q: "What does the guarantee require?",
                a: "Complete every session, submit all homework on time, and follow the daily protocol. If you do the work, you earn 100% of your money back—regardless of your dog’s rate of progress. We’re so confident in the process, we’re willing to pay you to prove it. The reps matter.",
              },
              {
                q: "Can I start if my dog has never been trained?",
                a: "Absolutely. The Calm Companion is our foundational program — no prior training required.",
              },
            ].map((faq, i) => (
              <div class="border-t border-[#E6DAC6]/50 bg-white">
                <button
                  class="w-full flex justify-between items-center px-6 py-4 text-left"
                  onclick={`toggleFaq('cc-q${i}')`}
                >
                  <span class="text-sm font-medium pr-4" style="color:#112032;">
                    {faq.q}
                  </span>
                  <svg
                    id={`cc-q${i}-icon`}
                    class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="#0F6D72"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                </button>
                <div id={`cc-q${i}`} class="hidden px-6 pb-4">
                  <p
                    class="text-sm leading-relaxed"
                    style="color:rgba(17,32,50,0.65);"
                  >
                    {faq.a}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ══════════════════════════════════
         SLAB 2 — PRIVATE ACCELERATOR (GOLD)
    ══════════════════════════════════ -->
      <div
        id="private-accelerator"
        class="scroll-mt-36 rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.07)] flex flex-col"
      >
        <div class="flex flex-col md:flex-row flex-1">
          <div
            class="hidden md:block flex-shrink-0"
            style="width: 11px; background: #D1B27F; border-radius: 16px 0 0 0;"
          >
          </div>
          <div
            class="block md:hidden h-[9px] w-full"
            style="background: #D1B27F;"
          >
          </div>

          <div
            class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0"
          >
            <!-- Photo — centered crop -->
            <div class="relative overflow-hidden" style="height: 300px;">
              <Image
                src={privateAcceleratorImage}
                alt="Private Accelerator Training"
                class="w-full h-full object-cover pa-photo"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"
              >
              </div>
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.85); backdrop-filter: blur(6px); color: #0B2744;"
                  >🏆 Most Popular</span
                >
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.12); color: #B08A4A; border: 1px solid rgba(209,178,127,0.30);"
                  >6 sessions</span
                >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(209,178,127,0.12); color: #B08A4A; border: 1px solid rgba(209,178,127,0.30);"
                  >1-on-1 Training</span
                >
              </div>
              <h2
                class="text-2xl font-heading font-bold mb-0.5"
                style="color: #112032;"
              >
                Private Accelerator
              </h2>
              <p class="text-sm font-semibold mb-3" style="color: #D1B27F;">
                Rapid Results in a Private Training Setting
              </p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                <span style="color: #D1B27F;">$1,199</span>
              </p>
              <p
                class="text-sm leading-relaxed"
                style="color: rgba(17,32,50,0.72);"
              >
                Private, fast-track training for families who want results
                quickly. Six 1-on-1 sessions to sharpen obedience, improve leash
                control, and build calmer real-world outings you can trust.
              </p>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-5 flex flex-col justify-between">
              <ul class="space-y-2 mb-6">
                {
                  [
                    "Advanced obedience reliability",
                    "Stronger focus around distractions",
                    "Real-world leash handling skills",
                    "Public manners and outing control",
                    "Structured neutrality around dogs and people",
                    "Clear follow-through and owner accountability",
                    "Lifestyle freedom through consistent rules",
                  ].map((item) => (
                    <li
                      class="flex items-start gap-2.5 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <Image src={goldPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
                      {item}
                    </li>
                  ))
                }
              </ul>
              <a
                href="/apply"
                class="btn-apply"
              >
                Apply for Free Assessment
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Footer Strip -->
        <div
