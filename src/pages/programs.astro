---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import GuaranteeBadge from "../components/GuaranteeBadge.astro";

// Asset Imports
import heroImage from "../assets/images/oleksandr-horbach-qBnIX-B4n-w-unsplash.jpg";
import calmCompanionImage from "../assets/images/dog-in-water.jpg";
import privateAcceleratorImage from "../assets/images/hamza-gharnati-9S4GyfpxnTI-unsplash.jpg";
import redZoneImage from "../assets/images/victor-and-tupac.png";
import breakthroughStandard from "../assets/images/ben-blumentritt-GbCee6shpx4-unsplash.jpg";
import breakthroughReactive from "../assets/images/andrescarlofotografia-muzzle-5240921_1920.jpg";
import mascotNavy from "../assets/images/Navy-Dog-Mascot-Transparent---Good-Doggos.png";
import logoWhite from "../assets/images/Brand-Name-Logo---White---Good-Doggos.png";
import tealPaw from "../assets/images/Paw Prints/Teal Paw Print.png";
import goldPaw from "../assets/images/Paw Prints/Gold Paw Print.png";
import redPaw from "../assets/images/Paw Prints/Red Paw Print.png";
import navyPaw from "../assets/images/Paw Prints/Ink Black Paw Print.png";
import boardTrainImage from "../assets/images/victor-and-cocoa.png";

// ── Canonical program color tokens ──
const TEAL = {
  bg: "#0F6D72",
  text: "white",
  border: "rgba(15,109,114,0.3)",
  tint: "rgba(15,109,114,0.08)",
};
const GOLD = {
  bg: "#D1B27F",
  text: "#0B2744",
  border: "rgba(209,178,127,0.35)",
  tint: "rgba(209,178,127,0.10)",
};
const RED = {
  bg: "#7D2C2D",
  text: "white",
  border: "rgba(125,44,45,0.25)",
  tint: "rgba(125,44,45,0.07)",
};

const showPromoBanner = true;
const promoBannerText = "Seasonal Summer Rate: Save $200 during hot-weather months, when training shifts to brief sunset sessions and additional remote support.";
---

<style>
  /* Segmented Navigation */
  .segmented-nav {
    display: flex;
    background: rgba(248, 250, 252, 0.08); /* Minimal frosted rail */
    backdrop-filter: blur(12px);
    border-radius: 100px;
    padding: 6px;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4);
  }

  .segment-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.75);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
  }

  /* Segment Hover & Active States */
  .segment-item[href="#board-train"]:hover,
  .segment-item[href="#board-train"].active {
    background: #0B2744; /* Navy */
    color: white !important;
    box-shadow: 0 4px 15px rgba(11, 39, 68, 0.45);
  }

  .segment-item[href="#training-programs"]:hover,
  .segment-item[href="#training-programs"].active {
    background: #0f6d72; /* Teal */
    color: white !important;
    box-shadow: 0 4px 15px rgba(15, 109, 114, 0.35);
  }

  .segment-item[href="#breakthrough-sessions"]:hover,
  .segment-item[href="#breakthrough-sessions"].active {
    background: #d1b27f; /* Gold */
    color: #0b2744 !important;
    box-shadow: 0 4px 15px rgba(209, 178, 127, 0.35);
  }

  @media (max-width: 768px) {
    .segmented-nav {
      max-width: 100%;
      gap: 4px;
    }
    .segment-item {
      font-size: 8.5px;
      padding: 10px 4px;
      letter-spacing: 0.08em;
    }
  }

  @media (max-width: 767px) {
    .pa-photo {
      object-position: center 20%;
    }
    .rdi-photo {
      transform-origin: center 95% !important;
    }
  }

  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, #E6DAC6 40%, #E6DAC6 60%, transparent);
  }
</style>

<Layout>
  <!-- ════════════════════════════════════════
     HERO — "Choose Your Path"
════════════════════════════════════════ -->
  <section
    class="relative flex items-end overflow-hidden bg-[#0B2744]"
    style="min-height: 52vh;"
  >
    <div class="absolute inset-0 z-0 text-white">
      <Image
        src={heroImage}
        alt="Dog training"
        class="w-full h-full object-cover opacity-50"
        style="object-position: center 15%;"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"
      >
      </div>
    </div>

    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-14 pt-[240px] md:pt-[160px]"
    >
      <div class="text-center max-w-2xl mx-auto">
        <p
          class="text-[11px] font-bold tracking-[0.28em] uppercase mb-4"
          style="color: rgba(209,178,127,0.65);"
        >
          Dog Training Programs
        </p>
        <h1
          class="text-5xl md:text-6xl font-heading font-bold text-white leading-tight mb-3"
        >
          Choose Your Path
        </h1>
        <p class="text-gray-300 mb-8 text-lg">
          Guaranteed results for families who want <span
            class="headline-accent"
            style="color:#D1B27F;">the best for their dog.</span
          > We do not just train dogs. We train owners too, so your dog listens better with you, your family, and the people who care for them.
        </p>

        <!-- Segmented Navigation -->
        <nav class="segmented-nav">
          <a href="#board-train" class="segment-item">Board &amp; Train</a>
          <a href="#training-programs" class="segment-item">Training Programs</a>
          <a href="#breakthrough-sessions" class="segment-item">Individual Sessions</a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
     BOARD & TRAIN — DARK SECTION
════════════════════════════════════════ -->
  <section id="board-train" class="scroll-mt-28 bg-[#FBF1E9] py-10">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-10">
        <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-4" style="color: rgba(15,109,114,0.65);">Residential Training</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3" style="color: #0B2744;">
          Board &amp; <span class="headline-accent">Train</span>
        </h2>
        <p class="max-w-xl mx-auto text-base leading-relaxed" style="color: rgba(17,32,50,0.65);">
          Your dog lives with our trainer for 5 days — trained and loved as family. The fastest path to a reliable foundation.
        </p>
      </div>

      <!-- 5-Day Blitz Card -->
      <div class="rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.18)] flex flex-col">
        <div class="flex flex-col md:flex-row flex-1">
          <!-- Navy left accent strip -->
          <div class="hidden md:block flex-shrink-0" style="width: 11px; background: #0B2744;"></div>
          <div class="block md:hidden h-[9px] w-full" style="background: #0B2744;"></div>

          <div class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0">
            <!-- Photo -->
            <div class="relative overflow-hidden" style="min-height: 300px;">
              <Image
                src={boardTrainImage}
                alt="5-Day Blitz Board & Train"
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div class="absolute inset-0" style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"></div>
              <div class="absolute bottom-4 left-4">
                <span class="text-[10px] font-bold tracking-widest uppercase text-white px-3 py-1 rounded-full" style="background: rgba(11,39,68,0.82); backdrop-filter: blur(6px);">🏠 In-Home Residential</span>
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background: rgba(11,39,68,0.08); color: #0B2744; border: 1px solid rgba(11,39,68,0.20);">5 Days</span>
                <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background: rgba(11,39,68,0.08); color: #0B2744; border: 1px solid rgba(11,39,68,0.20);">In-Home Residential</span>
              </div>
              <h2 class="text-2xl font-heading font-bold mb-0.5" style="color: #112032;">5-Day Blitz</h2>
              <p class="text-sm font-semibold mb-3" style="color: #0B2744;">Immersive In-Home Training</p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                <span style="color: #0B2744;">$1,500</span>
              </p>
              <p class="text-sm leading-relaxed mb-4" style="color: rgba(17,32,50,0.72);">
                Your dog lives in our trainer's home as family for 5 days. Daily neighborhood walks, socialization with our helper dogs, and focused obedience work build a reliable foundation in low-distraction environments — with frequent photo and video updates throughout.
              </p>
              <!-- Reactive Add-On -->
              <div class="rounded-xl p-3.5 border" style="background: rgba(125,44,45,0.05); border-color: rgba(125,44,45,0.18);">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background: rgba(125,44,45,0.12); color: #7D2C2D; border: 1px solid rgba(125,44,45,0.22);">+$500</span>
                  <span class="text-sm font-semibold font-heading" style="color: #7D2C2D;">Reactive Dog Add-On</span>
                </div>
                <p class="text-xs leading-relaxed" style="color: rgba(17,32,50,0.65);">
                  For dogs with reactivity or aggression history. Includes additional behavior modification work during the 5-day stay. Completing the Reactive 5-Day Blitz is a great step on its own — and if you want to keep the momentum going, we encourage (but don't require) following up with our <a href="#red-zone" class="font-semibold underline" style="color: #7D2C2D;">Reactive Dog Intensive</a> program.
                </p>
              </div>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-7 flex flex-col justify-between">
              <div>
                <p class="text-xs font-bold tracking-widest uppercase mb-3" style="color: rgba(17,32,50,0.40);">Skills Your Dog Will Build</p>
                <ul class="space-y-2 mb-3">
                  {[
                    "Place command",
                    "Sit & down on cue",
                    "Recall (come when called)",
                    "Loose leash walking",
                    "Socialization with helper dogs",
                    "Play bonding (tug & fetch)",
                  ].map((item) => (
                    <li class="flex items-start gap-2.5 text-sm" style="color: rgba(17,32,50,0.78);">
                      <Image src={navyPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
                      {item}
                    </li>
                  ))}
                </ul>
                <p class="text-xs italic mb-6" style="color: rgba(17,32,50,0.45);">All skills built in low-distraction environments.</p>
              </div>
              <a href="/apply" class="btn-apply-navy">
                Apply for Free Assessment
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Footer Strip -->
        <div class="flex flex-col md:flex-row items-center justify-between px-7 py-4 border-t border-[#E6DAC6]/60 gap-4">
          <div class="w-full md:max-w-[520px] mr-auto flex-shrink-0">
            <GuaranteeBadge program="bt" />
          </div>
        </div>
      </div>

      <!-- FAQ: 5-DAY BLITZ -->
      <div class="rounded-xl overflow-hidden border border-[#E6DAC6]/50 mt-4">
        <button
          onclick="toggleFaqBlock('bt-faqs')"
          class="w-full flex items-center justify-between px-6 py-4 bg-white text-left"
        >
          <span class="text-xs font-bold tracking-widest uppercase" style="color:rgba(17,32,50,0.42);">5-Day Blitz FAQs (6)</span>
          <svg
            id="bt-faqs-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#0B2744"
            stroke-width="2"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div id="bt-faqs" class="hidden">
          {
            [
              {
                q: "What does my dog actually do during the 5 days?",
                a: "Each day is structured around short, focused training sessions, daily neighborhood walks, and socialization with our helper dogs. In between, your dog is part of the household — resting, playing, and building trust. We use tug and fetch as bonding exercises, which helps your dog see the trainer as a source of fun and security, not just someone giving commands.",
              },
              {
                q: "Can I visit or check in during the stay?",
                a: "We ask that owners hold off on visits during the 5-day stay. Even well-intentioned visits can disrupt the bonding and routine we're building. Instead, we send frequent photo and video updates so you always know how your dog is doing. Most owners are surprised by how quickly their dog settles in.",
              },
              {
                q: "What happens at the end of the 5 days?",
                a: "On pickup day, we walk you through everything your dog has learned. You'll leave with a clear picture of what your dog knows, which cues to use, and how to maintain the new behaviors at home. Consistency from day one is what makes the results last.",
              },
              {
                q: "My dog is reactive. Do they need the add-on, or is the standard Blitz enough?",
                a: "If your dog has a history of reactivity or aggression — lunging, snapping, intense fixation, or a bite history — the Reactive Add-On is the right choice. It adds $500 to the 5-day stay and includes additional behavior modification protocols tailored to reactive dogs. If you're unsure, apply for a free assessment and we'll help you figure out the right fit.",
              },
              {
                q: "Is the 5-Day Blitz right for puppies?",
                a: "The 5-Day Blitz is designed for dogs old enough to begin structured obedience work. Very young puppies often benefit more from foundational socialization at home before entering a structured program. We'll let you know what's appropriate for your dog's age and development during the free assessment.",
              },
              {
                q: "What should I bring when I drop off my dog?",
                a: "Bring your dog's food (enough for 5 days), their current leash and collar, and any comfort items they're attached to — a familiar blanket, their favorite toy. Let us know about any dietary needs, medical conditions, or medications ahead of time so we're fully prepared.",
              },
            ].map((faq, i) => (
              <div class="border-t border-[#E6DAC6]/50 bg-white">
                <button
                  class="w-full flex justify-between items-center px-6 py-4 text-left"
                  onclick={`toggleFaq('bt-q${i}')`}
                >
                  <span class="text-sm font-medium pr-4" style="color:#112032;">{faq.q}</span>
                  <svg
                    id={`bt-q${i}-icon`}
                    class="w-4 h-4 flex-shrink-0 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="#0B2744"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
                <div id={`bt-q${i}`} class="hidden px-6 pb-4">
                  <p class="text-sm leading-relaxed" style="color:rgba(17,32,50,0.65);">{faq.a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="bg-[#FBF1E9] px-4 md:px-8">
    <div class="max-w-7xl mx-auto"><div class="divider-line"></div></div>
  </div>

  <!-- ════════════════════════════════════════
     PROGRAMS — HORIZONTAL SLABS
════════════════════════════════════════ -->
  <div id="training-programs" class="scroll-mt-28 bg-[#FBF1E9] py-10">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-10">
        <p class="text-[11px] font-bold tracking-[0.25em] uppercase mb-4" style="color: rgba(15,109,114,0.65);">Our Programs</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3" style="color: #0B2744;">
          Training <span class="headline-accent">Programs</span>
        </h2>
        <p class="max-w-xl mx-auto text-base leading-relaxed" style="color: rgba(17,32,50,0.65);">Three structured programs — each built around a specific training goal with measurable outcomes and a guarantee.</p>
      </div>
    <div class="space-y-4">
      <!-- ══════════════════════════════════
         SLAB 1 — CALM COMPANION (TEAL)
    ══════════════════════════════════ -->
      <div
        id="calm-companion"
        class="scroll-mt-36 rounded-2xl overflow-hidden border border-[#E6DAC6] bg-[#FCF9FA] shadow-[0_4px_20px_rgba(0,0,0,0.07)] flex flex-col"
      >
        {showPromoBanner && (
          <div class="bg-[#EBF3F4] text-[#0B2744] text-[13px] md:text-sm font-medium px-5 py-3 border-b border-[#E6DAC6] flex items-start md:items-center justify-center gap-2 text-center">
            <svg class="w-4 h-4 text-[#0F6D72] flex-shrink-0 mt-0.5 md:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span class="leading-relaxed text-left md:text-center"><strong style="color:#0F6D72;">Seasonal Summer Rate:</strong> Save $200 during hot-weather months, when training shifts to brief sunset sessions and additional remote support.</span>
          </div>
        )}
        <!-- Teal left accent strip via flex row wrapper -->
        <div class="flex flex-col md:flex-row flex-1">
          <!-- Accent Strip -->
          <div
            class="hidden md:block flex-shrink-0"
            style="width: 11px; background: #0F6D72;"
          >
          </div>
          <div
            class="block md:hidden h-[9px] w-full"
            style="background: #0F6D72;"
          >
          </div>

          <div
            class="flex-1 grid grid-cols-1 md:grid-cols-[272px_1fr_1fr] gap-0"
          >
            <!-- Photo -->
            <div class="relative overflow-hidden" style="min-height: 300px;">
              <Image
                src={calmCompanionImage}
                alt="Calm Companion Training"
                class="absolute inset-0 w-full h-full object-cover"
                style="transform: scale(1.35); transform-origin: center;"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to right, transparent 65%, #FCF9FA 100%);"
              >
              </div>
              <div class="absolute bottom-4 left-4">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase text-white px-3 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.80); backdrop-filter: blur(6px);"
                  >★ Flagship Offer</span
                >
              </div>
            </div>

            <!-- Info -->
            <div class="px-7 py-7 border-r border-[#E6DAC6]/50">
              <div class="flex flex-wrap gap-2 mb-3">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >4 Weeks</span
                >
                <span
                  class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full"
                  style="background: rgba(15,109,114,0.09); color: #0F6D72; border: 1px solid rgba(15,109,114,0.22);"
                  >Group + Remote Hybrid Training</span
                >
              </div>
              <h2
                class="text-2xl font-heading font-bold mb-0.5"
                style="color: #112032;"
              >
                Calm Companion Challenge
              </h2>
              <p class="text-sm font-semibold mb-3" style="color: #0F6D72;">
                The Foundation for a Happy Home
              </p>
              <p class="text-2xl font-bold mb-4" style="color: #112032;">
                <span style="color: #0F6D72;">$799</span>
              </p>
              <p
                class="text-sm leading-relaxed"
                style="color: rgba(17,32,50,0.72);"
              >
                Perfect for adult dogs needing basic obedience and manner
                refinement. We focus on engagement, neutrality, and household
                manners — building the foundation your dog needs to thrive
                everywhere.
              </p>
            </div>

            <!-- Bullets + CTA -->
            <div class="px-7 py-7 flex flex-col justify-between">
              <div>
                <p class="text-xs font-bold tracking-widest uppercase mb-3" style="color: rgba(17,32,50,0.40);">Skills Your Dog Will Build</p>
                <ul class="space-y-2 mb-6">
                {
                  [
                    "Loose-leash walking proficiency",
                    "Engagement and focus framework",
                    "Core obedience reliability",
                    "Calm settling routine (off-switch)",
                    "Household manners and boundary skills",
                    "Social neutrality in real-world settings",
                  ].map((item) => (
                    <li
                      class="flex items-start gap-2.5 text-sm"
                      style="color: rgba(17,32,50,0.78);"
                    >
                      <Image src={tealPaw} alt="" class="w-4 h-4 mt-0.5 flex-shrink-0" />
                      {item}
                    </li>
                  ))
                }
              </ul>
              </div>
              <a
                href="/apply"
                class="btn-apply-teal"
              >
                Apply for Free Assessment
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Footer Strip -->
        <div
          class="flex flex-col md:flex-row items-center justify-between px-7 py-4 border-t border-[#E6DAC6]/60 gap-4"
        >
          <!-- Constrained wrapper: narrower, left-aligned callout -->
          <div class="w-full md:max-w-[520px] mr-auto flex-shrink-0">
            <GuaranteeBadge program="ccc" />
          </div>
          <button
            id="calm-toggle"
            onclick="toggleSlab('calm')"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-bold tracking-wide transition-all duration-200"
            style="border: 1px solid #E6DAC6; background: #FCF9FA; color: #112032;"
          >
            <span id="calm-label">View Full Program Details</span>
            <svg
              id="calm-chevron"
              class="w-3.5 h-3.5 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
