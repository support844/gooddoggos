                <div class="min-w-full md:min-w-0 snap-center">
                  <div class="bg-[#FCF9FA] h-full rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_3px_16px_rgba(0,0,0,0.06)] flex flex-col group hover:shadow-[0_6px_24px_rgba(0,0,0,0.10)] transition-shadow duration-200">
                    <div class="relative overflow-hidden aspect-[2/1] py-[15px] bg-white">
                      {p.img
                        ? <img src={p.img} alt={p.name} class="w-full h-full object-contain" style="background:#ffffff;" loading="lazy" />
                        : <div class="w-full h-full" style="background-color: #0F6D7F;"></div>
                      }
                    </div>
                    <div class="flex flex-col flex-1 p-6">
                      <h3 class="font-heading font-bold text-base mb-2" style="color: #0B2744;">{p.name}</h3>
                      <p class="text-xs italic mb-4 leading-relaxed" style="color: rgba(17,32,50,0.58);">{p.why}</p>
                      <ul class="space-y-1.5 mb-4">
                        {p.bullets.map(b => (
                          <li class="flex items-start gap-2 text-xs" style="color: rgba(17,32,50,0.65);">
                            <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="#D1B27F" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {b}
                          </li>
                        ))}
                      </ul>
                      <div class="flex flex-wrap gap-1.5 mb-5">
                        {p.tags.map(t => (
                          <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-1 rounded-full" style="background: rgba(209,178,127,0.10); color: #D1B27F; border: 1px solid rgba(209,178,127,0.20);">{t}</span>
                        ))}
                      </div>
                      <div class="flex-1"></div>
                      <a
                        href={p.link}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="w-full inline-flex items-center justify-center gap-2 text-xs font-bold tracking-widest uppercase rounded-full transition-all duration-200 hover:-translate-y-0.5"
                        style="background: #D1B27F; color: #0B2744; padding: 12px 20px; box-shadow: 0 4px 12px rgba(209,178,127,0.28);"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        Shop on Amazon
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            {cat.products.length > 1 && (
              <div class="flex md:hidden justify-between items-center mt-4 px-2">
                <button
                  data-prev
                  class="w-10 h-10 rounded-full border border-[#D1B27F] bg-[#D1B27F] flex items-center justify-center shadow-sm active:scale-95 transition-transform"
                  aria-label="Previous product"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#0B2744" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div class="flex gap-2 items-center">
                  {cat.products.map((_, i) => (
                    <button
                      data-dot
                      class="w-2 h-2 rounded-full transition-all duration-200 cursor-pointer"
                      style={i === 0 ? "background: #0B2744; transform: scale(1.3);" : "background: #E6DAC6;"}
