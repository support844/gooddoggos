<script>
  document.addEventListener('DOMContentLoaded', () => {

    // ── Legacy mobile-snap carousel for non-data-carousel sections ──
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
      const wrapper = carousel.parentElement;
      if (!wrapper) return;

      const prevBtn = wrapper.querySelector('[data-prev]');
      const nextBtn = wrapper.querySelector('[data-next]');
      const dots = Array.from(wrapper.querySelectorAll('[data-dot]'));

      function cardWidth() {
        const first = carousel.firstElementChild;
        if (!first) return carousel.offsetWidth;
        const gap = parseFloat(getComputedStyle(carousel).gap) || 20;
        return first.offsetWidth + gap;
      }

      function updateDots() {
        if (!dots.length) return;
        const index = Math.round(carousel.scrollLeft / (carousel.firstElementChild?.offsetWidth ?? 1));
        dots.forEach((dot, i) => {
          (dot as HTMLElement).style.background = i === index ? '#0B2744' : '#E6DAC6';
          (dot as HTMLElement).style.transform = i === index ? 'scale(1.3)' : 'scale(1)';
        });
      }

      prevBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: -cardWidth(), behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: cardWidth(), behavior: 'smooth' });
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          carousel.scrollTo({ left: i * (carousel.firstElementChild?.offsetWidth ?? 0), behavior: 'smooth' });
        });
      });

      carousel.addEventListener('scroll', updateDots, { passive: true });
    });

    // ── Multi-breakpoint carousel for data-driven sections ──
    document.querySelectorAll('[data-carousel]').forEach(carouselEl => {
      const track = carouselEl.querySelector('[data-carousel-track]') as HTMLElement | null;
      const prevBtn = carouselEl.querySelector('[data-carousel-prev]') as HTMLButtonElement | null;
      const nextBtn = carouselEl.querySelector('[data-carousel-next]') as HTMLButtonElement | null;
      if (!track || !prevBtn || !nextBtn) return;

      let currentIndex = 0;

      function getVisibleCount(): number {
        if (window.innerWidth >= 1024) return 3;
        if (window.innerWidth >= 768) return 2;
        return 1;
      }

      function getTotalCards(): number {
        return track!.children.length;
      }

      function getCardPlusGap(): number {
        const card = track!.children[0] as HTMLElement | undefined;
        if (!card) return 0;
        // gap-5 = 20px; read actual gap in case CSS changes
        const gap = parseFloat(getComputedStyle(track!).gap) || 20;
        return card.getBoundingClientRect().width + gap;
      }

      function maxIndex(): number {
        return Math.max(0, getTotalCards() - getVisibleCount());
      }

      function update(): void {
        const offset = currentIndex * getCardPlusGap();
        track!.style.transform = `translateX(-${offset}px)`;
        prevBtn!.disabled = currentIndex === 0;
        nextBtn!.disabled = currentIndex >= maxIndex();
      }

      prevBtn.addEventListener('click', () => {
        currentIndex = Math.max(0, currentIndex - 1);
        update();
      });

      nextBtn.addEventListener('click', () => {
        currentIndex = Math.min(maxIndex(), currentIndex + 1);
        update();
      });

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          currentIndex = Math.min(currentIndex, maxIndex());
          update();
        }, 100);
      });

      update();
    });

  });
</script>

</Layout>
