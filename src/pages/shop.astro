---

<Layout>

<!-- ══════════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
<section class="relative overflow-hidden bg-[#0B2744] flex items-end" style="min-height: 52vh;">
  <div class="absolute inset-0 z-0 text-white">
    <Image
      src={heroImage}
      alt="Shop — Trainer-approved gear"
      class="w-full h-full object-cover object-center opacity-50"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B2744]/60 via-[#0B2744]/40 to-[#0B2744]/80"></div>
  </div>
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-8 pb-14 pt-[220px] md:pt-[150px]">
    <p class="text-[11px] font-bold tracking-[0.28em] uppercase mb-4" style="color: rgba(209,178,127,0.60);">Trainer-Approved Gear</p>
    <h1 class="font-heading font-bold text-white leading-[1.06] mb-3" style="font-size: clamp(2.6rem, 5vw, 4rem);">Shop</h1>
    <p class="headline-accent text-2xl md:text-3xl mb-4" style="color: #D1B27F; font-style: italic; font-weight: 700;">"Tools we actually use in training."</p>
    <p class="text-gray-300 max-w-xl leading-relaxed">Curated gear that supports calm behavior, safety, and structure — nothing on this list is filler.</p>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     AFFILIATE DISCLOSURE
══════════════════════════════════════════════ -->
<div class="bg-[#FBF1E9] py-4 px-4 border-b border-[#E6DAC6]">
  <div class="max-w-7xl mx-auto">
    <p class="text-xs text-center" style="color: rgba(17,32,50,0.42);">
      <strong style="color: rgba(17,32,50,0.55);">Disclosure:</strong> Some links on this page are Amazon affiliate links. If you purchase through them, we may earn a small commission at no extra cost to you. We only recommend gear we've personally used in training.
    </p>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     CATEGORY TABS + PRODUCT GRID
══════════════════════════════════════════════ -->
<div class="bg-[#FBF1E9] py-14 px-4 overflow-x-clip">
  <div class="max-w-7xl mx-auto">

    <!-- Sticky category tabs -->
    <div class="flex flex-wrap gap-2 mb-12 justify-center">
      {categories.map(c => (
        <a
          href={`#${c.id}`}
          class="px-4 py-2 rounded-full text-[11px] font-bold tracking-widest uppercase transition-all duration-200"
          style="border: 1px solid #E6DAC6; background: #FCF9FA; color: rgba(17,32,50,0.55);"
          onmouseover={`this.style.borderColor='#D1B27F'; this.style.color='#D1B27F';`}
          onmouseout={`this.style.borderColor='#E6DAC6'; this.style.color='rgba(17,32,50,0.55)';`}
        >
          {c.label}
        </a>
      ))}
    </div>

    <!-- Category sections -->
    {categories.map(cat => (
      <div id={cat.id} class="scroll-mt-28 mb-16">
        <div class="flex items-center gap-4 mb-8">
          <div class="divider-line flex-1"></div>
          <h2 class="font-heading font-bold text-xl whitespace-nowrap" style="color: #0B2744;">{cat.label}</h2>
          <div class="divider-line flex-1"></div>
        </div>

        <style>
          .divider-line {
            height: 1px;
            background: linear-gradient(to right, transparent, #E6DAC6 40%, #E6DAC6 60%, transparent);
          }
          .hide-scrollbar::-webkit-scrollbar { display: none; }
          .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        </style>

        {cat.useCarousel ? (
          <!-- ── Data-driven multi-breakpoint carousel ── -->
          <!-- Wrapper has no padding — viewport is full content width, matching the static grid rows exactly.
               Arrows use -translate-x-1/2 / translate-x-1/2 to straddle the card boundary.
               overflow-x-clip on the parent section prevents horizontal scroll. -->
          <div class="relative" data-carousel>
            <button
              data-carousel-prev
              disabled
              class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full border border-[#D1B27F] bg-[#D1B27F] flex items-center justify-center shadow-sm transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-[#c9a76e] active:enabled:scale-95"
              aria-label="Previous products"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#0B2744" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button
              data-carousel-next
              class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full border border-[#D1B27F] bg-[#D1B27F] flex items-center justify-center shadow-sm transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-[#c9a76e] active:enabled:scale-95"
              aria-label="Next products"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="#0B2744" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="overflow-hidden">
              <div
                data-carousel-track
                class="flex gap-5 transition-transform duration-300 ease-in-out will-change-transform"
              >
                {(cat.products as ShopProduct[]).map(p => (
                  <div class="flex-none w-full md:w-[calc(50%-10px)] lg:w-[calc(33.333%-13.334px)]">
                    <div class="bg-[#FCF9FA] h-full rounded-2xl overflow-hidden border border-[#E6DAC6] shadow-[0_3px_16px_rgba(0,0,0,0.06)] flex flex-col group hover:shadow-[0_6px_24px_rgba(0,0,0,0.10)] transition-shadow duration-200">
                      <!-- Product image -->
                      <div class="relative overflow-hidden aspect-[2/1] py-[15px] bg-white">
                        {p.image
                          ? <img src={p.image} alt={p.title} class="w-full h-full object-contain" style="background:#ffffff;" loading="lazy" />
                          : <div class="w-full h-full" style="background-color: #0F6D7F;"></div>
                        }
                      </div>
                      <!-- Card body -->
                      <div class="flex flex-col flex-1 p-6">
                        <h3 class="font-heading font-bold text-base mb-2" style="color: #0B2744;">{p.title}</h3>
                        <p class="text-xs italic mb-4 leading-relaxed" style="color: rgba(17,32,50,0.58);">{p.blurb}</p>
                        <ul class="space-y-1.5 mb-4">
                          {p.bullets.map(b => (
                            <li class="flex items-start gap-2 text-xs" style="color: rgba(17,32,50,0.65);">
                              <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="#D1B27F" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
